#!/bin/bash
#PBS -N oft_goal_part
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=32:mem=220gb:ngpus=2
#PBS -l walltime=08:00:00
#PBS -j oe

set -euo pipefail

ROOT=/scratch/users/ntu/yguo017/openvla-oft-vla-eval-libero
PART="${PART:?submit with qsub -v PART=0 or PART=1}"
[[ "$PART" =~ ^[01]$ ]]
N_LOCAL_SHARDS=2
N_GLOBAL_SHARDS=4
SRC="$ROOT/vla-evaluation-harness"
BOOTSTRAP="$ROOT/venvs/bootstrap"
SIF="$ROOT/containers/libero-latest.sif"
CHECKPOINT_SRC="$ROOT/source/checkpoints/openvla-7b-oft-finetuned-libero-goal"
ARTIFACTS="$ROOT/artifacts/$PBS_JOBID"
JOB_TMP="${TMPDIR:-/tmp}/oft-libero-goal-p$PART-$PBS_JOBID"
UV_CACHE_DIR="$JOB_TMP/uv-cache"
WHEELHOUSE="$JOB_TMP/wheelhouse-manylinux_2_28"
WORK_SRC="$JOB_TMP/vla-evaluation-harness"
RUN_RESULTS="$JOB_TMP/results"
EVAL_ID="libero-goal-part$PART-$PBS_JOBID"
BENCH_CONFIG="$SRC/configs/benchmarks/libero/goal.yaml"
JOB_NUMBER="${PBS_JOBID%%.*}"
BASE_PORT=$((20000 + JOB_NUMBER % 20000))
SERVER_PIDS=()
SHARD_PIDS=()

mkdir -p "$ARTIFACTS" "$JOB_TMP" "$UV_CACHE_DIR" "$RUN_RESULTS"
cp "$PBS_O_WORKDIR/libero_goal_full.pbs" "$ARTIFACTS/"
exec > >(tee -a "$ARTIFACTS/job.log") 2>&1

export APPTAINER_CACHEDIR="$ROOT/cache/apptainer"
export APPTAINER_TMPDIR="$ROOT/cache/apptainer-tmp"
export APPTAINERENV_LIBERO_CONFIG_PATH="$ROOT/configs/libero"
export HF_HOME="$ROOT/cache/huggingface"
export HUGGINGFACE_HUB_CACHE="$HF_HOME/hub"
export TORCH_HOME="$ROOT/cache/torch"
export UV_CACHE_DIR UV_OFFLINE=1 UV_FIND_LINKS="$WHEELHOUSE"
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1

module purge
module load gcc/11.4.0-nscc python/3.11.7-gcc11 apptainer/1.5.0 cuda/12.2.2
export PATH="$BOOTSTRAP/bin:/usr/bin:/bin:$PATH"

snapshot_results() {
  if [[ -d "$RUN_RESULTS" ]]; then
    mkdir -p "$ARTIFACTS/results"
    cp -a "$RUN_RESULTS/." "$ARTIFACTS/results/" 2>/dev/null || true
  fi
}

stage_out_results() {
  mkdir -p "$ARTIFACTS/results"
  cp -a "$RUN_RESULTS/." "$ARTIFACTS/results/"
  "$BOOTSTRAP/bin/python" "$ROOT/tools/verify_libero_goal.py" 250 "$ARTIFACTS/results"
}

cleanup() {
  for pid in "${SHARD_PIDS[@]}" "${SERVER_PIDS[@]}"; do
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
    fi
  done
  snapshot_results
}
trap cleanup EXIT TERM INT

date
hostname
nvidia-smi | tee "$ARTIFACTS/nvidia-smi.txt"
module list 2>&1 | tee "$ARTIFACTS/modules.txt"
df -h "$JOB_TMP" "$ROOT" | tee "$ARTIFACTS/filesystems.txt"
cp "$ROOT/control/vla-eval-commit.txt" "$ARTIFACTS/vla-eval-commit.txt"
cp "$ROOT/control/openvla-goal-hf-revision.txt" "$ARTIFACTS/"
cp "$BENCH_CONFIG" "$ARTIFACTS/benchmark-goal.yaml"
cp "$SRC/configs/model_servers/oft/libero_goal.yaml" "$ARTIFACTS/model-server-goal.yaml"

test -f "$SIF"
test -x "$BOOTSTRAP/bin/uv"
test -f "$BENCH_CONFIG"
while IFS=: read -r relative expected; do
  test "$(stat -c %s "$CHECKPOINT_SRC/$relative")" = "$expected"
done <<'EOF'
config.json:60712
model-00001-of-00004.safetensors:4925122448
model-00002-of-00004.safetensors:4947392496
model-00003-of-00004.safetensors:4947417456
model-00004-of-00004.safetensors:262668432
model.safetensors.index.json:94764
lora_adapter/adapter_config.json:813
lora_adapter/adapter_model.safetensors:484458600
action_head--50000_checkpoint.pt:302242654
proprio_projector--50000_checkpoint.pt:67275184
processor_config.json:130
tokenizer.json:1842976
EOF
test "$(stat -c %s "$ROOT/source/uv-cache-linux.tar")" = 7688110080
test "$(stat -c %s "$ROOT/source/wheelhouse-manylinux_2_28.tar")" = 3535134720
test "$(df -Pk "$JOB_TMP" | awk 'NR == 2 {print $4}')" -ge 47185920

tar -xf "$ROOT/source/uv-cache-linux.tar" -C "$UV_CACHE_DIR" --strip-components=1 \
  --exclude='openvla-oft-uv-cache/environments-v2'
tar -xf "$ROOT/source/wheelhouse-manylinux_2_28.tar" -C "$JOB_TMP"
cp -a "$SRC" "$WORK_SRC"
"$BOOTSTRAP/bin/python" "$ROOT/tools/rewrite_uv_lock_urls.py" \
  "$WORK_SRC/src/vla_eval/model_servers/oft.py.lock" "$WHEELHOUSE"

cp -a "$CHECKPOINT_SRC" "$JOB_TMP/checkpoint-base"
for i in $(seq 0 $((N_LOCAL_SHARDS - 1))); do
  cp -al "$JOB_TMP/checkpoint-base" "$JOB_TMP/checkpoint-$i"
  cp --remove-destination "$JOB_TMP/checkpoint-base/config.json" "$JOB_TMP/checkpoint-$i/config.json"
done

cd "$WORK_SRC"
for i in $(seq 0 $((N_LOCAL_SHARDS - 1))); do
  port=$((BASE_PORT + i))
  CUDA_VISIBLE_DEVICES="$i" "$BOOTSTRAP/bin/uv" run --python "$BOOTSTRAP/bin/python" \
    src/vla_eval/model_servers/oft.py \
    --port="$port" \
    --args.pretrained_checkpoint="$JOB_TMP/checkpoint-$i" \
    --args.unnorm_key=libero_goal_no_noops \
    --args.num_images_in_input=2 \
    --args.chunk_size=8 \
    > "$ARTIFACTS/model-server-$i.log" 2>&1 &
  SERVER_PIDS+=("$!")
done

for i in $(seq 0 $((N_LOCAL_SHARDS - 1))); do
  port=$((BASE_PORT + i))
  for _ in $(seq 1 180); do
    if "$BOOTSTRAP/bin/python" -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:$port/health').read()" 2>/dev/null; then
      break
    fi
    if ! kill -0 "${SERVER_PIDS[$i]}" 2>/dev/null; then
      tail -200 "$ARTIFACTS/model-server-$i.log"
      exit 1
    fi
    sleep 10
  done
  "$BOOTSTRAP/bin/python" -c "import sys,urllib.request; sys.stdout.buffer.write(urllib.request.urlopen('http://127.0.0.1:$port/health').read())" \
    > "$ARTIFACTS/model-server-$i-health.json"
done

for i in $(seq 0 $((N_LOCAL_SHARDS - 1))); do
  port=$((BASE_PORT + i))
  shard_id=$((PART * N_LOCAL_SHARDS + i))
  apptainer run --bind "$ROOT:$ROOT,$JOB_TMP:$JOB_TMP" "$SIF" \
    run --no-docker \
    --config "$BENCH_CONFIG" \
    --server-url "ws://127.0.0.1:$port" \
    --output-dir "$RUN_RESULTS" \
    --eval-id "$EVAL_ID" \
    --shard-id "$shard_id" --num-shards "$N_GLOBAL_SHARDS" \
    --render cpu --record-video --yes \
    > "$ARTIFACTS/shard-$shard_id.log" 2>&1 &
  SHARD_PIDS+=("$!")
done

failed=0
for i in $(seq 0 $((N_LOCAL_SHARDS - 1))); do
  if ! wait "${SHARD_PIDS[$i]}"; then
    echo "global shard $((PART * N_LOCAL_SHARDS + i)) failed"
    failed=$((failed + 1))
  fi
done
SHARD_PIDS=()
snapshot_results
test "$failed" = 0

apptainer run --bind "$ROOT:$ROOT,$JOB_TMP:$JOB_TMP" "$SIF" \
  merge --config "$BENCH_CONFIG" --eval-id "$EVAL_ID" --output-dir "$RUN_RESULTS" \
  2>&1 | tee "$ARTIFACTS/merge.log"

"$BOOTSTRAP/bin/python" "$ROOT/tools/verify_libero_goal.py" 250 "$RUN_RESULTS" \
  | tee "$ARTIFACTS/verification.json"
stage_out_results | tee "$ARTIFACTS/stage-out-verification.json"
find "$ARTIFACTS" -type f ! -name manifest.tsv -printf '%P\t%s bytes\n' \
  | sort > "$ARTIFACTS/manifest.tsv"
touch "$ARTIFACTS/SUCCESS"
date
