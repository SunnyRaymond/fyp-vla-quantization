+{
+  "selected_gaps": [
+    {
+      "gap": "additive: No retrieved WAM-quantization leaf establishes the downstream consequence of a numerical perturbation at a module or denoising step for the final action chunk and the next closed-loop observation in contact-critical manipulation; this is the unresolved residue of QuantWAMs (arxiv:2607.28405v1), not a request for a particular remedy. — stakes: practitioners may deploy a memory- and latency-efficient WAM that preserves local calibration metrics but fails on contact-sensitive actions, while researchers may mistake local fidelity for transferable closed-loop reliability.",
+      "chosen_pattern_id": "reframe_as_solvable_object",
+      "anchor_alternates": [],
+      "companion_pattern": "architectural_operator_substitution",
+      "companion_rationale": "reframe_as_solvable_object turns each module or denoising-step numerical perturbation into the named intermediate object O, a counterfactual closed-loop consequence functional over the final action chunk and next observation; architectural_operator_substitution consumes O to replace the layer-local fidelity score with a runnable precision-scoring operator.",
+      "selection_rationale": "This is the load-bearing construction gap because the committed contribution_type is method and the bottleneck is the missing action-level and next-observation consequence signal that a deployable precision decision must produce. The reframe makes that consequence a computable object, while the chained operator substitution turns it into the runnable method artifact without reverting to a local PTQ score, latent rollout/planning surrogate, or QuantWAMs fixed-count schedule repair."
+    },
+    {
+      "gap": "subtractive: No retrieved WAM-quantization leaf tests whether the local numerical-fidelity surrogate inherited from layer-local PTQ is actually sufficient for precision selection in the coupled video/action setting, rather than an assumed proxy for downstream task impact; this questions the inherited assumption and leaves the replacement open. — stakes: precision-allocation conclusions can rest on an unexamined surrogate and invalidate comparisons across WAMs or tasks, while deployment teams cannot tell whether an apparent speed or memory gain preserves the action behavior they require.",
+      "chosen_pattern_id": "controlled_diagnostic_design",
+      "anchor_alternates": [],
+      "companion_pattern": null,
+      "companion_rationale": "",
+      "selection_rationale": "This sibling shares the anchor's central downstream-consequence object and tests the same precision decision against the local-fidelity surrogate rather than introducing a separate architecture or data source. It passes the removal test because without the controlled comparison the anchor's operator has no isolating evidence that local fidelity is insufficient, leaving an obvious reviewer objection about why the replacement score is needed."
+    }
+  ],
+  "coherence_thread_type": "shared_object",
+  "deliverable_coverage": "method — anchor gap → reframe_as_solvable_object defines the downstream-consequence object and its architectural_operator_substitution companion ships the runnable precision-scoring and selection mechanism.",
+  "user_direction_disposition": {
+    "verdict": "n_a"
+  },
+  "composition_note": "",
