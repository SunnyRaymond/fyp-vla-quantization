  "method_flow": {
    "high_level_pipeline": "RankCal takes a frozen FP16 action-conditioned latent world model, planner inputs, candidate action sequences, and quantization site/bit-pair options. It holds the planner and rollout convention fixed, quantizes one site at a time, and measures how each intervention changes the ordering of imagined action sequences over latent dynamics. The resulting site-by-bit influence profile is converted into a mixed W/A assignment by minimizing influence under measured `PeakBytes` and a fixed nominal bit histogram. The output is a quantized checkpoint for the unchanged receding-horizon planner, whose candidate ordering and closed-loop action consequences remain the objects of evaluation; joint video/action denoising in WAMs is outside this branch.",
    "steps": [
      {
        "step_id": "S1",
        "title": "Freeze the imagined-rollout probe",
        "what_changes": "Fix the FP16 planner inputs, candidate action-sequence pool, receding-horizon convention, tie rule, and latent rollout evaluator; expose one quantizable weight/activation site at a time while all other sites remain FP16.",
        "why_this_step": "This isolates a site-level perturbation in the action-conditioned latent-dynamics branch and prevents planner redesign or WAM denoising changes from being mistaken for quantization effects.",
        "linked_component": "engineering",
        "linked_falsification": "metric_specification",
        "input": "FP16 action-conditioned latent world model, planner inputs, candidate pool, and quantization site/bit-pair candidates.",
        "output": "A reproducible frozen probe that returns FP16 and one-site-quantized rollout scores for the same candidate sequences."
      },
      {
        "step_id": "S2",
        "title": "Estimate rollout-ranking influence",
        "what_changes": "For each site and bit pair, compare the FP16 and one-site-quantized candidate ordering over imagined latent rollouts, retaining horizon-specific influence values `I_g(b)`.",
        "why_this_step": "The ranking estimand closes the gap between tensor reconstruction error and the planner's decision-level sensitivity, including the downstream consequence of an altered selected action.",
        "linked_component": "theory",
        "linked_falsification": "mechanism_distinguisher",
        "input": "Frozen probe outputs from S1.",
        "output": "A site-by-bit influence profile `I_g(b)` indexed by rollout horizon and quantizable site."
      },
      {
        "step_id": "S3",
        "title": "Allocate bits under measured memory",
        "what_changes": "Choose each site's weight/activation bit pair by minimizing aggregate influence subject to measured `PeakBytes` and the fixed nominal bit histogram.",
        "why_this_step": "This converts the diagnostic profile into a deployable mixed W/A PTQ assignment without changing the latent planner or replacing measured memory with a nominal byte assumption.",
        "linked_component": "both",
        "linked_falsification": "metric_specification",
        "input": "Site-by-bit influence profile, candidate bit pairs, backend-specific byte accounting, target bit histogram, and memory budget B.",
        "output": "A mixed W/A assignment `b*` and a quantized checkpoint candidate."
      },
      {
        "step_id": "S4",
        "title": "Preserve closed-loop action consequences",
        "what_changes": "Apply the assignment to the frozen planner and run its normal imagined action-sequence and receding-horizon loop, recording candidate-order agreement, first-action agreement, and closed-loop task success under the prescribed horizon conditions.",
        "why_this_step": "The object to preserve is the selected action and its later consequences, so the evaluation stays in latent-dynamics planning rather than switching to joint video/action denoising.",
        "linked_component": "engineering",
        "linked_falsification": "mechanism_distinguisher",
        "input": "Quantized checkpoint candidate and the unchanged planner and evaluation convention from S1.",
        "output": "Closed-loop rollout outcomes and decision-level diagnostics for assessing whether RankCal's allocation signal is load-bearing."
      }
    ],
    "design_reasoning_echo": "RankCal chooses the decision-level object because the failure of interest is an ordering change that propagates through receding-horizon action selection, not an isolated tensor distortion. Holding the planner, candidate pool, rollout convention, tie rule, and all non-target sites in FP16 makes the one-site intervention interpretable; aggregating its ranking influence into a memory-constrained assignment connects a diagnostic to deployment. The design therefore keeps the backbone and planner fixed, tests the allocation signal against local-reconstruction allocation, and stays separate from LeFlow's planner redesign and QuantWAMs' joint video/action denoising."
  },
