ches=\", joint_mismatches, \"d=\", fstr(d_joint))\nd1 = discordance(base, site_scores[\"g1\"])[0]\nd2 = discordance(base, site_scores[\"g2\"])[0]\nprint(\"interaction_check=d_joint-(d_g1+d_g2)=\", fstr(d_joint - d1 - d2), \"d_joint=\", fstr(d_joint), \"sum_single=\", fstr(d1+d2))\n\n# Full declared six-axis grid, with small concrete parameters.\ngrid = {\n    \"H\": sorted({4 // 2, 4, min(2 * 4, 6)}),\n    \"N\": sorted({max(1, 4 // 2), 4, 2 * 4}),\n    \"M\": sorted({max(1, 4 // 4), max(1, 4 // 2), 4}),\n    \"S\": (\"native\", \"random_shooting\", \"CEM\"),\n    \"E\": (\"native\", \"one_step\"),\n    \"T\": (\"stable_index\", \"seeded_random\"),\n}\nraw_cells = list(product(*(grid[k] for k in (\"H\", \"N\", \"M\", \"S\", \"E\", \"T\"))))\nprint(\"grid_axes=\", {k: list(v) for k, v in grid.items()})\nprint(\"grid_cells_raw=\", len(raw_cells), \"grid_cells_after_dedup=\", len(set(raw_cells)), \"full_grid_omega_c=\", fstr(F(1, len(set(raw_cells)))))\nprint(\"trace_cell_count=1,trace_cell_omega_c=1\")\n\n# Four sites with unequal resident weights and one shared peak workspace.\nfp_bytes = {\"g1\": 12, \"g2\": 8, \"g3\": 8, \"g4\": 4}\nlow_bytes = {g: v // 4 for g, v in fp_bytes.items()}\nshared_workspace = 4\nsite_peak = {\"FP16\": {g: fp_bytes[g] + shared_workspace for g in fp_bytes},\n             \"W4A4\": {g: low_bytes[g] + shared_workspace for g in fp_bytes}}\nrank_low = {\"g1\", \"g4\"}\nnaive_low = {\"g2\", \"g3\"}\nbad_perm_low = {\"g1\", \"g2\"}\nprint(\"bytes_fp=\", fp_bytes, \"bytes_w4a4=\", low_bytes, \"shared_workspace=\", shared_workspace)\nrank_sum = sum(site_peak[\"W4A4\"][g] if g in rank_low else site_peak[\"FP16\"][g] for g in fp_bytes)\nnaive_sum = sum(site_peak[\"W4A4\"][g] if g in naive_low else site_peak[\"FP16\"][g] for g in fp_bytes)\nrank_peak = peak(rank_low, fp_bytes, low_bytes, shared_workspace)\nnaive_peak = peak(naive_low, fp_bytes, low_bytes, shared_workspace)\nprint(\"rank_assignment_low=\", sorted(rank_low), \"sum_individual_m=\", ran