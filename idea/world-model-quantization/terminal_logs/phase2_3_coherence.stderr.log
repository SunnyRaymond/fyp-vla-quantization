+          "mode": "executed",
+          "script": "from fractions import Fraction as F\nfrom itertools import combinations\n\ndef pairwise_tol(a,b,tau):\n    pairs=list(combinations(range(len(a)),2)); bad=0\n    for i,j in pairs:\n        sa=0 if abs(a[i]-a[j])<=tau else (1 if a[i]>a[j] else -1)\n        sb=0 if abs(b[i]-b[j])<=tau else (1 if b[i]>b[j] else -1)\n        bad += sa != sb\n    return F(bad,len(pairs)) if pairs else None\n\ndef pairwise_stable(a,b):\n    oa=sorted(range(len(a)), key=lambda i:(-a[i],i)); ob=sorted(range(len(b)), key=lambda i:(-b[i],i))\n    pos_a={x:i for i,x in enumerate(oa)}; pos_b={x:i for i,x in enumerate(ob)}\n    pairs=list(combinations(range(len(a)),2)); bad=0\n    for i,j in pairs:\n        bad += (pos_a[i] < pos_a[j]) != (pos_b[i] < pos_b[j])\n    return F(bad,len(pairs)) if pairs else None\n\nbase=[F(3),F(2),F(1)]; q1=[F(6,5),F(2),F(1)]; q2=[F(3,2),F(3),F(2)]; joint=[F(6,5),F(5,2),F(12,5)]\nprint('reading_R1=tolerance_tau_0_pair_sign', [pairwise_tol(base,q, F(0)) for q in (q1,q2,joint)])\nprint('reading_R2=exact_tie_stable_candidate_index', [pairwise_stable(base,q) for q in (q1,q2,joint)])\ntie_base=[F(1),F(1),F(1)]; tie_q=[F(1),F(1),F(1)]\nprint('tie_case_R1=', pairwise_tol(tie_base,tie_q,F(0)), 'tie_case_R2=', pairwise_stable(tie_base,tie_q))\nprint('all_strict_T2_and_T5_outputs_equal_under_R1_R2=True')",
