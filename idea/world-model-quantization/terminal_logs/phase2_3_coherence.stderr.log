from fractions import Fraction
from itertools import combinations

def normalized_discordance(base, quant, tau=Fraction(0)):
    n = len(base)
    pair_count = n * (n - 1) // 2
    if pair_count == 0:
        return None, pair_count
    mismatches = 0
    for i, j in combinations(range(n), 2):
        db, dq = base[i] - base[j], quant[i] - quant[j]
        sb = 0 if abs(db) <= tau else (1 if db > 0 else -1)
        sq = 0 if abs(dq) <= tau else (1 if dq > 0 else -1)
        mismatches += int(sb "'!= sq)
    return Fraction(mismatches, pair_count), pair_count

def grid(H_native, H_episode, N_native, M0):
    H = sorted({H_native // 2, H_native, min(2 * H_native, H_episode)})
    N = sorted({max(1, N_native // 2), N_native, 2 * N_native})
    M = sorted({max(1, M0 // 4), max(1, M0 // 2), M0})
    return H, N, M

