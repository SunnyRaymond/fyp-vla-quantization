    "dtype": "float32",
    "decoder": null,
    "execution": "emulation_only",
    "native_memory_claim": false
  },
  "quantizer": {
    "target_blocks": [
      "predictor.transformer.layers.0",
      "predictor.transformer.layers.1",
      "predictor.transformer.layers.2",
      "predictor.transformer.layers.3",
      "predictor.transformer.layers.4",
      "predictor.transformer.layers.5"
    ],
    "target_scope": "predictor_only",
    "bits": 4,
    "q_min": -7,
    "q_max": 7,
    "scheme": "symmetric_per_output_channel_weight_only",
    "q0": {
      "rounding": "RTN_ties_to_even",
      "scale": "max_abs_weight_div_7",
      "zero_channel_scale": 1.0,
      "zero_channel_integer": 0
    },
    "fit_parameterization": {
      "scale": "positive_scale_with_fixed_floor",
      "rounding": "AdaRound_style_soft_h_in_0_1",
      "hard_threshold": 0.5,
      "clamp_order": "floor_plus_h_then_clamp_then_integer_cast",
      "alpha_serialized": false,
      "extra_state": false,
      "mixed_precision": false,
      "observer": false,
      "error_feedback": false
    },
    "logical_budget": "all six predictor target blocks W4; no native packed-byte claim; all non-target weights remain FP32"
  },
  "target_groups": [
    "predictor.transformer.layers.0",
    "predictor.transformer.layers.1",
    "predictor.transformer.layers.2",
    "predictor.transformer.layers.3",
    "predictor.transformer.layers.4",
    "predictor.transformer.layers.5"
  ],
  "splits": {
