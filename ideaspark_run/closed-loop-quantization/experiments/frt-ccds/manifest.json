      "environment_namespace": 800000,
      "cem_namespace": 810000,
      "seed_rule": "namespace + local_index"
    },
    "dev": {
      "split_id": "frt_dev",
      "episode_ids": [
        "frt_dev:000",
        "frt_dev:001",
        "frt_dev:002",
        "frt_dev:003",
        "frt_dev:004",
        "frt_dev:005"
      ],
      "local_indices": [0, 1, 2, 3, 4, 5],
      "dataset_indices": [66, 67, 68, 69, 70, 71],
      "environment_namespace": 900000,
      "cem_namespace": 910000,
      "seed_rule": "namespace + local_index"
    },
    "target_policy": "fresh target fingerprints and disjoint initial states; no historical target payloads or arrays reused",
    "independent_unit": "episode_initial_state; all records within an episode are nested"
  },
  "fit": {
    "methods": ["clean", "random_same_norm", "frt"],
    "seeds": [1201, 1202, 1203],
    "method_seed_order": [
      "clean:1201",
      "clean:1202",
      "clean:1203",
      "random_same_norm:1201",
      "random_same_norm:1202",
      "random_same_norm:1203",
      "frt:1201",
      "frt:1202",
      "frt:1203"
    ],
    "optimizer_policy": {
      "name": "Adam",
      "betas": [0.9, 0.999],
      "eps": 1e-08,
      "weight_decay": 0.0,
      "lr": 0.01,
      "learning_rate_freeze": "A timing/stability selection before B; identical scale/rounding rates for all methods and seeds",
      "no_dev_tuning": true
    },
    "fit_updates": null,
    "fit_update_policy": {
      "candidate_values": [256, 512, 1000],
      "freeze_stage": "after_stage_a_timing_and_stability_check_before_stage_b",
      "no_runtime_override": true,
      "root_review_required": true
    },
    "batch_policy": "seeded_minibatch_schedule_declared_in_A_and_frozen_before_B; identical schedule for all methods within each seed",
    "batch_size_policy": {
      "candidate_values": [1, 2, 4],
      "freeze_stage": "after_stage_a_timing_and_stability_check_before_stage_b",
      "no_method_specific_value": true
    },
    "shuffle": "deterministic_seeded_permutation_declared_in_A; same schedule hash across methods within seed",
    "gradient_accumulation": "runner_declared_in_A; identical across methods; exposure_count recorded",
    "initialization": "runner_declared_in_A; same Q0 scales and same fraction/logit alpha initialization for all methods and seeds",
    "soft_schedule": {
      "policy": "runner_declared_in_A_and_frozen_before_B; soft schedule must run through final update",
      "hardening": "materialize_h>=0.5 only after final soft update",
      "final_hardening_step": "equals_frozen_fit_updates",
      "early_stop": false,
      "binary_required_at_final": true
    },
    "materialization": {
      "discard_alpha": true,
      "reload_checkpoint": true,
      "exact_weight_assertion": true,
      "all_target_groups_hard_w4": true
    }
  },
  "loss": {
    "clean_term": "weighted_mean_squared_error_in_latent_units",
    "transport_term": "weighted_mean_squared_error_of_finite_difference_transport",
    "clean_method": "L_clean_only; lambda_T is not tuned and no transport term is supplied",
    "random_method": "L_clean + lambda_T * L_transport(delta_random)",
    "frt_method": "L_clean + lambda_T * L_transport(delta_q0)",
    "lambda_T": 1.0,
    "lambda_rule": {
      "source": "provisional A placeholder; B must replace with calibration_freeze.lambda_T before fitting",
      "lambda_raw": "max(mean_L_clean_Q0,1e-12)/max(mean_L_transport_Q0,1e-12)",
      "clip": [0.25, 4.0],
      "shared_by": ["random_same_norm", "frt"],
      "dev_tuning": false,
      "clamp_is": "scope_warning_not_scientific_no_go",
      "placeholder_is_not_frozen": true
    },
    "wz": {
      "source": "CAL FP next-slot outputs only",
      "estimator": "population_variance",
      "std_floor": 0.001,
      "formula": "active Wz_j=1/max(sqrt(max(var_j,0)),0.001); action Wz=0",
      "frozen_before_fit": true,
      "dev_reestimate": false,
      "physical_readout": false
    }
  },
  "random_control": {
    "space": "active observation/proprio coordinates in Wz-whitened space",
    "distribution": "standard_normal",
    "seed_base": 940000,
    "seed_rule": "one CPU torch.Generator per split; CAL seed=940000 and DEV seed=940001; one shared bank per split",
    "norm_target": "per_record ||Wz*delta_q0||_2",
    "action_coordinates": "exact_zero",
    "zero_q0_norm": "invalid_inconclusive; do not substitute a different norm"
  },
  "random_seed": 940000,
  "dev_banks": {
    "q0_bank": "one fresh Q0 residual bank collected before fitting and shared by every evaluator",
    "random_bank": "one deterministic same-norm bank derived from the shared q0 bank and shared by every evaluator",
    "fresh_qtheta_banks": [
      "fresh:clean:1201",
      "fresh:clean:1202",
      "fresh:clean:1203",
      "fresh:random_same_norm:1201",
      "fresh:random_same_norm:1202",
      "fresh:random_same_norm:1203",
      "fresh:frt:1201",
      "fresh:frt:1202",
      "fresh:frt:1203"
    ],
    "bank_order": [
      "q0",
      "random_same_norm",
      "fresh:clean:1201",
      "fresh:clean:1202",
      "fresh:clean:1203",
      "fresh:random_same_norm:1201",
      "fresh:random_same_norm:1202",
      "fresh:random_same_norm:1203",
      "fresh:frt:1201",
      "fresh:frt:1202",
      "fresh:frt:1203"
    ],
    "evaluator_order": [
      "fp32",
      "q0_rtn",
      "clean:1201",
      "clean:1202",
      "clean:1203",
      "random_same_norm:1201",
      "random_same_norm:1202",
      "random_same_norm:1203",
      "frt:1201",
      "frt:1202",
      "frt:1203"
    ],
    "required_matrix": "every evaluator scores every bank; no own-bank-only scoring",
    "fresh_bank_policy": "collect once after fit without refitting; union all nine fresh banks for the primary fresh_union view"
  },
  "gates": {
    "clean_tolerance": {
      "comparison": "frt_vs_clean",
      "rule": "frt_clean <= 1.10*clean_clean + 1e-12",
      "per_seed_episode_requirement": 4,
      "seed_requirement": "at_least_2_of_3",
      "macro_requirement": true,
      "relative_ambiguity": 1e-06
    },
    "transport_improvement": {
      "views": ["q0", "fresh_union"],
      "comparators": ["clean", "random_same_norm"],
      "rule": "frt_transport <= 0.95*comparator_transport + 1e-12",
      "per_seed_episode_requirement": 4,
      "seed_requirement": "at_least_2_of_3",
      "macro_requirement": true,
      "relative_ambiguity": 1e-06
    },
    "complete_b_required": true,
    "interpretation": {
      "complete_signal": "conditional_signal",
      "complete_gate_failure": "mechanism_no_go",
      "invalid_interface_or_common_bank": "engineering_fail",
      "missing_or_underoptimized_or_budget": "resource_incomplete_or_underoptimized",
      "no_statistical_significance_claim": true
    }
  },
