    "batch_policy": "seeded_minibatch_schedule_declared_in_A_and_frozen_before_B; identical schedule for all methods within each seed",
    "batch_size_policy": {
      "candidate_values": [
        1,
        2,
        4
      ],
      "freeze_stage": "after_stage_a_timing_and_stability_check_before_stage_b",
      "no_method_specific_value": true
    },
    "shuffle": "deterministic_seeded_permutation_declared_in_A; same schedule hash across methods within seed",
    "gradient_accumulation": "runner_declared_in_A; identical across methods; exposure_count recorded",
    "initialization": "runner_declared_in_A; same Q0 scales and same fraction/logit alpha initialization for all methods and seeds",
    "soft_schedule": {
      "policy": "runner_declared_in_A_and_frozen_before_B; soft schedule must run through final update",
      "hardening": "materialize_h>=0.5 only after final soft update",
      "final_hardening_step": "equals_frozen_fit_updates",
      "early_stop": false,
      "binary_required_at_final": true
