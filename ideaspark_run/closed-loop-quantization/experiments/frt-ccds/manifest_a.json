  "loss": {
    "clean_term": "weighted_mean_squared_error_in_latent_units",
    "transport_term": "weighted_mean_squared_error_of_finite_difference_transport",
    "clean_method": "L_clean_only; lambda_T is not tuned and no transport term is supplied",
    "random_method": "L_clean + lambda_T * L_transport(delta_random)",
    "frt_method": "L_clean + lambda_T * L_transport(delta_q0)",
    "lambda_rule": {
      "source": "CAL Q0 raw error vectors before fitting",
      "lambda_raw": "max(mean_L_clean_Q0,1e-12)/max(mean_L_transport_Q0,1e-12)",
      "clip": [
        0.25,
        4.0
      ],
      "shared_by": [
        "random_same_norm",
        "frt"
      ],
      "dev_tuning": false,
      "clamp_is": "scope_warning_not_scientific_no_go"
    },
    "wz": {
      "source": "CAL FP next-slot outputs only",
      "estimator": "population_variance",
      "std_floor": 0.001,
      "formula": "active Wz_j=1/max(sqrt(max(var_j,0)),0.001); action Wz=0",
      "frozen_before_fit": true,
      "dev_reestimate": false,
      "physical_readout": false
    }
  },
