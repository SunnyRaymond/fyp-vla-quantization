+    "preference": "both",
+    "baseline": "QuantWAMs PTQ on public coupled WAMs such as Fast-WAM and LingBot-VA, with QuantWM as the latent rollout/planning reference",
+    "user_direction": "n_a",
+    "excluded_direction": "ordinary VLA-only quantization, vector-quantization/tokenizer work, and the main branch latent rollout/planning route",
+    "limitation": "Numerical PTQ for coupled WAMs can preserve local or module-level fidelity while leaving the downstream action-conditioned closed-loop consequence of a perturbation unresolved.",
+    "contribution_type": "method",
+    "_inferred_fields": [
+      "venue",
+      "time",
