+      "instance": "N_cal=2 episodes, action chunks of length 2, two-pixel next observations, sites R={r1,r2,r3}, B=1, lambda_a=lambda_o=1, epsilon_a=epsilon_o=1e-3. j1 is a contact transition: a0=[1,2], o0=[10,20], ar1=[2,2], or1=[11,20], ar2=[1.5,2.5], or2=[10,22], ar3=[1,2], or3=[10,20]. j2 is non-contact: a0=[3,4], o0=[12,22], ar1=[3,5], or1=[12,24], ar2=[3.5,4.5], or2=[13,23], ar3=[3,4], or3=[12,22]. The independent local naive surrogate uses per-episode MSEs L_j={r1:1,r2:0.25,r3:0.0625}. The script also executes the three alternative action-normalization conventions and two observation-standard-deviation conventions required by the dual-reading check.",
+      "execution": {
+        "mode": "executed",
+        "script": "from math import sqrt\nfrom statistics import mean, pstdev, stdev\n\neps_a = eps_o = 1e-3\nlam_a = lam_o = 1.0\nB = 1\nsites = [\"r1\", \"r2\", \"r3\"]\nepisodes = [\n    {\n        \"id\": \"j1\", \"contact\": True,\n        \"a0\": [1.0, 2.0], \"o0\": [10.0, 20.0],\n        \"ar\": {\n            \"r1\": [2.0, 2.0], \"r2\": [1.5, 2.5], \"r3\": [1.0, 2.0]\n        },\n        \"or\": {\n            \"r1\": [11.0, 20.0], \"r2\": [10.0, 22.0], \"r3\": [10.0, 20.0]\n        },\n    },\n    {\n        \"id\": \"j2\", \"contact\": False,\n        \"a0\": [3.0, 4.0], \"o0\": [12.0, 22.0],\n        \"ar\": {\n            \"r1\": [3.0, 5.0], \"r2\": [3.5, 4.5], \"r3\": [3.0, 4.0]\n        },\n        \"or\": {\n            \"r1\": [12.0, 24.0], \"r2\": [13.0, 23.0], \"r3\": [12.0, 22.0]\n        },\n    },\n]\n\ndef mse(x, y):\n    return mean((a - b) ** 2 for a, b in zip(x, y))\n\ndef pixel_l1(x, y):\n    return mean(abs(a - b) for a, b in zip(x, y))\n\ndef ranks(values):\n    order = sorted(range(len(values)), key=lambda i: values[i])\n    out = [0] * len(values)\n    for rank, i in enumerate(order, 1):\n        out[i] = rank\n    return out\n\ndef spearman(x, y):\n    rx, ry = ranks(x), ranks(y)\n    mx, my = mean(rx), mean(ry)\n    num = sum((a - mx) * (b - my) for a, b in zip(rx, ry))\n    den = sqrt(sum((a - mx) ** 2 for a in rx) * sum((b - my) ** 2 for b in ry))\n    return None if den == 0 else num / den\n\nlocal = {\"r1\": [1.0, 1.0], \"r2\": [0.25, 0.25], \"r3\": [0.0625, 0.0625]}\nall_action_values = [v for e in episodes for v in e[\"a0\"]]\nflat_mean = mean(all_action_values)\nsigma_a2_readings = {\n    \"flattened_population\": mean((v - flat_mean) ** 2 for v in all_action_values),\n    \"per_coordinate_population\": mean(\n        pstdev([e[\"a0\"][p] for e in episodes]) ** 2\n        for p in range(len(episodes[0][\"a0\"]))\n    ),\n    \"flattened_sample\": sum((v - flat_mean) ** 2 for v in all_action_values) / (len(all_action_values) - 1),\n    \"per_coordinate_sample\": mean(\n        stdev([e[\"a0\"][p] for e in episodes]) ** 2\n        for p in range(len(episodes[0][\"a0\"]))\n    ),\n}\nsigma_o_readings = {\n    \"per_pixel_population\": mean(\n        pstdev([e[\"o0\"][p] for e in episodes])\n        for p in range(len(episodes[0][\"o0\"]))\n    ),\n    \"per_pixel_sample\": mean(\n        stdev([e[\"o0\"][p] for e in episodes])\n        for p in range(len(episodes[0][\"o0\"]))\n    ),\n}\n\nfor a_name, sigma_a2 in sigma_a2_readings.items():\n    for o_name, sigma_o in sigma_o_readings.items():\n        rows = {}\n        for r in sites:\n            da = [mse(e[\"a0\"], e[\"ar\"][r]) / max(sigma_a2, eps_a ** 2) for e in episodes]\n            do = [pixel_l1(e[\"o0\"], e[\"or\"][r]) / max(sigma_o, eps_o) for e in episodes]\n            combined = [lam_a * a + lam_o * o for a, o in zip(da, do)]\n            rows[r] = {\n                \"d_a\": da, \"d_o\": do, \"episode_C\": combined,\n                \"C\": mean(combined), \"L\": mean(local[r]),\n            }\n\n        def selection(key):\n            return sorted(sites, key=lambda r: (-rows[r][key], r))[:B]\n\n        print(\"reading=\", a_name + \"+\" + o_name,\n              \"sigma_a2=\", sigma_a2, \"sigma_o=\", sigma_o)\n        for r in sites:\n            print(r, rows[r])\n        print(\"C_rank_desc=\", sorted(sites, key=lambda r: (-rows[r][\"C\"], r)))\n        print(\"L_rank_desc=\", sorted(sites, key=lambda r: (-rows[r][\"L\"], r)))\n        print(\"mechanism_top_B=\", selection(\"C\"), \"naive_top_B=\", selection(\"L\"))\n        print(\"rho_all=\", spearman([rows[r][\"C\"] for r in sites], [rows[r][\"L\"] for r in sites]))\n        for contact in (True, False):\n            idx = [i for i, e in enumerate(episodes) if e[\"contact\"] == contact]\n            cvals = [mean([rows[r][\"episode_C\"][i] for i in idx]) for r in sites]\n            lvals = [rows[r][\"L\"] for r in sites]\n            print(\"contact=\", contact, \"C=\", cvals, \"L=\", lvals,\n                  \"rho=\", spearman(cvals, lvals))\n        print(\"---\")\nprint(\"synthetic_joint_stress_residual_loss_when_one_site_protected=\",\n      {\"r1\": 100, \"r2\": 20, \"r3\": 5},\n      \"single_site_C_top=\", \"r2 under flattened_population+per_pixel_population\",\n      \"joint_best_lower_loss=\", \"r3\")\nprint(\"synthetic_site_count_cost_stress=\",\n      {\"same_B_site\": 1, \"schedule_A_bytes\": 9, \"schedule_B_bytes\": 1,\n       \"bytes_ratio\": 9},\n      \"site_count_does_not_fix_bytes=True\")\nprint(\"nominal_1_2_gpu_day_hours_if_gpu_day_means_24h=\", 1.2 * 24,\n      \"memory_equivalence_unestablished=True\")\n\r\n",
