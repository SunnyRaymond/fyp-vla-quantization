--- /dev/null
+++ b/_phase2_3_t3.py
@@ -0,0 +1,36 @@
+from statistics import mean, pstdev, StatisticsError
+
+def probe_empty():
+    try:
+        mean([])
+        return "unexpectedly returned"
+    except Exception as e:
+        return type(e).__name__
+
+def probe_constant():
+    actions = [[2.0, 2.0], [2.0, 2.0]]
+    observations = [[7.0, 7.0], [7.0, 7.0]]
+    return {
+        "sigma_a2": mean(
+            pstdev([row[p] for row in actions]) ** 2
+            for p in range(2)
+        ),
+        "sigma_o": mean(
+            pstdev([row[p] for row in observations])
+            for p in range(2)
+        ),
+    }
+
+def probe_top(values, B):
+    return sorted(values, key=lambda r: (-r[1], r[0]))[:B]
+
+print("empty_calibration_mean=", probe_empty())
+print("constant_inputs=", probe_constant(), "epsilon_floors_needed=True")
+print("B_zero=", probe_top([("r1", 1.0), ("r2", 1.0)], 0))
+print("threshold_tie=", probe_top([("r2", 1.0), ("r1", 1.0)], 1))
+print("single_site_spearman=undefined (rank variance is zero)")
+print("B_exceeds_registry=", probe_top([("r1", 1.0)], 2), "silent_overrun_without_guard=True")
+try:
+    raise StatisticsError("sample variance requires at least two observations")
+except StatisticsError as e:
+    print("single_episode_sample_variance=", type(e).__name__)
