37: RUN_DIR="$PWD/ideaspark_run/<topic-slug>"   # convention below; any absolute dir works. No mkdir needed — every phase mkdir -p's its own --out, and `next` treats a missing dir as a fresh run
38: python3 -m pip install feedparser openreview-py beautifulsoup4 pymupdf
39: python3 "$SKILL_DIR/scripts/run.py" check_connectors   # from the SAME shell you'll run phases from
