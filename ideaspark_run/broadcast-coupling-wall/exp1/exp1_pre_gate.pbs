#!/bin/bash
#PBS -N bc_wall_e1p3
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=16:mem=110gb:ngpus=1
#PBS -l walltime=00:20:00
#PBS -j oe
set -euo pipefail

ROOT=/scratch/users/ntu/yguo017/dino-wm-wall
EXP="$ROOT/broadcast_coupling_wall"
CONTROL="$EXP/control"
OUT="$EXP/artifacts/$PBS_JOBID"
WORK="${TMPDIR:?TMPDIR missing}/bc-wall-exp1-$PBS_JOBID"

test -n "${PBS_JOBID:-}"
case "$(hostname -s | tr '[:upper:]' '[:lower:]')" in
  *login*|*head*|*submit*) echo "Refusing non-compute host" >&2; exit 64 ;;
esac
test -n "${PBS_NODEFILE:-}"
test -f "$PBS_NODEFILE"
test -n "${CUDA_VISIBLE_DEVICES:-}"

mkdir -p "$OUT" "$WORK"
exec > >(tee -a "$OUT/job.log") 2>&1
module purge
module load gcc/11.4.0-nscc python/3.11.7-gcc11
python "$CONTROL/allocation_guard.py"

test -f "$ROOT/runtime-complete.tar"
test -f "$ROOT/checkpoints/outputs/wall_single/checkpoints/model_latest.pth"
test -d "$ROOT/data/wall_single"
test -f "$ROOT/rankcal_screen/control/smoke_runner.py"

tar -xf "$ROOT/runtime-complete.tar" -C "$WORK"
export PYTHONUNBUFFERED=1 OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
export TORCH_HOME="$WORK/runtime/torch" MPLBACKEND=Agg
export PYTHONPATH="$ROOT/source:$CONTROL"

"$WORK/runtime/venv/bin/python" "$CONTROL/runner.py" \
  --root "$ROOT" \
  --output "$OUT" \
  --smoke-runner "$ROOT/rankcal_screen/control/smoke_runner.py" \
  --episode-indices 130,131,132,133,134,135
"$WORK/runtime/venv/bin/python" "$CONTROL/verify.py" "$OUT"
touch "$OUT/VERIFIED"
