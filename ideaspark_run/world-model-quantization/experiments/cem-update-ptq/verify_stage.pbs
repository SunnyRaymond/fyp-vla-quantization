#!/bin/bash
#PBS -N cem_update_verify
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=4:mem=20gb
#PBS -l walltime=00:10:00
#PBS -j oe
set -euo pipefail
test -n "${PBS_JOBID:-}"
case "$(hostname -s)" in *login*) exit 91;; esac
ROOT=/scratch/users/ntu/yguo017/dino-wm-wall
BASE="$ROOT/cem_update_v1"
CONTROL="$BASE/control"
python3 "$CONTROL/allocation_guard.py"
[[ "${SEARCH_JOB:-}" =~ ^[0-9]+\.pbs[0-9]+$ ]]
OUT="$BASE/artifacts/$PBS_JOBID"
mkdir "$OUT"
exec > >(tee -a "$OUT/job.log") 2>&1
cp "$CONTROL/verify_stage_b.py" "$CONTROL/allocation_guard.py" "$OUT/"
module purge
module load gcc/11.4.0-nscc python/3.11.7-gcc11
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
timeout --signal=TERM --kill-after=15s 8m "$BASE/runtime_bundle/runtime/venv/bin/python" "$OUT/verify_stage_b.py" --base "$BASE" --search "$BASE/artifacts/$SEARCH_JOB" --output "$OUT/verification.json"
