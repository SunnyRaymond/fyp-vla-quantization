"C:\\Users\\Raymond\\.cache\\codex-runtimes\\codex-primary-runtime\\dependencies\\native\\powershell\\pwsh.exe" -Command '$p = '"'C:\\Users\\Raymond\\.codex\\skills\\idea-spark\\SKILL.md'; "'$lines = Get-Content -LiteralPath $p; foreach ($range in @(@(140,164),@(165,189),@(190,219))) { $a=$range[0]; $b=$range[1]; Write-Output ("--- IDEA-SPARK ${a}-${b} ---"); $lines | Select-Object -Skip $a -First ($b-$a+1) }' in D:\Downloads\Final Year Project
