#!/usr/bin/env bash
# CPU-only validation of the existing PushT overlay and native env startup.
#PBS -N lpwm-overlay-probe
#PBS -q normal
#PBS -P personal-yguo017
#PBS -l select=1:ncpus=4:mem=32gb
#PBS -l walltime=00:15:00
#PBS -j oe

set -euo pipefail
OUT=/scratch/users/ntu/yguo017/experiment/reproduction/lpwm
REPO="$OUT/lpworldmodel-bdd812d"
COMMIT=bdd812d9432cccda8c350086006401b436f91982
PY=/scratch/users/ntu/yguo017/lewm-pusht-iteration/venv/bin/python
MIN_OVERLAY="$OUT/runtime-overlay-minimal"
PUSHT_OVERLAY=/scratch/users/ntu/yguo017/dino-wm-wall/artifacts/pusht-python-overlay-pusht-v5

fail() { echo "OVERLAY_PROBE_INVALID: $*"; exit 2; }
[[ -n "${PBS_JOBID:-}" ]] || fail "PBS_JOBID missing"
[[ -s "${PBS_NODEFILE:-}" ]] || fail "PBS_NODEFILE missing or empty"
HOST=$(hostname -f 2>/dev/null || hostname)
[[ "$HOST" != *login* ]] || fail "login host rejected: $HOST"
awk -v h="$HOST" 'BEGIN{ok=0} {n=$1; sub(/\..*/,"",n); x=h; sub(/\..*/,"",x); if(tolower(n)==tolower(x))ok=1} END{exit !ok}' "$PBS_NODEFILE" || fail "host is not listed in PBS_NODEFILE: $HOST"
[[ -x "$PY" ]] || fail "verified Python runtime unavailable: $PY"
[[ -f "$REPO/SOURCE_COMMIT" && "$(cat "$REPO/SOURCE_COMMIT")" == "$COMMIT" ]] || fail "pinned source marker mismatch"
[[ -d "$MIN_OVERLAY/gym" && -d "$MIN_OVERLAY/decord" ]] || fail "minimal runtime overlay absent"
[[ -d "$PUSHT_OVERLAY/skimage" ]] || fail "existing PushT v5 scikit-image package absent: $PUSHT_OVERLAY"

JOB_ROOT="$OUT/overlay-probe-runs/$PBS_JOBID"
mkdir -p "$JOB_ROOT"
REPORT="$JOB_ROOT/runtime_probe.json"
exec > >(tee -a "$JOB_ROOT/job.log") 2>&1
echo "PBS_JOBID=$PBS_JOBID HOST=$HOST NODEFILE=$PBS_NODEFILE"
echo "START_UTC=$(date -u +%FT%TZ)"
echo "SOURCE_COMMIT=$COMMIT"
echo "EXISTING_PUSHT_OVERLAY=$PUSHT_OVERLAY"
echo "MINIMAL_LPWM_OVERLAY=$MIN_OVERLAY"

export PATH="$(dirname "$PY"):$PATH"
export PYTHONPATH="$PUSHT_OVERLAY:$MIN_OVERLAY:$REPO${PYTHONPATH:+:$PYTHONPATH}"
export SDL_VIDEODRIVER=dummy PYTHONUNBUFFERED=1
cd "$REPO"
"$PY" -u "$OUT/plan_overlay_probe.py" "$REPORT"
echo "REPORT=$REPORT"
echo "END_UTC=$(date -u +%FT%TZ)"
echo "OVERLAY_PROBE_COMPLETE"
