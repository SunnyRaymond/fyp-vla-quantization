#!/usr/bin/env bash
# Cost-only GPU calibration; never a scientific training/evaluation run.
#PBS -N lpwm-cost-cal
#PBS -q normal
#PBS -P personal-yguo017
#PBS -l select=1:ncpus=16:mem=110gb:ngpus=1
#PBS -l walltime=00:15:00
#PBS -j oe

set -euo pipefail
OUT=/scratch/users/ntu/yguo017/experiment/reproduction/lpwm
REPO="$OUT/lpworldmodel-bdd812d"
DINO_ROOT=/scratch/users/ntu/yguo017/dino-wm-wall
DATA="$DINO_ROOT/data"
PY=/scratch/users/ntu/yguo017/lewm-pusht-iteration/venv/bin/python
OVERLAY="$OUT/runtime-overlay-minimal"
RECOVERY_REPORT="$OUT/train-video-recovery-25570558.pbs101.json"

fail() { echo "CALIBRATION_INVALID: $*"; exit 2; }
[[ -n "${PBS_JOBID:-}" ]] || fail "PBS_JOBID missing"
[[ -s "${PBS_NODEFILE:-}" ]] || fail "PBS_NODEFILE missing or empty"
HOST=$(hostname -f 2>/dev/null || hostname)
[[ "$HOST" != *login* ]] || fail "login host rejected: $HOST"
awk -v h="$HOST" 'BEGIN{ok=0} {n=$1; sub(/\..*/,"",n); x=h; sub(/\..*/,"",x); if(tolower(n)==tolower(x))ok=1} END{exit !ok}' "$PBS_NODEFILE" || fail "host is not listed in PBS_NODEFILE: $HOST"
[[ -x "$PY" ]] || fail "verified existing Python runtime unavailable: $PY"
[[ -f "$REPO/SOURCE_COMMIT" && "$(cat "$REPO/SOURCE_COMMIT")" == "bdd812d9432cccda8c350086006401b436f91982" ]] || fail "pinned source marker absent"
[[ -s "$RECOVERY_REPORT" ]] || fail "official OSF train-video recovery report absent"
[[ -d "$OVERLAY/accelerate" && -d "$OVERLAY/gym" && -d "$OVERLAY/decord" ]] || fail "minimal isolated runtime overlay absent"
command -v nvidia-smi >/dev/null 2>&1 || fail "nvidia-smi unavailable"

# The old PUSHT_ASSETS_READY marker refers to an extraction that failed before
# reaching the dataset. Gate GPU work on the completed, small CPU recovery report.
"$PY" - "$RECOVERY_REPORT" <<'PY'
import json, pathlib, sys
p = pathlib.Path(sys.argv[1])
d = json.loads(p.read_text(encoding="utf-8"))
assert d.get("schema") == "lpwm-official-pusht-train-video-recovery-v1"
assert d.get("pbs_job_id") == "25570558.pbs101"
assert d.get("source_commit") == "bdd812d9432cccda8c350086006401b436f91982"
assert d.get("archive_member_ids_exactly_cover_metadata") is True
assert d.get("post_extraction_exact_name_and_size_coverage") is True
assert d.get("metadata_train_trajectory_count") == 18685
assert d.get("archive_train_clip_member_count") == 18685
assert d.get("existing_same_size_clip_count", 0) + d.get("newly_extracted_clip_count", 0) == 18685
assert d.get("metadata_modified") is False
assert d.get("existing_destination_files_overwritten") == 0
factory = d.get("official_factory_getitem", {})
assert set(factory) == {"train", "valid"}
base = d.get("official_base_get_frames", {})
assert {"9956", "2930", "18684"}.issubset(base)
assert all(base[k].get("frame_indices") == [0, 5, 10, 15] for k in ("9956", "2930", "18684"))
print("MEDIA_RECOVERY_GATE=PASS report=" + str(p))
PY

JOB_ROOT="$OUT/calibration_runs/$PBS_JOBID"
CAL_ROOT="$JOB_ROOT/cost"
CKPT_BASE="$JOB_ROOT/checkpoints"
JOBLOG="$JOB_ROOT/job.log"
mkdir -p "$CAL_ROOT" "$CKPT_BASE"
exec > >(tee -a "$JOBLOG") 2>&1
echo "PBS_JOBID=$PBS_JOBID HOST=$HOST NODEFILE=$PBS_NODEFILE"
echo "START_UTC=$(date -u +%FT%TZ)"
echo "SOURCE_COMMIT=bdd812d9432cccda8c350086006401b436f91982"
echo "DATA_SOURCE_ARCHIVE=official DINO-WM OSF PushT item k2d8w"
echo "MEDIA_RECOVERY_REPORT=$RECOVERY_REPORT"
echo "RUNTIME_PYTHON=$PY"
echo "CALIBRATION_ONLY=1; FORMAL_EPOCHS=2; PER_ARM_UPDATES=110 (warmup=10,timed=100)"
nvidia-smi --query-gpu=name,uuid,memory.total --format=csv

# Required five-second utilization/VRAM sampling in this job's job.log.
(
  while true; do
    printf 'GPU_TELEMETRY_UTC=%s ' "$(date -u +%FT%TZ)"
    nvidia-smi --query-gpu=utilization.gpu,memory.used,memory.total --format=csv,noheader,nounits | tr '\n' ';'
    printf '\n'
    sleep 5
  done
) >> "$JOBLOG" 2>&1 &
TELEMETRY_PID=$!
stop_telemetry() {
  kill "$TELEMETRY_PID" 2>/dev/null || true
  wait "$TELEMETRY_PID" 2>/dev/null || true
}
trap stop_telemetry EXIT

export PATH="$(dirname "$PY"):$PATH"
export PYTHONPATH="$OVERLAY:$REPO${PYTHONPATH:+:$PYTHONPATH}"
export DATASET_DIR="$DATA"
export CKPT_BASE
export WANDB_MODE=offline
export SDL_VIDEODRIVER=dummy
# The newly created trusted calibration checkpoint stores official Python module objects.
export TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1
cd "$REPO"

for ARM in sparse dense; do
  RUN_NAME="costcal_${ARM}_mlp_var_pd384"
  ARM_DIR="$CAL_ROOT/$ARM"
  mkdir -p "$ARM_DIR"
  echo "CALIBRATION_ARM_BEGIN=$ARM RUN_NAME=$RUN_NAME UTC=$(date -u +%FT%TZ)"
  export LPWM_REPO="$REPO" LPWM_CALIBRATION_ROOT="$CAL_ROOT"
  export LPWM_CALIBRATION_ARM="$ARM" LPWM_CALIBRATION_RUN_NAME="$RUN_NAME"
  set +e
  "$PY" -u "$OUT/cost_calibration_runner.py" 2>&1 | tee "$ARM_DIR/runner.log"
  TRAIN_RC=${PIPESTATUS[0]}
  set -e
  echo "CALIBRATION_ARM_EXIT arm=$ARM exit_code=$TRAIN_RC"
  if [[ "$TRAIN_RC" -ne 0 ]]; then
    exit "$TRAIN_RC"
  fi
done

# One native plan call measures cost only; its task outcome is not exported or
# used to choose experiment parameters.
PLAN_START=$(date +%s.%N)
echo "PLAN_COST_SAMPLE_BEGIN=arm=sparse n_evals=1 CEM=300/30/30 H=5 MPC_outer=10 seed=99 UTC=$(date -u +%FT%TZ)"
PLAN_TIMEOUT=$((840 - SECONDS))
if [[ "$PLAN_TIMEOUT" -gt 600 ]]; then PLAN_TIMEOUT=600; fi
if [[ "$PLAN_TIMEOUT" -le 10 ]]; then
  PLAN_RC=124
  echo "PLAN_COST_SAMPLE_SKIPPED=insufficient walltime reserve=${PLAN_TIMEOUT}s"
else
  set +e
  SEED=99 DATASET_DIR="$DATA" CKPT_BASE="$CKPT_BASE" WANDB_MODE=offline \
    timeout --signal=TERM --kill-after=10 "$PLAN_TIMEOUT" \
    scripts/plan.sh plan_lewm.yaml costcal_sparse_mlp_var_pd384 latest 1 10 \
    > "$CAL_ROOT/native-plan.log" 2>&1
  PLAN_RC=$?
  set -e
fi
PLAN_END=$(date +%s.%N)
"$PY" - "$CAL_ROOT" "$PLAN_START" "$PLAN_END" "$PLAN_RC" "$PBS_JOBID" "$HOST" <<'PY'
import json, pathlib, sys
root = pathlib.Path(sys.argv[1])
start, end, rc = float(sys.argv[2]), float(sys.argv[3]), int(sys.argv[4])
job_id, host = sys.argv[5], sys.argv[6]
payload = {
    "status": "COST_SAMPLE_COMPLETE" if rc == 0 else "COST_SAMPLE_INCOMPLETE",
    "arm": "sparse",
    "official_plan_entrypoint": "scripts/plan.sh plan_lewm.yaml <run_name> latest 1 10",
    "n_evals": 1,
    "seed": 99,
    "cem_candidates": 300,
    "cem_elites": 30,
    "cem_opt_steps": 30,
    "goal_H": 5,
    "mpc_max_replanning_iterations": 10,
    "planner_exit_code": rc,
    "wall_seconds": end - start,
    "outcome_metrics_exported": False,
}
(root / "native_plan_cost.json").write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
job_summary = {
    "status": "CALIBRATION_COMPLETE" if rc == 0 else "CALIBRATION_PARTIAL",
    "pbs_job_id": job_id,
    "execution_host": host,
    "cost_only": True,
    "arms": ["sparse", "dense"],
    "updates_per_arm": 110,
    "warmup_updates_per_arm": 10,
    "timed_updates_per_arm": 100,
    "native_plan_samples": 1,
    "native_plan_exit_code": rc,
    "formal_success_metrics_reported": False,
    "formal_run_weights_used": False,
}
(root.parent / "job_summary.json").write_text(json.dumps(job_summary, indent=2) + "\n", encoding="utf-8")
print("NATIVE_PLAN_COST_SAMPLE=" + json.dumps(payload, sort_keys=True))
PY

if [[ "$PLAN_RC" -ne 0 ]]; then
  echo "CALIBRATION_PARTIAL=both training cells completed; native plan cost sample did not complete"
  exit 3
fi

echo "CALIBRATION_COMPLETE"
echo "END_UTC=$(date -u +%FT%TZ)"
