#!/usr/bin/env bash
#PBS -N lpwm-train-videos
#PBS -q normal
#PBS -P personal-yguo017
#PBS -l select=1:ncpus=8:mem=64gb
#PBS -l walltime=01:00:00
#PBS -j oe

set -euo pipefail

OUT=/scratch/users/ntu/yguo017/experiment/reproduction/lpwm
REPO="$OUT/lpworldmodel-bdd812d"
COMMIT=bdd812d9432cccda8c350086006401b436f91982
DINO_ROOT=/scratch/users/ntu/yguo017/dino-wm-wall
DATA="$DINO_ROOT/data"
TRAIN="$DATA/pusht_noise/train"
ARCHIVE="$DINO_ROOT/artifacts/pusht-assets-23952308.pbs101/downloads/official-pusht-noise.zip"
PY=/scratch/users/ntu/yguo017/lewm-pusht-iteration/venv/bin/python
OVERLAY="$OUT/runtime-overlay-minimal"
LOCK="$OUT/train_obses_recovery.lock"
LOG="$OUT/train-video-recovery-${PBS_JOBID:-missing}.log"

fail() { echo "RECOVERY_INVALID: $*"; exit 2; }
[[ -n "${PBS_JOBID:-}" ]] || fail "PBS_JOBID missing"
[[ -s "${PBS_NODEFILE:-}" ]] || fail "PBS_NODEFILE missing or empty"
HOST=$(hostname -f 2>/dev/null || hostname)
[[ "$HOST" != *login* ]] || fail "login host rejected: $HOST"
awk -v h="$HOST" 'BEGIN{ok=0} {n=$1; sub(/\..*/,"",n); x=h; sub(/\..*/,"",x); if(tolower(n)==tolower(x))ok=1} END{exit !ok}' "$PBS_NODEFILE" || fail "host is not listed in PBS_NODEFILE: $HOST"
[[ -x "$PY" ]] || fail "verified existing Python runtime unavailable: $PY"
[[ -f "$REPO/SOURCE_COMMIT" && "$(cat "$REPO/SOURCE_COMMIT")" == "$COMMIT" ]] || fail "pinned source marker mismatch"
[[ -f "$REPO/datasets/pusht_dset.py" ]] || fail "pinned official loader missing"
[[ -f "$ARCHIVE" ]] || fail "official OSF archive missing at recorded path"
[[ -f "$TRAIN/seq_lengths.pkl" ]] || fail "official train metadata missing"
[[ -d "$TRAIN/obses" && ! -L "$TRAIN/obses" ]] || fail "train/obses must be an existing real directory"

mkdir -p "$OUT"
if ! mkdir "$LOCK" 2>/dev/null; then
  fail "single-writer lock already exists: $LOCK"
fi
printf '%s\n' "$PBS_JOBID" > "$LOCK/job_id"
cleanup_lock() { rm -f "$LOCK/job_id"; rmdir "$LOCK" 2>/dev/null || true; }
trap cleanup_lock EXIT

exec > >(tee -a "$LOG") 2>&1
echo "PBS_JOBID=$PBS_JOBID HOST=$HOST NODEFILE=$PBS_NODEFILE"
echo "START_UTC=$(date -u +%FT%TZ)"
echo "SOURCE_COMMIT=$COMMIT"
echo "DATA_ROOT=$DATA/pusht_noise"
echo "OFFICIAL_ARCHIVE=$ARCHIVE"
stat -c "OSF_ARCHIVE_SIZE_BYTES=%s MTIME=%y PATH=%n" "$ARCHIVE"
echo "MARKER_IS_HISTORICAL_CONTROL_ONLY=$(cat "$DINO_ROOT/PUSHT_ASSETS_READY" 2>/dev/null || echo MISSING)"

export PBS_JOBID OUT REPO DATASET_DIR="$DATA"
export PYTHONPATH="$OVERLAY:$REPO${PYTHONPATH:+:$PYTHONPATH}"
cd "$REPO"
"$PY" - <<'PY'
import json
import os
import pickle
import re
import shutil
import time
import zipfile
from pathlib import Path, PurePosixPath

import numpy as np
import torch

job_id = os.environ["PBS_JOBID"]
out = Path(os.environ["OUT"])
root = Path(os.environ["DATASET_DIR"]) / "pusht_noise"
train_root = root / "train"
obs_root = train_root / "obses"
archive_path = Path("/scratch/users/ntu/yguo017/dino-wm-wall/artifacts/pusht-assets-23952308.pbs101/downloads/official-pusht-noise.zip")
report_path = out / f"train-video-recovery-{job_id}.json"
start = time.monotonic()

with (train_root / "seq_lengths.pkl").open("rb") as f:
    seq_lengths = pickle.load(f)
trajectory_count = len(seq_lengths)
expected_ids = set(range(trajectory_count))
member_re = re.compile(r"pusht_noise/train/obses/episode_(\d+)\.mp4\Z")

print(f"TRAIN_METADATA_TRAJECTORIES={trajectory_count}")
print(f"EXPECTED_VIDEO_NAME_RANGE=episode_000.mp4..episode_{trajectory_count - 1:03d}.mp4")
archive_index_start = time.monotonic()
with zipfile.ZipFile(archive_path, "r") as zf:
    by_id = {}
    for info in zf.infolist():
        match = member_re.fullmatch(info.filename)
        if match is None:
            continue
        rel = PurePosixPath(info.filename)
        if rel.is_absolute() or any(part in ("", ".", "..") for part in rel.parts):
            raise RuntimeError(f"unsafe archive member path: {info.filename}")
        clip_id = int(match.group(1))
        if clip_id in by_id:
            raise RuntimeError(f"duplicate archive video id {clip_id}: {by_id[clip_id].filename} and {info.filename}")
        if info.file_size <= 0:
            raise RuntimeError(f"empty archive video member: {info.filename}")
        by_id[clip_id] = info
    archive_index_seconds = time.monotonic() - archive_index_start
    archive_ids = set(by_id)
    missing_ids = sorted(expected_ids - archive_ids)
    extra_ids = sorted(archive_ids - expected_ids)
    print(f"ARCHIVE_TRAIN_CLIP_MEMBERS={len(by_id)}")
    print(f"ARCHIVE_MEMBER_INDEX_SECONDS={archive_index_seconds:.3f}")
    if missing_ids or extra_ids or len(by_id) != trajectory_count:
        raise RuntimeError(f"official archive clip names do not exactly cover metadata trajectories; missing={missing_ids[:8]} extra={extra_ids[:8]}")

    size_mismatches = []
    existing_same_size = 0
    missing_destinations = []
    for clip_id, info in sorted(by_id.items()):
        destination = obs_root / f"episode_{clip_id:03d}.mp4"
        if destination.is_symlink():
            size_mismatches.append((str(destination), "symlink destination refused"))
        elif destination.exists():
            if not destination.is_file():
                size_mismatches.append((str(destination), "not a regular file"))
            elif destination.stat().st_size != info.file_size:
                size_mismatches.append((str(destination), f"existing={destination.stat().st_size} archive={info.file_size}"))
            else:
                existing_same_size += 1
        else:
            missing_destinations.append((clip_id, info, destination))
    if size_mismatches:
        for path, details in size_mismatches[:20]:
            print(f"PREEXISTING_MISMATCH path={path} details={details}")
        raise RuntimeError(f"found {len(size_mismatches)} preexisting destination mismatch(es); no extraction started")
    print(f"PREEXISTING_SAME_SIZE_CLIPS={existing_same_size}")
    print(f"MISSING_TRAIN_CLIPS_TO_RECOVER={len(missing_destinations)}")

    extracted_bytes = 0
    extracted_count = 0
    extraction_start = time.monotonic()
    for clip_id, info, destination in missing_destinations:
        partial = destination.with_name(destination.name + f".lpwm-{job_id}.partial")
        if partial.exists() or destination.exists():
            raise RuntimeError(f"recovery destination or partial appeared concurrently; refusing overwrite: {destination}")
        try:
            with zf.open(info, "r") as src, partial.open("xb") as dst:
                shutil.copyfileobj(src, dst, length=8 * 1024 * 1024)
                dst.flush()
                os.fsync(dst.fileno())
            actual_size = partial.stat().st_size
            if actual_size != info.file_size:
                raise RuntimeError(f"extracted size mismatch for {info.filename}: actual={actual_size}, archive={info.file_size}")
            try:
                os.link(partial, destination)
            except FileExistsError as exc:
                raise RuntimeError(f"destination appeared before atomic publication; refusing overwrite: {destination}") from exc
            partial.unlink()
            extracted_count += 1
            extracted_bytes += actual_size
        except Exception:
            partial.unlink(missing_ok=True)
            raise
        if extracted_count % 1000 == 0:
            print(f"EXTRACTION_PROGRESS clips={extracted_count} bytes={extracted_bytes}", flush=True)
    extraction_seconds = time.monotonic() - extraction_start

    final_check_start = time.monotonic()
    final_missing = []
    final_mismatch = []
    for clip_id, info in sorted(by_id.items()):
        destination = obs_root / f"episode_{clip_id:03d}.mp4"
        if not destination.is_file():
            final_missing.append(clip_id)
        elif destination.stat().st_size != info.file_size:
            final_mismatch.append((clip_id, destination.stat().st_size, info.file_size))
    final_coverage_seconds = time.monotonic() - final_check_start
    if final_missing or final_mismatch:
        raise RuntimeError(f"post-extraction exact coverage failed; missing={final_missing[:8]} mismatches={final_mismatch[:8]}")

    print("OFFICIAL_FACTORY_ITEM_CHECK_BEGIN")
    from datasets.pusht_dset import load_pusht_slice_train_val
    np.random.seed(0)
    torch.manual_seed(0)
    datasets, trajectories = load_pusht_slice_train_val(
        transform=None,
        n_rollout=None,
        data_path=str(root),
        normalize_action=True,
        split_ratio=0.9,
        num_hist=3,
        num_pred=1,
        frameskip=5,
        with_velocity=True,
    )
    train_slices = datasets["train"]
    valid_slices = datasets["valid"]
    train_base = trajectories["train"]
    valid_base = trajectories["valid"]
    factory_item_shapes = {}
    for split_name, dataset in (("train", train_slices), ("valid", valid_slices)):
        item = dataset[0]
        obs, act, state = item
        factory_item_shapes[split_name] = {
            "visual": list(obs["visual"].shape),
            "proprio": list(obs["proprio"].shape),
            "action": list(act.shape),
            "state": list(state.shape),
        }
        print(f"OFFICIAL_FACTORY_GETITEM_PASS split={split_name} shapes={json.dumps(factory_item_shapes[split_name])}")

    frame_indices = [0, 5, 10, 15]
    base_reads = {}
    for clip_id in (9956, 2930, trajectory_count - 1):
        if clip_id >= len(train_base):
            raise RuntimeError(f"requested train metadata trajectory outside dataset: {clip_id}")
        if int(train_base.seq_lengths[clip_id]) <= max(frame_indices):
            raise RuntimeError(f"requested official frame index unavailable for train trajectory {clip_id}")
        obs, act, state, meta = train_base.get_frames(clip_id, frame_indices)
        base_reads[str(clip_id)] = {
            "frame_indices": frame_indices,
            "visual": list(obs["visual"].shape),
            "action": list(act.shape),
            "state": list(state.shape),
        }
        print(f"OFFICIAL_BASE_GET_FRAMES_PASS episode={clip_id} frames={frame_indices} shapes={json.dumps(base_reads[str(clip_id)])}")

    total_seconds = time.monotonic() - start
    report = {
        "schema": "lpwm-official-pusht-train-video-recovery-v1",
        "pbs_job_id": job_id,
        "source_commit": "bdd812d9432cccda8c350086006401b436f91982",
        "dataset_source": "DINO-WM official OSF PushT archive item k2d8w; pre-existing read-only archive; no download",
        "archive_path": str(archive_path),
        "archive_size_bytes": archive_path.stat().st_size,
        "archive_member_root": "pusht_noise/train/obses/episode_<index>.mp4",
        "metadata_train_trajectory_count": trajectory_count,
        "archive_train_clip_member_count": len(by_id),
        "archive_member_ids_exactly_cover_metadata": True,
        "existing_same_size_clip_count": existing_same_size,
        "newly_extracted_clip_count": extracted_count,
        "newly_extracted_uncompressed_bytes": extracted_bytes,
        "archive_index_seconds": round(archive_index_seconds, 3),
        "extraction_seconds": round(extraction_seconds, 3),
        "final_coverage_check_seconds": round(final_coverage_seconds, 3),
        "post_extraction_exact_name_and_size_coverage": True,
        "hashes_computed": False,
        "metadata_modified": False,
        "existing_destination_files_overwritten": 0,
        "official_factory_getitem": factory_item_shapes,
        "official_base_get_frames": base_reads,
        "total_job_script_seconds": round(total_seconds, 3),
        "claim_limit": "Completes the official train video member set against existing training metadata and validates representative factory/base reads; no video payload hashes or recursive image audit were performed.",
    }
    report_path.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
    print("RECOVERY_REPORT=" + str(report_path))
    print("RECOVERY_SUMMARY=" + json.dumps({k: report[k] for k in (
        "metadata_train_trajectory_count",
        "archive_train_clip_member_count",
        "archive_member_ids_exactly_cover_metadata",
        "existing_same_size_clip_count",
        "newly_extracted_clip_count",
        "newly_extracted_uncompressed_bytes",
        "archive_index_seconds",
        "extraction_seconds",
        "post_extraction_exact_name_and_size_coverage",
        "official_factory_getitem",
        "official_base_get_frames",
    )}))
    print("TRAIN_VIDEO_RECOVERY_AND_NATIVE_READS_COMPLETE=1")
PY

echo "END_UTC=$(date -u +%FT%TZ)"
echo "TRAIN_VIDEO_RECOVERY_COMPLETE=1"
