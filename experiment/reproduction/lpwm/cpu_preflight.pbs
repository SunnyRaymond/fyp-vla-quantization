#!/usr/bin/env bash
# CPU-only LpWM source/data/runtime preflight. Heavy work is guarded to PBS compute nodes.
#PBS -N lpwm-cpu-preflight-2
#PBS -q normal
#PBS -P personal-yguo017
#PBS -l select=1:ncpus=8:mem=64gb
#PBS -l walltime=00:20:00
#PBS -j oe

set -euo pipefail
OUT=/scratch/users/ntu/yguo017/experiment/reproduction/lpwm
REPO="$OUT/lpworldmodel-bdd812d"
COMMIT=bdd812d9432cccda8c350086006401b436f91982
DATA=/scratch/users/ntu/yguo017/dino-wm-wall/data/pusht_noise
PY=/scratch/users/ntu/yguo017/lewm-pusht-iteration/venv/bin/python
LOG="$OUT/cpu-preflight-${PBS_JOBID:-missing}.log"

fail() { echo "PREFLIGHT_INVALID: $*"; exit 2; }
[[ -n "${PBS_JOBID:-}" ]] || fail "PBS_JOBID missing"
[[ -s "${PBS_NODEFILE:-}" ]] || fail "PBS_NODEFILE missing or empty"
HOST=$(hostname -f 2>/dev/null || hostname)
[[ "$HOST" != *login* ]] || fail "login host rejected: $HOST"
awk -v h="$HOST" 'BEGIN{ok=0} {n=$1; sub(/\..*/,"",n); x=h; sub(/\..*/,"",x); if(tolower(n)==tolower(x))ok=1} END{exit !ok}' "$PBS_NODEFILE" || fail "host is not listed in PBS_NODEFILE: $HOST"
mkdir -p "$OUT"
exec > >(tee -a "$LOG") 2>&1
echo "PBS_JOBID=$PBS_JOBID HOST=$HOST NODEFILE=$PBS_NODEFILE"
echo "START_UTC=$(date -u +%FT%TZ)"

[[ -x "$PY" ]] || fail "verified existing Python runtime unavailable: $PY"
echo "PYTHON=$PY"
"$PY" - "$OUT" "$REPO" "$COMMIT" <<'PY'
import os, pathlib, shutil, sys, tarfile, urllib.request
out, repo, commit = sys.argv[1:]
marker = os.path.join(repo, "SOURCE_COMMIT")
if os.path.isfile(marker) and open(marker, encoding="ascii").read().strip() == commit:
    print(f"OFFICIAL_SOURCE_ARCHIVE_COMMIT={commit} (reused verified marker)")
    raise SystemExit(0)
url = f"https://codeload.github.com/YilunKuang/lpworldmodel/tar.gz/{commit}"
archive = os.path.join(out, f"lpworldmodel-{commit}.tar.gz")
with urllib.request.urlopen(url, timeout=60) as response, open(archive, "wb") as target:
    shutil.copyfileobj(response, target)
os.makedirs(repo, exist_ok=True)
with tarfile.open(archive, "r:gz") as tf:
    members = tf.getmembers()
    roots = {pathlib.PurePosixPath(m.name).parts[0] for m in members if pathlib.PurePosixPath(m.name).parts}
    if len(roots) != 1:
        raise RuntimeError(f"unexpected archive roots: {roots}")
    prefix = next(iter(roots))
    for member in members:
        parts = pathlib.PurePosixPath(member.name).parts
        if not parts or parts[0] != prefix or ".." in parts or pathlib.PurePosixPath(member.name).is_absolute():
            raise RuntimeError(f"unsafe archive member: {member.name}")
        rel = parts[1:]
        if not rel:
            continue
        dst = os.path.abspath(os.path.join(repo, *rel))
        if os.path.commonpath((os.path.abspath(repo), dst)) != os.path.abspath(repo):
            raise RuntimeError(f"archive member escapes source directory: {member.name}")
        if member.isdir():
            os.makedirs(dst, exist_ok=True)
        elif member.isfile():
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            with tf.extractfile(member) as src, open(dst, "wb") as target:
                shutil.copyfileobj(src, target)
            os.chmod(dst, member.mode & 0o777)
        else:
            raise RuntimeError(f"unsupported archive member type: {member.name}")
with open(marker, "w", encoding="ascii") as f:
    f.write(commit + "\n")
print(f"OFFICIAL_SOURCE_ARCHIVE_COMMIT={commit}")
print(f"OFFICIAL_SOURCE_ARCHIVE_URL={url}")
PY
[[ -f "$REPO/SOURCE_COMMIT" ]] || fail "pinned source archive marker absent"
[[ "$(cat "$REPO/SOURCE_COMMIT")" == "$COMMIT" ]] || fail "source archive marker mismatch"
[[ -f "$REPO/scripts/reproduce_pusht.sh" && -f "$REPO/scripts/train.sh" && -f "$REPO/scripts/plan.sh" ]] || fail "official entrypoints absent"
echo "OFFICIAL_SOURCE_ARCHIVE_COMMIT=$COMMIT"
echo "SOURCE_ENTRYPOINTS=$(test -f "$REPO/scripts/reproduce_pusht.sh" && echo present)"
echo "DATA_ROOT=$DATA"
[[ -d "$DATA/train/obses" && -d "$DATA/val/obses" ]] || fail "expected train/val/obses layout absent"
for split in train val; do
  for f in seq_lengths.pkl rel_actions.pth states.pth velocities.pth; do
    [[ -f "$DATA/$split/$f" ]] || fail "missing $split/$f"
    stat -c "DATA_FILE=$split/$f SIZE_BYTES=%s MTIME=%y" "$DATA/$split/$f"
  done
done

"$PY" - <<'PY'
import importlib, os, pickle, sys, numbers
repo = "/scratch/users/ntu/yguo017/experiment/reproduction/lpwm/lpworldmodel-bdd812d"
sys.path.insert(0, repo)
print("PYTHON_VERSION=" + sys.version.replace("\n", " "))
import torch
print(f"TORCH_VERSION={torch.__version__}")
print(f"TORCH_CUDA_AVAILABLE={torch.cuda.is_available()}")
ready = True
for name in ("train", "plan"):
    try:
        importlib.import_module(name)
        print(f"OFFICIAL_IMPORT_{name}=PASS")
    except Exception as exc:
        ready = False
        print(f"OFFICIAL_IMPORT_{name}=FAIL:{type(exc).__name__}:{exc}")
print(f"RUNTIME_READY={int(ready)} (official train.py/plan.py imports only)")

root = "/scratch/users/ntu/yguo017/dino-wm-wall/data/pusht_noise"
def to_list(x):
    return x.tolist() if hasattr(x, "tolist") else x
def get_lengths(x):
    x = to_list(x)
    if isinstance(x, dict):
        for k in ("seq_lengths", "lengths", "episode_lengths"):
            if k in x:
                return get_lengths(x[k])
        return None
    if isinstance(x, (list, tuple)) and all(isinstance(v, numbers.Integral) for v in x):
        return [int(v) for v in x]
    return None
for split in ("train", "val"):
    path = os.path.join(root, split, "seq_lengths.pkl")
    with open(path, "rb") as f:
        obj = pickle.load(f)
    lens = get_lengths(obj)
    print(f"{split.upper()}_SEQ_LENGTHS_TYPE={type(obj).__name__}")
    if lens is None:
        raise TypeError(f"cannot interpret {split} sequence-length metadata: {type(obj).__name__}")
    else:
        windows = sum(max(0, n - 4 * 5 + 1) for n in lens)
        print(f"{split.upper()}_EPISODES={len(lens)}")
        print(f"{split.upper()}_FRAMES_SUM={sum(lens)}")
        print(f"{split.upper()}_WINDOWS_HISTORY3_FRAMESKIP5={windows}")
        print(f"{split.upper()}_BATCH_STEPS_EPOCH_BATCH64={(windows + 63) // 64}")
PY

echo "SOURCE_TRAINER_PARAMETERS_BEGIN"
find "$REPO" -maxdepth 3 -type f \( -name '*requirements*' -o -name 'environment*.yml' -o -name 'environment*.yaml' -o -name 'pyproject.toml' \) -print
grep -nE 'python=|accelerate==|gym==|hydra-core==|hydra-submitit-launcher==|torch==|torchvision==|wandb==' "$REPO/environment.yaml" || true
find "$REPO" -maxdepth 2 -type f -name '*.py' -print | head -60
echo "SOURCE_TRAINER_PARAMETERS_END"
echo "DISK_FREE=$(df -h "$OUT" | tail -1)"
echo "END_UTC=$(date -u +%FT%TZ)"
echo "PREFLIGHT_SOURCE_DATA_VALID=1"
