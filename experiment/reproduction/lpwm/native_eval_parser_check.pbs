#!/usr/bin/env bash
# Validate the native evaluator postprocessor on a small CPU PBS allocation.
#PBS -N lpwm-eval-parser
#PBS -q normal
#PBS -P personal-yguo017
#PBS -l select=1:ncpus=2:mem=8gb
#PBS -l walltime=00:15:00
#PBS -j oe

set -euo pipefail
OUT=/scratch/users/ntu/yguo017/experiment/reproduction/lpwm
PY=/scratch/users/ntu/yguo017/lewm-pusht-iteration/venv/bin/python
PUSHT_OVERLAY=/scratch/users/ntu/yguo017/dino-wm-wall/artifacts/pusht-python-overlay-pusht-v5
MIN_OVERLAY="$OUT/runtime-overlay-minimal"

fail() { echo "PARSER_CHECK_INVALID: $*"; exit 2; }
[[ -n "${PBS_JOBID:-}" ]] || fail "PBS_JOBID missing"
[[ -s "${PBS_NODEFILE:-}" ]] || fail "PBS_NODEFILE missing or empty"
HOST=$(hostname -f 2>/dev/null || hostname)
[[ "$HOST" != *login* ]] || fail "login host rejected: $HOST"
awk -v h="$HOST" 'BEGIN{ok=0} {n=$1; sub(/\..*/,"",n); x=h; sub(/\..*/,"",x); if(tolower(n)==tolower(x))ok=1} END{exit !ok}' "$PBS_NODEFILE" || fail "host is not listed in PBS_NODEFILE: $HOST"
[[ -x "$PY" && -f "$OUT/native_eval_postprocess.py" ]] || fail "runtime or postprocessor unavailable"
[[ -d "$PUSHT_OVERLAY/skimage" && -d "$MIN_OVERLAY/gym" ]] || fail "validated overlays unavailable"

JOB_ROOT="$OUT/native-eval-parser-runs/$PBS_JOBID"
mkdir -p "$JOB_ROOT"
exec > >(tee -a "$JOB_ROOT/job.log") 2>&1
export PYTHONPATH="$PUSHT_OVERLAY:$MIN_OVERLAY${PYTHONPATH:+:$PYTHONPATH}"
"$PY" "$OUT/native_eval_postprocess.py" --self-check
echo "PBS_JOBID=$PBS_JOBID HOST=$HOST"
echo "PARSER_CHECK_COMPLETE"
