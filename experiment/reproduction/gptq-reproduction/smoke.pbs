#!/bin/bash
#PBS -N gptq_smoke
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=16:mem=110gb:ngpus=1
#PBS -l walltime=00:10:00
#PBS -j oe
set -euo pipefail
ROOT=/scratch/users/ntu/yguo017/gptq-reproduction
cd "$ROOT"
test -f PREPARED
exec > >(tee "logs/smoke-$PBS_JOBID.log") 2>&1
module purge
module load gcc/11.4.0-nscc python/3.11.7-gcc11
export HF_HOME="$ROOT/cache/huggingface" HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
export OMP_NUM_THREADS=4 PYTHONUNBUFFERED=1 TOKENIZERS_PARALLELISM=false
nvidia-smi
for method in fp16 rtn4 gptq4; do
  timeout 150s venv/bin/python run.py --model opt-125m --method "$method"
done
touch SMOKE_PASSED
