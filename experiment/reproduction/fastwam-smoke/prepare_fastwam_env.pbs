#!/bin/bash
#PBS -N fw_env_prepare
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -l walltime=08:00:00
#PBS -j oe

set -eo pipefail

case "${PBS_JOBID:-}" in
  '') echo 'Refusing environment preparation: PBS_JOBID is missing.' >&2; exit 64 ;;
esac
case "$(hostname -s)" in
  *login*|asp2a-login*) echo 'Refusing environment preparation: login node is not a compute allocation.' >&2; exit 64 ;;
esac

ROOT=/scratch/users/ntu/yguo017/fastwam-smoke
SRC="$ROOT/FastWAM"
LIBERO_SRC="$ROOT/libero"
LIBERO_CONFIG="$ROOT/libero-config"
VENV="$ROOT/venv"
MODEL_BASE="$ROOT/model-cache"
SIF=/scratch/users/ntu/yguo017/openvla-oft-vla-eval-libero/containers/libero-latest.sif
REV=7faa71108368fbb3b6885649f112af607427a2d4
ARTIFACTS="$ROOT/artifacts/$PBS_JOBID"

mkdir -p "$ROOT" "$ARTIFACTS" "$MODEL_BASE" "$ROOT/cache/pip"
cp "$ROOT/prepare_fastwam_env.pbs" "$ARTIFACTS/"
exec > >(tee -a "$ARTIFACTS/job.log") 2>&1

module purge
module load gcc/11.4.0-nscc python/3.11.7-gcc11 apptainer/1.5.0 cuda/12.2.2
export PIP_CACHE_DIR="$ROOT/cache/pip"
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=8
export MKL_NUM_THREADS=8

date
hostname
module list 2>&1
df -h "$ROOT"
test -f "$SIF"
test -f "$ROOT/checkpoints/libero_optional_idm_2cam224.clean.VERIFIED"
test "$(stat -c %s "$ROOT/checkpoints/libero_optional_idm_2cam224.clean.pt")" = 12041735545
test "$(stat -c %s "$ROOT/checkpoints/libero_optional_idm_2cam224_dataset_stats.json")" = 40939

rm -rf "$SRC.stage" "$ROOT/FastWAM-$REV.tar.gz" "$SRC"
mkdir -p "$SRC.stage"
if [ -x /usr/bin/curl ]; then
  /usr/bin/curl --fail --location --retry 5 --retry-delay 10 \
    --output "$ROOT/FastWAM-$REV.tar.gz" \
    "https://github.com/yuantianyuan01/FastWAM/archive/$REV.tar.gz"
elif [ -x /usr/bin/wget ]; then
  /usr/bin/wget --continue --tries=0 --timeout=60 \
    --output-document="$ROOT/FastWAM-$REV.tar.gz" \
    "https://github.com/yuantianyuan01/FastWAM/archive/$REV.tar.gz"
else
  echo 'No supported source downloader on compute node' >&2
  exit 1
fi
tar -xzf "$ROOT/FastWAM-$REV.tar.gz" -C "$SRC.stage"
mv "$SRC.stage/FastWAM-$REV" "$SRC"
printf '%s\n' "$REV" > "$SRC/.fastwam-revision"
rm -rf "$SRC.stage"
test "$(cat "$SRC/.fastwam-revision")" = "$REV"
printf '%s\n' "$REV" | tee "$ARTIFACTS/FastWAM-revision.txt"

if ! "$VENV/bin/python" -c 'import sys; raise SystemExit(0 if sys.version_info[:2] >= (3, 11) else 1)' 2>/dev/null; then
  rm -rf "$VENV"
  python -m venv "$VENV"
fi
"$VENV/bin/python" -m pip install --upgrade pip setuptools wheel

"$VENV/bin/python" -m pip install --prefer-binary \
  'torch==2.7.1+cu128' 'torchvision==0.22.1+cu128' \
  --extra-index-url https://download.pytorch.org/whl/cu128

"$VENV/bin/python" -m pip install --prefer-binary \
  'av==15.1.0' 'datasets==4.8.5' 'deepspeed==0.18.7' \
  'accelerate==1.12.0' 'boto3==1.35.99' 'einops==0.8.1' \
  'gitpython==3.1.45' 'huggingface-hub==0.29.2' 'hydra-core==1.3.2' \
  'imageio==2.37.0' 'imageio-ffmpeg==0.6.0' 'mujoco==3.3.2' \
  'numpy==2.2.6' 'omegaconf==2.3.0' 'opencv-python-headless' \
  'pillow==12.0.0' 'regex==2025.11.3' 'rich==14.2.0' \
  'safetensors==0.5.3' 'scipy' 'termcolor==2.5.0' \
  'transformers==4.49.0' 'tqdm==4.68.3' 'typing-extensions==4.15.0' \
  'gym==0.23.1' 'robosuite==1.4.1' 'bddl==1.0.1' \
  'easydict==1.13' 'cloudpickle' 'h5py' 'matplotlib' \
  'modelscope==1.34.0' 'future==1.0.0' 'jsonlines==4.0.0' \
  'packaging==25.0' 'pandas==2.2.3' 'pyarrow==24.0.0' \
  'torchcodec==0.4.0' 'wandb==0.23.1'
"$VENV/bin/python" -m pip install --prefer-binary 'anyio==4.14.0'
"$VENV/bin/python" -m pip install --prefer-binary 'typing-extensions==4.15.0'

"$VENV/bin/python" -m pip install --no-deps -e "$SRC"

if [ ! -d "$LIBERO_SRC/libero" ]; then
  mkdir -p "$LIBERO_SRC"
  apptainer exec "$SIF" tar -cf - -C /app/libero/libero . \
    | tar -xf - -C "$LIBERO_SRC"
fi
test -d "$LIBERO_SRC/libero"

mkdir -p "$LIBERO_CONFIG"
cat > "$LIBERO_CONFIG/config.yaml" <<EOF
assets: $LIBERO_SRC/libero/assets
bddl_files: $LIBERO_SRC/libero/bddl_files
benchmark_root: $LIBERO_SRC/libero
datasets: $LIBERO_SRC/datasets
init_states: $LIBERO_SRC/libero/init_files
EOF
export PYTHONPATH="$LIBERO_SRC:${PYTHONPATH:-}"

export DIFFSYNTH_MODEL_BASE_PATH="$MODEL_BASE"
export DIFFSYNTH_DOWNLOAD_SOURCE=huggingface
printf '%s\n' 'Wan VAE/T5/tokenizer downloads are staged by download_components.pbs.' \
  | tee "$ARTIFACTS/model-cache-deferred.txt"
LIBERO_CONFIG_PATH="$LIBERO_CONFIG" "$VENV/bin/python" - <<'PY' | tee "$ARTIFACTS/import-smoke.txt"
import torch, torchvision, hydra, transformers, mujoco, robosuite, libero, fastwam
print("torch", torch.__version__)
print("torchvision", torchvision.__version__)
print("cuda_available", torch.cuda.is_available())
print("mujoco", mujoco.__version__)
print("imports=ok")
PY
touch "$ARTIFACTS/SUCCESS"
date
