#!/bin/bash
#PBS -N fw_env_repair
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=2:mem=4gb
#PBS -l walltime=00:30:00
#PBS -j oe

set -eo pipefail

case "${PBS_JOBID:-}" in
  '') echo 'Refusing environment repair: PBS_JOBID is missing.' >&2; exit 64 ;;
esac
case "$(hostname -s)" in
  *login*|asp2a-login*) echo 'Refusing environment repair: login node is not a compute allocation.' >&2; exit 64 ;;
esac

ROOT=/scratch/users/ntu/yguo017/fastwam-smoke
SRC="$ROOT/FastWAM"
LIBERO_SRC="$ROOT/libero"
LIBERO_COMPAT="$ROOT/libero-compat"
LIBERO_CONFIG="$ROOT/libero-config"
VENV="$ROOT/venv"
ARTIFACTS="$ROOT/artifacts/$PBS_JOBID"
mkdir -p "$ARTIFACTS"
exec > >(tee -a "$ARTIFACTS/job.log") 2>&1

module purge
module load gcc/11.4.0-nscc python/3.11.7-gcc11 apptainer/1.5.0 cuda/12.2.2
test -x "$VENV/bin/python"
test -f "$SRC/experiments/libero/eval_libero_single.py"
test -f "$LIBERO_CONFIG/config.yaml"
"$VENV/bin/python" -m pip install --prefer-binary \
  'av==15.1.0' 'datasets==4.8.5' 'deepspeed==0.18.7' \
  'future==1.0.0' 'jsonlines==4.0.0' 'packaging==25.0' \
  'pandas==2.2.3' 'pyarrow==24.0.0' 'torchcodec==0.4.0' \
  'wandb==0.23.1'
"$VENV/bin/python" -m pip install --prefer-binary 'anyio==4.14.0'
"$VENV/bin/python" -m pip install --prefer-binary 'typing-extensions==4.15.0'
mkdir -p "$LIBERO_COMPAT/libero/libero"
cat > "$LIBERO_COMPAT/libero/__init__.py" <<'PY'
# Compatibility namespace for FastWAM's legacy `libero.libero` imports.
PY
cat > "$LIBERO_COMPAT/libero/libero/__init__.py" <<PY
import os
_real_package = "$LIBERO_SRC/libero"
__path__ = [_real_package]
_real_init = os.path.join(_real_package, "__init__.py")
with open(_real_init, "rb") as _fh:
    exec(compile(_fh.read(), _real_init, "exec"), globals(), globals())
PY
export LIBERO_CONFIG_PATH="$LIBERO_CONFIG"
export PYTHONPATH="$LIBERO_COMPAT:$LIBERO_SRC:$SRC:$SRC/experiments/libero:${PYTHONPATH:-}"
export GIT_PYTHON_REFRESH=quiet
cd "$SRC"
"$VENV/bin/python" - <<'PY'
import bddl
from future.utils import with_metaclass
import experiments.libero.eval_libero_single as eval_single
print("dependency_repair=ok")
print("eval_entry_import=ok")
PY
"$VENV/bin/python" -m pip check | tee "$ARTIFACTS/pip-check.txt"
touch "$ARTIFACTS/SUCCESS"
date
