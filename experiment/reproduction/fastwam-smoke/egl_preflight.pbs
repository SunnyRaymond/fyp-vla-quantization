#!/bin/bash
#PBS -N fw_egl_preflight
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=2:mem=8gb:ngpus=1
#PBS -l walltime=00:05:00
#PBS -j oe

set -eo pipefail

echo 'Disabled: global EGL device probing is not permitted. Use osmesa_preflight.pbs.' >&2
exit 64

case "${PBS_JOBID:-}" in
  '') echo 'Refusing EGL preflight: PBS_JOBID is missing.' >&2; exit 64 ;;
esac
case "$(hostname -s)" in
  *login*|asp2a-login*) echo 'Refusing EGL preflight: login node is not a compute allocation.' >&2; exit 64 ;;
esac

ROOT=/scratch/users/ntu/yguo017/fastwam-smoke
VENV="$ROOT/venv"
ARTIFACTS="$ROOT/artifacts/$PBS_JOBID"
mkdir -p "$ARTIFACTS"
cp "$ROOT/egl_preflight.pbs" "$ARTIFACTS/"
exec > >(tee -a "$ARTIFACTS/job.log") 2>&1

module purge
module load gcc/11.4.0-nscc python/3.11.7-gcc11 apptainer/1.5.0 cuda/12.2.2
export PYTHONUNBUFFERED=1
export GIT_PYTHON_REFRESH=quiet
export MUJOCO_GL=egl
export PYOPENGL_PLATFORM=egl
source "$ROOT/resolve_egl_device.sh"

date
hostname
nvidia-smi --query-gpu=index,uuid,name --format=csv,noheader > "$ARTIFACTS/gpu-list-before-remap.txt"
cat "$ARTIFACTS/gpu-list-before-remap.txt"
resolve_egl_device > "$ARTIFACTS/egl-device-map.txt" 2>&1
cat "$ARTIFACTS/egl-device-map.txt"
prepare_robosuite_uuid_patch > "$ARTIFACTS/robosuite-compat.txt"
cat "$ARTIFACTS/robosuite-compat.txt"
nvidia-smi --query-gpu=index,uuid,name --format=csv,noheader > "$ARTIFACTS/gpu-list-after-remap.txt"
cat "$ARTIFACTS/gpu-list-after-remap.txt"
test -x "$VENV/bin/python"

"$VENV/bin/python" - <<'PY' | tee "$ARTIFACTS/render-result.txt"
import numpy as np
import mujoco
from robosuite.renderers.context.egl_context import EGLGLContext

xml = """
<mujoco><worldbody><body name="box" pos="0 0 0"><geom type="box" size="0.05 0.05 0.05"/></body></worldbody></mujoco>
"""
model = mujoco.MjModel.from_xml_string(xml)
data = mujoco.MjData(model)
ctx = EGLGLContext(64, 64, device_id=0)
ctx.make_current()
renderer = mujoco.Renderer(model, height=64, width=64)
renderer.update_scene(data)
image = renderer.render()
assert image.shape == (64, 64, 3), image.shape
print("egl_context=ok")
print("render_shape", image.shape)
print("render_checksum", int(np.asarray(image, dtype=np.uint64).sum()))
renderer.close()
ctx.free()
PY
touch "$ARTIFACTS/SUCCESS"
date
