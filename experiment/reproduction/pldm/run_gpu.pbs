#!/bin/bash
#PBS -N pldm_tworoom_train_eval
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=16:mem=110gb:ngpus=1
#PBS -l walltime=04:00:00
#PBS -j oe

set -euo pipefail
ROOT=/scratch/users/ntu/yguo017/pldm-reproduction
JOB_ID=${PBS_JOBID:-}
NODEFILE=${PBS_NODEFILE:-}
HOST=$(hostname -s | tr '[:upper:]' '[:lower:]')
test -n "$JOB_ID" || { echo 'Refusing to run without PBS_JOBID' >&2; exit 64; }
test -n "$NODEFILE" && test -f "$NODEFILE" || { echo 'Refusing to run without PBS_NODEFILE' >&2; exit 64; }
case "$HOST" in
  *login*|*head*|*submit*) echo "Refusing probable login host: $HOST" >&2; exit 64 ;;
esac
if ! awk -v host="$HOST" '{ node=tolower($1); sub(/\..*/, "", node); if (node == host) found=1 } END { exit !found }' "$NODEFILE"; then
  echo "Current host $HOST is not listed in PBS_NODEFILE" >&2
  exit 64
fi

OUT="$ROOT/reports/$JOB_ID"
mkdir -p "$OUT"
CALIBRATION_REPORT="$ROOT/reports/calibration-25572720.pbs101/CALIBRATION.json"
CALIBRATION_LOG="$ROOT/reports/calibration-25572720.pbs101/job.log"
test -s "$CALIBRATION_REPORT" || { echo 'Required passing calibration report is missing' >&2; exit 65; }
test -s "$ROOT/RESOURCE_AMENDMENT.zh.md" && test -s "$ROOT/SUBMISSION.json" && test -s "$ROOT/collect_native_result.py"
cp "$ROOT/run_gpu.pbs" "$ROOT/FREEZE.json" "$ROOT/PROTOCOL.zh.md" "$ROOT/RESOURCE_AMENDMENT.zh.md" "$ROOT/SUBMISSION.json" "$ROOT/PREPARATION.json" "$ROOT/upstream/source_identity.json" "$ROOT/staged_source_identity.json" "$ROOT/collect_native_result.py" "$OUT/"
cp "$CALIBRATION_REPORT" "$OUT/CALIBRATION.25572720.json"
cp "$CALIBRATION_LOG" "$OUT/calibration-job.log"
exec > >(tee -a "$OUT/job.log" "$ROOT/logs/gpu-$JOB_ID.log") 2>&1
GPU_SAMPLER_PID=
finish() {
  rc=$?
  if [ -n "${GPU_SAMPLER_PID:-}" ]; then
    kill "$GPU_SAMPLER_PID" 2>/dev/null || true
    wait "$GPU_SAMPLER_PID" 2>/dev/null || true
  fi
  printf 'job_id=%s\nprocess_exit_code=%s\nfinished_utc=%s\nhost=%s\n' "$JOB_ID" "$rc" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$HOST" > "$OUT/runner_status.txt.tmp-$JOB_ID"
  mv "$OUT/runner_status.txt.tmp-$JOB_ID" "$OUT/runner_status.txt"
}
trap finish EXIT

module purge
module load gcc/11.4.0-nscc python/3.11.7-gcc11
export PYTHONUNBUFFERED=1 OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
export WANDB_MODE=disabled MPLBACKEND=Agg
export PLDM_PYTHON=/scratch/users/ntu/yguo017/lewm-pusht-iteration/venv/bin/python
EXTRA_DEP_PATHS=$("$PLDM_PYTHON" - "$ROOT/PREPARATION.json" <<'PY'
import json, sys
prep = json.load(open(sys.argv[1], encoding="utf-8"))
print(":".join(record["overlay"] for record in prep.get("observed_dependency_installs", [])))
PY
)
export PYTHONPATH="$ROOT/staged${EXTRA_DEP_PATHS:+:$EXTRA_DEP_PATHS}:$ROOT/runtime_overlay/numpy-1.26.4-scipy-1.10.0-pinned:$ROOT/runtime_overlay/pandas-2.0.1-pinned:$ROOT/runtime_overlay/statsmodels-patsy-pinned:$ROOT/runtime_overlay/pytorch-seed-0.2.0:$ROOT/runtime_overlay/arm-pytorch-utilities-0.4.3:$ROOT/runtime_overlay/numpy-1.26.4:$ROOT/runtime_overlay/zarr-2.14.2-pinned:$ROOT/runtime_overlay/gdown:$ROOT/runtime_overlay/html-parser:/scratch/users/ntu/yguo017/experiment/reproduction/lpwm/runtime-overlay-minimal"
export PLDM_ROOT="$ROOT"

python - "$ROOT/PREPARATION.json" "$ROOT/upstream/source_identity.json" "$ROOT/staged_source_identity.json" "$CALIBRATION_REPORT" <<'PY'
import importlib, importlib.metadata as metadata, json, sys
prep=json.load(open(sys.argv[1], encoding='utf-8'))
identity=json.load(open(sys.argv[2], encoding='utf-8'))
staged=json.load(open(sys.argv[3], encoding='utf-8'))
calibration=json.load(open(sys.argv[4], encoding='utf-8'))
assert prep.get('status') == 'PASS', f"CPU preparation is not PASS: {prep.get('status')}"
assert identity.get('source_sha') == '1bd7e564ecd961205bc18b23067b19e9ca24ac90'
assert staged.get('source_sha') == identity.get('source_sha')
assert staged.get('algorithm_or_config_changes') == []
assert prep.get('stages',{}).get('config_composition',{}).get('status') == 'PASS'
loader=prep.get('actual_training_loader',{})
assert loader.get('status') == 'PASS' and loader.get('actual_passes') == 3 and loader.get('expected_optimizer_updates',0) > 0
probing=prep.get('actual_probing_loader',{})
assert probing.get('status') == 'PASS' and probing.get('total_training_passes') == 50
print('CPU_PREPARATION gate=PASS; pinned and staged source SHA gates=PASS')
assert calibration.get('status') == 'PASS' and calibration.get('training_status') == 'PASS'
assert calibration.get('job_id') == '25572720.pbs101'
assert calibration.get('source_sha') == identity.get('source_sha')
assert calibration.get('released_frame_count') == 3686400
config=calibration.get('config',{})
assert config.get('seed') == 101 and config.get('epochs') == 2
assert config.get('lazy_load') is False and config.get('offline_dataset_device') == 'cuda'
gate=calibration.get('storage_equivalence_gate',{})
expected={'states','locations','actions','bias_angle','wall_x','door_y'}
assert gate.get('status') == 'PASS' and gate.get('sample_count') == 64
assert set(gate.get('raw_field_equal',{})) == expected and all(gate['raw_field_equal'].values())
assert set(gate.get('normalized_field_equal',{})) == expected and all(gate['normalized_field_equal'].values())
assert gate.get('rng_states_unchanged') is True
timing=calibration.get('timing',{})
assert timing.get('actual_epoch_indices') == [0,1,2]
assert timing.get('expected_official_optimizer_updates') == 144000
assert timing.get('calibration_updates_completed') == 110 and timing.get('timed_updates_completed') == 100
planner=calibration.get('planner_cost_probe',{})
assert planner.get('status') == 'PASS' and planner.get('steady_call_count') == 3
assert planner.get('model_mode_matches_native_validate') is True
assert all(all(call.get('finite',{}).values()) for call in planner.get('calls',[]))
print('COST_CALIBRATION gate=PASS; eager/mmap six-field equality, 110 updates and planner proxy verified')
PY
DATASET="$ROOT/datasets/good_quality_data_memmap"
test -s "$DATASET/states.npy" && test -s "$DATASET/actions.npy" && test -s "$DATASET/locations.npy" && test -s "$DATASET/render_metadata.json"
test -x "$PLDM_PYTHON"
test ! -e "$ROOT/checkpoints/tworooms-seqlen90-3M-seed101"

printf 'job_id=%s\nhost=%s\nnodefile=%s\nsource_sha=1bd7e564ecd961205bc18b23067b19e9ca24ac90\ntraining_seed=101\nevaluation_seed=42\n' "$JOB_ID" "$HOST" "$NODEFILE"
date -u +%Y-%m-%dT%H:%M:%SZ
nvidia-smi --query-gpu=index,uuid,name,timestamp,utilization.gpu,memory.used,memory.total --format=csv,noheader,nounits
"$PLDM_PYTHON" - <<'PY'
import csv, io, json, os, subprocess, torch
if not torch.cuda.is_available() or torch.cuda.device_count() < 1:
    raise SystemExit("GPU identity gate failed: no CUDA device visible to PyTorch")
visible = os.environ.get("CUDA_VISIBLE_DEVICES", "")
rows = list(csv.reader(io.StringIO(subprocess.check_output(["nvidia-smi", "--query-gpu=index,uuid,name", "--format=csv,noheader"], text=True))))
devices = [{"index": row[0].strip(), "uuid": row[1].strip(), "name": row[2].strip()} for row in rows if len(row) >= 3]
if not devices:
    raise SystemExit("GPU identity gate failed: NVML returned no GPU rows")
token = visible.split(",", 1)[0].strip() if visible else ""
selected = next((d for d in devices if token and token in (d["index"], d["uuid"])), devices[0] if not token else None)
if selected is None:
    raise SystemExit(f"GPU identity gate failed: first CUDA_VISIBLE_DEVICES token {token!r} has no NVML index/UUID match: {devices}")
torch_name = torch.cuda.get_device_properties(0).name.strip()
if torch_name != selected["name"]:
    raise SystemExit(f"GPU identity gate failed: torch cuda:0 name={torch_name!r} does not match selected NVML device={selected}")
print("GPU_IDENTITY_GATE=" + json.dumps({"CUDA_VISIBLE_DEVICES": visible or "<unset>", "torch_logical_device": "cuda:0", "torch_device_name": torch_name, "nvml_device": selected}, sort_keys=True), flush=True)
PY
nvidia-smi --query-gpu=index,uuid,name,timestamp,utilization.gpu,memory.used,memory.total --format=csv,noheader,nounits --loop=5 >> "$OUT/job.log" 2>&1 &
GPU_SAMPLER_PID=$!

cd "$ROOT/staged/pldm"
"$PLDM_PYTHON" - <<'PY'
from pathlib import Path
import importlib.metadata as metadata
import pldm.train, pldm.evaluation.evaluator
import pldm_envs.wall.data.offline_wall
import gym, gym_notices
import arm_pytorch_utilities
import pytorch_seed
import statsmodels, statsmodels.api, patsy
import numpy, scipy
import pandas
import pytz
import importlib, json
prep=json.load(open("/scratch/users/ntu/yguo017/pldm-reproduction/PREPARATION.json", encoding="utf-8"))
assert metadata.version("gym") == "0.23.1"
assert metadata.version("gym-notices") == "0.0.8"
assert metadata.version("arm_pytorch_utilities") == "0.4.3"
assert metadata.version("pytorch-seed") == "0.2.0"
assert metadata.version("statsmodels") == "0.14.4"
assert metadata.version("patsy") == "1.0.1"
assert numpy.__version__ == "1.26.4"
assert scipy.__version__ == "1.10.0"
assert pandas.__version__ == "2.0.1"
assert metadata.version("pytz") == "2022.7.1"
root=Path("/scratch/users/ntu/yguo017/pldm-reproduction/staged").resolve()
for module in (pldm.train, pldm.evaluation.evaluator, pldm_envs.wall.data.offline_wall):
    path=Path(module.__file__).resolve()
    assert path.is_relative_to(root), f"Import escaped staged source: {path}"
    print(f"import_source={path}")
gym_overlay=Path("/scratch/users/ntu/yguo017/experiment/reproduction/lpwm/runtime-overlay-minimal").resolve()
for module in (gym, gym_notices):
    path=Path(module.__file__).resolve()
    assert path.is_relative_to(gym_overlay), f"gym dependency escaped the pinned read-only overlay: {path}"
    print(f"gym_import_source={path}")
arm_overlay=Path("/scratch/users/ntu/yguo017/pldm-reproduction/runtime_overlay/arm-pytorch-utilities-0.4.3").resolve()
arm_path=Path(arm_pytorch_utilities.__file__).resolve()
assert arm_path.is_relative_to(arm_overlay), f"arm_pytorch_utilities escaped its pinned overlay: {arm_path}"
print(f"arm_import_source={arm_path}")
seed_overlay=Path("/scratch/users/ntu/yguo017/pldm-reproduction/runtime_overlay/pytorch-seed-0.2.0").resolve()
seed_path=Path(pytorch_seed.__file__).resolve()
assert seed_path.is_relative_to(seed_overlay), f"pytorch_seed escaped its pinned overlay: {seed_path}"
print(f"pytorch_seed_import_source={seed_path}")
statsmodels_overlay=Path("/scratch/users/ntu/yguo017/pldm-reproduction/runtime_overlay/statsmodels-patsy-pinned").resolve()
for module in (statsmodels, statsmodels.api, patsy):
    path=Path(module.__file__).resolve()
    assert path.is_relative_to(statsmodels_overlay), f"statsmodels dependency escaped its pinned overlay: {path}"
    print(f"statsmodels_import_source={path}")
scientific_overlay=Path("/scratch/users/ntu/yguo017/pldm-reproduction/runtime_overlay/numpy-1.26.4-scipy-1.10.0-pinned").resolve()
for module in (numpy, scipy):
    path=Path(module.__file__).resolve()
    assert path.is_relative_to(scientific_overlay), f"scientific dependency escaped its pinned overlay: {path}"
    print(f"scientific_import_source={path}")
pandas_overlay=Path("/scratch/users/ntu/yguo017/pldm-reproduction/runtime_overlay/pandas-2.0.1-pinned").resolve()
pandas_path=Path(pandas.__file__).resolve()
assert pandas_path.is_relative_to(pandas_overlay), f"pandas escaped its pinned overlay: {pandas_path}"
print(f"pandas_import_source={pandas_path}")
pytz_path=Path(pytz.__file__).resolve()
assert pytz_path.is_relative_to(pandas_overlay), f"pytz escaped its pinned overlay: {pytz_path}"
print(f"pytz_import_source={pytz_path}")
for record in prep.get('observed_dependency_installs', []):
    module=importlib.import_module(record['trigger_module_not_found'])
    origin=Path(module.__file__).resolve()
    overlay=Path(record['overlay']).resolve()
    assert metadata.version(record['distribution']) == record['version'], f"Observed dependency version mismatch: {record}"
    assert origin.is_relative_to(overlay), f"Observed dependency import escaped its isolated overlay: {origin}"
    print(f"observed_dependency_import_source={origin}")
print(f"runtime_gym={metadata.version('gym')} gym_notices={metadata.version('gym-notices')} arm_pytorch_utilities={metadata.version('arm_pytorch_utilities')} pytorch_seed={metadata.version('pytorch-seed')} statsmodels={metadata.version('statsmodels')} patsy={metadata.version('patsy')}")
PY
set +e
timeout --signal=INT --kill-after=30s 230m "$PLDM_PYTHON" "$ROOT/staged/pldm/train.py" --configs configs/wall/icml/seqlen90_3M.yaml --values \
  output_root="$ROOT/checkpoints" \
  output_dir=tworooms-seqlen90-3M-seed101 \
  run_name=tworooms-seqlen90-3M-seed101 \
  data.offline_wall_config.offline_data_path="$DATASET" \
  data.offline_wall_config.lazy_load=false \
  resume_if_possible=false eval_at_beginning=false eval_during_training=false \
  seed=101 wandb=false
rc=$?
set -e
printf 'training_and_native_eval_exit_code=%s\n' "$rc"
exit "$rc"
