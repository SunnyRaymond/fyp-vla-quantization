#!/bin/bash
#PBS -N pldm_cpu_prep
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=4:mem=24gb
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail
ROOT=/scratch/users/ntu/yguo017/pldm-reproduction
JOB_ID=${PBS_JOBID:-}
NODEFILE=${PBS_NODEFILE:-}
HOST=$(hostname -s | tr '[:upper:]' '[:lower:]')

test -n "$JOB_ID" || { echo 'Refusing to run without PBS_JOBID' >&2; exit 64; }
test -n "$NODEFILE" && test -f "$NODEFILE" || { echo 'Refusing to run without PBS_NODEFILE' >&2; exit 64; }
case "$HOST" in
  *login*|*head*|*submit*) echo "Refusing probable login host: $HOST" >&2; exit 64 ;;
esac
if ! awk -v host="$HOST" '{ node=tolower($1); sub(/\..*/, "", node); if (node == host) found=1 } END { exit !found }' "$NODEFILE"; then
  echo "Current host $HOST is not listed in PBS_NODEFILE" >&2
  exit 64
fi

OUT="$ROOT/reports/$JOB_ID"
mkdir -p "$OUT"
cp "$ROOT/prepare_cpu.py" "$ROOT/render_wall_memmap.py" "$ROOT/FREEZE.json" "$ROOT/PROTOCOL.zh.md" "$OUT/"
exec > >(tee -a "$ROOT/logs/cpu-$JOB_ID.log") 2>&1
trap 'rc=$?; printf "job_id=%s\nexit_code=%s\nfinished_utc=%s\nhost=%s\n" "$JOB_ID" "$rc" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$HOST" > "$OUT/job_status.txt.tmp-$JOB_ID"; mv "$OUT/job_status.txt.tmp-$JOB_ID" "$OUT/job_status.txt"' EXIT

module purge
module load gcc/11.4.0-nscc python/3.11.7-gcc11
export PYTHONUNBUFFERED=1 OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
export PLDM_ROOT="$ROOT"
export PLDM_PYTHON=/scratch/users/ntu/yguo017/lewm-pusht-iteration/venv/bin/python

printf 'job_id=%s\nhost=%s\nnodefile=%s\nroot=%s\n' "$JOB_ID" "$HOST" "$NODEFILE" "$ROOT"
date -u +%Y-%m-%dT%H:%M:%SZ
module list 2>&1
python -m py_compile "$ROOT/prepare_cpu.py" "$ROOT/render_wall_memmap.py"
python -c 'import json,sys; json.load(open(sys.argv[1],encoding="utf-8")); print("FREEZE.json parse=PASS")' "$ROOT/FREEZE.json"

set +e
timeout --signal=TERM --kill-after=15s 110m python "$ROOT/prepare_cpu.py"
rc=$?
set -e
printf 'preparation_exit_code=%s\n' "$rc"
exit "$rc"
