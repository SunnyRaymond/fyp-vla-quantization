#!/bin/bash
#PBS -N dino_wall_download
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=4:mem=20gb
#PBS -l walltime=01:00:00
#PBS -j oe
set -euo pipefail
ROOT=/scratch/users/ntu/yguo017/dino-wm-wall
WORK=${TMPDIR:-/tmp}/dino-wall-assets-$PBS_JOBID
mkdir -p "$WORK" "$ROOT/artifacts/$PBS_JOBID" "$ROOT/downloads" "$ROOT/data" "$ROOT/checkpoints"
exec > >(tee -a "$ROOT/artifacts/$PBS_JOBID/job.log") 2>&1
module purge
module load gcc/11.4.0-nscc python/3.11.7-gcc11
export UV_CACHE_DIR="$WORK/uv-cache" OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
export TORCH_HOME="$WORK/runtime/torch" MPLBACKEND=Agg PYTHONUNBUFFERED=1
tar -xf "$ROOT/runtime.tar" -C "$WORK"
if [[ $(stat -c %s "$ROOT/downloads/outputs-local.zip" 2>/dev/null || echo 0) != 953204628 ]]; then
  curl -fL --retry 2 --max-time 1500 -C - https://osf.io/download/xvzs4/ -o "$ROOT/downloads/outputs-local.zip"
fi
if [[ $(stat -c %s "$ROOT/downloads/wall_single-local.zip" 2>/dev/null || echo 0) != 1668205895 ]]; then
  curl -fL --retry 2 --max-time 1500 -C - https://osf.io/download/49rnx/ -o "$ROOT/downloads/wall_single-local.zip"
fi
"$WORK/runtime/venv/bin/python" - <<'PY'
from pathlib import Path
import zipfile
root=Path('/scratch/users/ntu/yguo017/dino-wm-wall')
for archive,dest,expected in [('outputs-local.zip','checkpoints',953204628),('wall_single-local.zip','data',1668205895)]:
    path=root/'downloads'/archive
    assert path.stat().st_size==expected,(path,path.stat().st_size)
    with zipfile.ZipFile(path) as z:
        members=[i for i in z.infolist() if not i.filename.startswith('__MACOSX/')]
        if archive.startswith('outputs'):
            members=[i for i in members if '/wall_single/' in '/'+i.filename or i.filename.rstrip('/') in ('outputs','outputs/wall_single')]
        print(archive,len(members),sum(i.file_size for i in members),flush=True)
        for i in members:
            assert (root/dest/i.filename).resolve().is_relative_to((root/dest).resolve())
            if not (target := root/dest/i.filename).is_file() or target.stat().st_size != i.file_size:
                z.extract(i,root/dest)
PY
touch "$ROOT/PREPARED"
"$WORK/runtime/venv/bin/python" "$ROOT/control/validate_assets.py"
tar -cf "$ROOT/runtime-complete.tar.partial" -C "$WORK" runtime
mv "$ROOT/runtime-complete.tar.partial" "$ROOT/runtime-complete.tar"
touch "$ROOT/ASSETS_READY"
