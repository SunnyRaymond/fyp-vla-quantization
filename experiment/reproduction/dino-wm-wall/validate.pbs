#!/bin/bash
#PBS -N dino_wall_assets
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=4:mem=20gb
#PBS -l walltime=00:30:00
#PBS -j oe
set -euo pipefail
ROOT=/scratch/users/ntu/yguo017/dino-wm-wall
mkdir -p "$ROOT/artifacts/$PBS_JOBID"
exec > >(tee -a "$ROOT/artifacts/$PBS_JOBID/job.log") 2>&1
test -f "$ROOT/PREPARED"
export PYTHONUNBUFFERED=1 OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
export TORCH_HOME="$ROOT/cache/torch" MPLBACKEND=Agg
"$ROOT/venv/bin/python" "$ROOT/control/validate_assets.py"
