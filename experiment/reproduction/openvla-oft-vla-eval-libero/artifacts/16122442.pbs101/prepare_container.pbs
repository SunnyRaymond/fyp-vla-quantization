#!/bin/bash
#PBS -N oft_libero_image
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=4:mem=32gb
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail

ROOT=/scratch/users/ntu/yguo017/openvla-oft-vla-eval-libero
ARCHIVE="$ROOT/control/libero-d0c45bc5a372.oci.tar"
PARTS="$ROOT/control/libero-d0c45bc5a372.parts"
SIF="$ROOT/containers/libero-latest.sif"
ARTIFACTS="$ROOT/artifacts/$PBS_JOBID"
JOB_TMP="${TMPDIR:-/tmp}/oft-libero-image-$PBS_JOBID"

mkdir -p "$ROOT/containers" "$ARTIFACTS" "$JOB_TMP"
cp "$PBS_O_WORKDIR/prepare_container.pbs" "$ARTIFACTS/"
exec > >(tee -a "$ARTIFACTS/job.log") 2>&1

module purge
module load apptainer/1.5.0

export APPTAINER_TMPDIR="$JOB_TMP"

if [[ -f "$ARCHIVE" && "$(stat -c%s "$ARCHIVE")" == 2743703552 ]]; then
  BUILD_ARCHIVE="$ARCHIVE"
else
  cat "$PARTS"/part-{00..03} > "$JOB_TMP/libero.oci.tar"
  test "$(stat -c%s "$JOB_TMP/libero.oci.tar")" == 2743703552
  BUILD_ARCHIVE="$JOB_TMP/libero.oci.tar"
fi

apptainer build "$JOB_TMP/libero.sif" "oci-archive://$BUILD_ARCHIVE"
mv "$JOB_TMP/libero.sif" "$SIF"
apptainer inspect "$SIF" > "$ARTIFACTS/container-inspect.txt"
find "$ARTIFACTS" -type f -printf '%P\t%s bytes\n' | sort > "$ARTIFACTS/manifest.tsv"
touch "$ARTIFACTS/SUCCESS"
