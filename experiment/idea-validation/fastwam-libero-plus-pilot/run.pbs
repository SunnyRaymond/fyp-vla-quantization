#!/bin/bash
#PBS -N fw_plus_pilot
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=16:mem=110gb:ngpus=1
#PBS -l walltime=02:00:00
#PBS -j oe
set -euo pipefail

test -n "${PBS_JOBID:-}" || { echo 'PBS_JOBID required' >&2; exit 64; }
case "$(hostname -s)" in *login*) echo 'Refusing to run on a login node' >&2; exit 64;; esac
test -s "${PBS_NODEFILE:-}" || { echo 'PBS_NODEFILE required' >&2; exit 64; }
grep -Fqx "$(hostname -s)" <(awk -F. '{print $1}' "$PBS_NODEFILE") || {
  echo 'Current host is not in the approved PBS allocation' >&2; exit 64;
}

ROOT=/scratch/users/ntu/yguo017/fastwam-libero-plus-pilot-20261005
BASE=/scratch/users/ntu/yguo017/fastwam-smoke
SIF=/scratch/users/ntu/yguo017/openvla-oft-vla-eval-libero/containers/libero-latest.sif
ARTIFACTS="$ROOT/artifacts/$PBS_JOBID"
mkdir -p "$ARTIFACTS"
exec > >(tee -a "$ARTIFACTS/job.log") 2>&1

finish() {
  rc=$?
  if [[ -n "${GPU_MONITOR_PID:-}" ]]; then
    kill "$GPU_MONITOR_PID" 2>/dev/null || true
    wait "$GPU_MONITOR_PID" 2>/dev/null || true
  fi
  printf '%s\n' "$rc" > "$ARTIFACTS/exit_code.txt"
  if [[ $rc -eq 0 ]]; then touch "$ARTIFACTS/PIPELINE_COMPLETE"; fi
}
trap finish EXIT

module purge
module load gcc/11.4.0-nscc python/3.11.7-gcc11 apptainer/1.5.0 cuda/12.2.2
test -n "${CUDA_VISIBLE_DEVICES:-}" || { echo 'CUDA_VISIBLE_DEVICES missing' >&2; exit 65; }
test -s "$SIF" -a -s "$ROOT/env_status.json" -a -s "$ROOT/manifest.json"
test -s "$ROOT/runner.py" -a -s "$ROOT/quantization.py" -a -s "$ROOT/libero_state_loader.py"
qstat -f "$PBS_JOBID" > "$ARTIFACTS/allocation.txt"

FW_MODE=${FW_MODE:-shard}
case "$FW_MODE" in preflight|performance|shard) ;; *) echo "Unknown FW_MODE=$FW_MODE" >&2; exit 64;; esac
FW_SLOTS=${FW_SLOTS:-}
[[ -z "$FW_SLOTS" || "$FW_MODE" == shard ]] || { echo 'FW_SLOTS is only valid for shard retries' >&2; exit 64; }
FW_OUT="$ARTIFACTS"

mapfile -t ENV_PATHS < <(python3 - "$ROOT/env_status.json" <<'PY'
import json, sys
from pathlib import Path
d=json.loads(Path(sys.argv[1]).read_text())
if d.get('checks', {}).get('render_preflight_ready') is not True:
    raise SystemExit('Actual seven-dimension LIBERO-Plus rendering preflight is not ready')
p=d.get('paths', d)
native=json.loads(Path(p['native_setup_receipt']).read_text())
if native.get('ready') is not True: raise SystemExit('Native ImageMagick setup is not ready')
aliases=(('plus_repo','libero_plus','libero_plus_root','plus_root'), ('dependency_target','deps','dependencies','dependency_dir'), ('libero_config_path','libero_config','config_dir'), ('libero_compat',), ('native_root',), ('native_library_dir',), ('magick_home',), ('magick_configure_path',), ('magick_coder_module_path',), ('magick_filter_module_path',), ('native_setup_receipt',))
for names in aliases:
    value=next((p.get(k) for k in names if p.get(k)), None)
    if not value:
        raise SystemExit(f'env_status.json lacks one of {names}')
    if names[0] in ('magick_configure_path', 'magick_filter_module_path'):
        print(value)
        continue
    path=Path(value)
    if not path.is_absolute(): path=Path('/scratch/users/ntu/yguo017/fastwam-libero-plus-pilot-20261005')/path
    if not path.exists(): raise SystemExit(f'Configured environment path is unavailable: {path}')
    print(path)
PY
)
test "${#ENV_PATHS[@]}" -eq 11 || { echo 'Could not resolve LIBERO-Plus environment paths' >&2; exit 65; }
PLUS_ROOT=${ENV_PATHS[0]}
DEPS=${ENV_PATHS[1]}
LIBERO_CONFIG=${ENV_PATHS[2]}
COMPAT=${ENV_PATHS[3]}
NATIVE_ROOT=${ENV_PATHS[4]}
NATIVE_LIBDIR=${ENV_PATHS[5]}
MAGICK_HOME=${ENV_PATHS[6]}
MAGICK_CONFIGURE_PATH=${ENV_PATHS[7]}
MAGICK_CODER_MODULE_PATH=${ENV_PATHS[8]}
MAGICK_FILTER_MODULE_PATH=${ENV_PATHS[9]}
NATIVE_RECEIPT=${ENV_PATHS[10]}
export LD_LIBRARY_PATH="$NATIVE_LIBDIR:$NATIVE_ROOT/usr/lib:/usr/lib/x86_64-linux-gnu:/.singularity.d/libs:${LD_LIBRARY_PATH:-}"
test -d "$PLUS_ROOT" -a -d "$DEPS" -a -d "$LIBERO_CONFIG" -a -d "$COMPAT"
test -d "$BASE/FastWAM" -a -d "$BASE/checkpoints"

cp "$ROOT/run.pbs" "$ROOT/runner.py" "$ROOT/manifest.json" "$ROOT/env_status.json" \
   "$ROOT/quantization.py" "$ROOT/libero_state_loader.py" "$ARTIFACTS/"
cp "$NATIVE_RECEIPT" "$ARTIFACTS/native_status.json"
if [[ -s "$ROOT/real_quant_kernel.py" ]]; then cp "$ROOT/real_quant_kernel.py" "$ARTIFACTS/"; fi
printf 'mode=%s\nPBS_JOBID=%s\nPBS_ARRAY_INDEX=%s\nCUDA_VISIBLE_DEVICES=%s\n' \
  "$FW_MODE" "$PBS_JOBID" "${PBS_ARRAY_INDEX:-}" "$CUDA_VISIBLE_DEVICES" | tee -a "$ARTIFACTS/launch.txt"

export FW_REQUIRE_REAL_QUANT=1
run_python() {
  apptainer exec --cleanenv --nv \
    --bind /scratch,/scratch/GPFS/app/apps:/app/apps \
    --bind "$PBS_NODEFILE:$PBS_NODEFILE:ro" \
    --bind /usr/lib64/libffi.so.6:/usr/lib/x86_64-linux-gnu/libffi.so.6 \
    --bind /usr/lib64/libssl.so.1.1:/usr/lib/x86_64-linux-gnu/libssl.so.1.1 \
    --bind /usr/lib64/libcrypto.so.1.1:/usr/lib/x86_64-linux-gnu/libcrypto.so.1.1 \
    --env "LD_LIBRARY_PATH=$LD_LIBRARY_PATH" \
    --env "MAGICK_HOME=$MAGICK_HOME,MAGICK_CONFIGURE_PATH=$MAGICK_CONFIGURE_PATH,MAGICK_CODER_MODULE_PATH=$MAGICK_CODER_MODULE_PATH,MAGICK_FILTER_MODULE_PATH=$MAGICK_FILTER_MODULE_PATH" \
    --env "CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES" \
    --env "PBS_JOBID=$PBS_JOBID,PBS_NODEFILE=$PBS_NODEFILE,ARTIFACTS=$ARTIFACTS,ROOT=$ROOT" \
    --env "PYTHONPATH=$ARTIFACTS:$COMPAT:$PLUS_ROOT:$DEPS:$BASE/FastWAM:$BASE/FastWAM/src:$BASE/FastWAM/experiments/libero:$ROOT" \
    --env "LIBERO_CONFIG_PATH=$LIBERO_CONFIG" \
    --env "DIFFSYNTH_MODEL_BASE_PATH=$BASE/model-cache" \
    --env DIFFSYNTH_DOWNLOAD_SOURCE=huggingface,DIFFSYNTH_SKIP_DOWNLOAD=true,HF_HUB_OFFLINE=1 \
    --env "HF_HOME=$BASE/cache/huggingface" \
    --env MUJOCO_GL=osmesa,PYOPENGL_PLATFORM=osmesa,LIBGL_ALWAYS_SOFTWARE=1 \
    --env OMP_NUM_THREADS=8,OPENBLAS_NUM_THREADS=8,LP_NUM_THREADS=8 \
    --env GIT_PYTHON_REFRESH=quiet,PYTHONUNBUFFERED=1,TOKENIZERS_PARALLELISM=false \
    --env FW_REQUIRE_REAL_QUANT=1 \
    "$SIF" "$BASE/venv/bin/python" "$@"
}

run_python - "$CUDA_VISIBLE_DEVICES" <<'PY'
import os, sys, torch
mask=sys.argv[1]
assert mask.startswith('GPU-') and ',' not in mask, mask
assert torch.cuda.device_count()==1, torch.cuda.device_count()
props=torch.cuda.get_device_properties(0)
cap=torch.cuda.get_device_capability(0)
if cap[0] < 8: raise SystemExit(f'native INT4 Tensor Core requires SM80+, got SM{cap[0]}{cap[1]}')
actual=str(props.uuid)
assert actual.removeprefix('GPU-').lower()==mask.removeprefix('GPU-').lower(), (mask,actual)
print('Allocated GPU verified:', props.name, actual, f'SM{cap[0]}{cap[1]}', flush=True)
PY

(
  while :; do
    printf 'GPU_SAMPLE timestamp=%s ' "$(date -Is)"
    nvidia-smi -i "$CUDA_VISIBLE_DEVICES" --query-gpu=uuid,name,utilization.gpu,memory.used,memory.total --format=csv,noheader || echo GPU_SAMPLE_ERROR
    sleep 15
  done
) &
GPU_MONITOR_PID=$!

START=${FW_START:-}
STOP=${FW_STOP:-}
if [[ -n "$FW_SLOTS" ]]; then
  test -s "$FW_SLOTS" || { echo 'Assigned retry slots file is missing' >&2; exit 64; }
  cp -- "$FW_SLOTS" "$ARTIFACTS/assigned_slots.json"
  START=0; STOP=1400
elif [[ "$FW_MODE" == shard ]]; then
  if [[ -z "$START" && -z "$STOP" ]]; then
    ARRAY_INDEX=${PBS_ARRAY_INDEX:-${PBS_ARRAYID:-}}
    if [[ -z "$ARRAY_INDEX" && "$PBS_JOBID" =~ \[([0-9]+)\] ]]; then ARRAY_INDEX=${BASH_REMATCH[1]}; fi
    [[ "$ARRAY_INDEX" =~ ^[0-9]+$ ]] || { echo 'Set PBS_ARRAY_INDEX for shard mode' >&2; exit 64; }
    if [[ -n "${FW_RANGE_PLAN:-}" ]]; then
      test -s "$FW_RANGE_PLAN" || { echo 'Range plan file is missing' >&2; exit 64; }
      cp -- "$FW_RANGE_PLAN" "$ARTIFACTS/shard_ranges.json"
      RANGE=$(run_python - "$ARTIFACTS/shard_ranges.json" "$ARRAY_INDEX" <<'PY'
import json, sys
plan=json.load(open(sys.argv[1]))
assert plan['protocol']=='fastwam-optional-idm-plus-pilot-v1' and plan['variant_count']==1400
ranges=plan['ranges']; end=0
for entry in ranges:
    start,stop=entry['start'],entry['stop']
    assert type(start) is int and type(stop) is int and start==end and start<stop<=1400
    assert stop-start <= (1 if entry['dimension']=='sensor_noise' else 4)
    end=stop
assert end==1400
entry=ranges[int(sys.argv[2])]
print(entry['start'],entry['stop'])
PY
      )
      read -r START STOP <<< "$RANGE"
    else
      SHARD_SIZE=${FW_SHARD_SIZE:-4}
      [[ "$SHARD_SIZE" =~ ^[1-9][0-9]*$ ]] || { echo 'FW_SHARD_SIZE must be positive' >&2; exit 64; }
      START=$((ARRAY_INDEX * SHARD_SIZE))
      STOP=$((START + SHARD_SIZE))
      (( STOP > 1400 )) && STOP=1400
    fi
  elif [[ -z "$START" || -z "$STOP" ]]; then
    echo 'FW_START and FW_STOP must be supplied together' >&2; exit 64
  fi
else
  START=${START:-0}; STOP=${STOP:-4}
fi
[[ "$START" =~ ^[0-9]+$ && "$STOP" =~ ^[0-9]+$ ]] && (( START < STOP && STOP <= 1400 )) || {
  echo "Invalid manifest interval [$START,$STOP)" >&2; exit 64;
}
printf 'manifest_interval=[%s,%s)\n' "$START" "$STOP" | tee -a "$ARTIFACTS/launch.txt"

ARGS=("$ARTIFACTS/runner.py" --mode "$FW_MODE" --manifest "$ROOT/manifest.json" --out "$FW_OUT" --start "$START" --stop "$STOP")
[[ "$FW_MODE" == performance ]] && ARGS+=(--export-storage)
[[ -n "$FW_SLOTS" ]] && ARGS+=(--slots "$ARTIFACTS/assigned_slots.json")
set +e
run_python "${ARGS[@]}" 2>&1 | tee "$ARTIFACTS/runner.log"
runner_rc=${PIPESTATUS[0]}
set -e
(( runner_rc == 0 )) || exit "$runner_rc"

run_python - "$FW_MODE" "$ARTIFACTS" "$START" "$STOP" <<'PY'
import json, sys
from pathlib import Path
mode, root, start, stop=sys.argv[1],Path(sys.argv[2]),int(sys.argv[3]),int(sys.argv[4])
read=lambda p: json.loads(Path(p).read_text())
check=read(root/'self_check.json')
summary=read(root/'summary.json')
def evidence_ok(evidence, arm):
    if (not isinstance(evidence,dict) or evidence.get('real_quant') is not True
            or evidence.get('weight_state')!='w4' or evidence.get('bf16_target_weight_absent') is not True
            or not isinstance(evidence.get('packed_weight_tensor_bytes'),(int,float))
            or evidence['packed_weight_tensor_bytes']<=0):
        return False
    if arm=='w4a8':
        return (evidence.get('activation_bits')==8 and evidence.get('activation_storage')=='int8'
                and isinstance(evidence.get('integer_gemm_calls'),(int,float)) and evidence['integer_gemm_calls']>0)
    if arm in ('w4a4','w4a4kv4'):
        ok=(evidence.get('activation_bits')==4 and evidence.get('activation_storage')=='packed_int4'
            and evidence.get('native_int4_tensorcore') is True
            and isinstance(evidence.get('native_int4_gemm_calls'),(int,float))
            and evidence['native_int4_gemm_calls']>0)
        if arm=='w4a4kv4':
            ok=ok and all(isinstance(evidence.get(k),(int,float)) and evidence[k]>0 for k in ('kv_packed_prefills','kv_layer_reads'))
        return ok
    return False
if check.get('passed') is not True:
    raise SystemExit('Real-quant kernel self-check did not pass before model load')
arms=('bf16','w4a8','w4a4','w4a4kv4')
assigned=summary.get('assigned_slots')
assigned_keys=None
if assigned is not None:
    if mode!='shard' or not isinstance(assigned,list) or not assigned:
        raise SystemExit('Assigned slots are only valid for a nonempty shard retry')
    planned=read(root/'assigned_slots.json')
    if planned.get('protocol')!=summary.get('protocol'):
        raise SystemExit('Retry protocol differs from the executed plan')
    keys=lambda slots: {(s['index'],s['arm'],str(s['variant_id'])) for s in slots}
    assigned_keys=keys(assigned)
    if len(assigned_keys)!=len(assigned) or assigned_keys!=keys(planned['slots']):
        raise SystemExit('Completed retry assignment differs from its explicit slot plan')
    active_arms=[arm for arm in arms if any(s['arm']==arm for s in assigned)]
else:
    active_arms=list(arms)
runtime_evidence=summary.get('quantization_runtime')
last_arm=active_arms[-1]
if last_arm=='bf16':
    if runtime_evidence.get('arm')!='bf16' or runtime_evidence.get('weight_state')!='bf16':
        raise SystemExit('BF16-only retry changed its weight precision')
elif (not evidence_ok(runtime_evidence,last_arm) or runtime_evidence.get('arm')!=last_arm
      or not isinstance(runtime_evidence.get('integer_gemm_calls'),(int,float))
      or runtime_evidence['integer_gemm_calls']<=0):
    raise SystemExit('Actual integer runtime evidence missing for the final executed arm')
progress=read(root/'progress.json')
if summary.get('complete') is not True or progress.get('status')!='complete':
    raise SystemExit('Runner did not complete cleanly')
if mode=='preflight' and (summary.get('episodes')!=8 or len(summary.get('indices',[]))!=2):
    raise SystemExit('Preflight must contain exactly 2 variants / 8 paired episodes')
if mode=='performance':
    timing=summary.get('timing',{})
    if summary.get('episodes')!=0 or set(timing)!={'bf16','w4a8','w4a4','w4a4kv4'}:
        raise SystemExit('Performance run must contain timing only for all four arms')
    if any(v.get('paired_reference_contexts')!=28 or v.get('queries')!=84 for v in timing.values()):
        raise SystemExit('Performance run must time 28 contexts x 3 repeats per arm')
    storage=summary.get('storage',{})
    if not {'bf16','w4a8'}.issubset(storage):
        raise SystemExit('Performance run did not export BF16 and W4 packed storage')
if mode=='shard':
    expected_count=len(assigned) if assigned is not None else (stop-start)*4
    expected_indices={s['index'] for s in assigned} if assigned is not None else set(range(start,stop))
    if summary.get('episodes')!=expected_count or set(summary.get('indices',[]))!=expected_indices:
        raise SystemExit('Shard episode count or indices do not match assigned manifest interval')
    if assigned is not None and (progress.get('completed')!=expected_count or progress.get('expected')!=expected_count):
        raise SystemExit('Retry progress does not match its exact assigned slot count')
if mode in ('preflight','shard'):
    episode_path=root/'episodes.jsonl'
    records=[json.loads(line) for line in episode_path.read_text().splitlines() if line.strip()]
    expected=summary.get('episodes')
    if len(records)!=expected:
        raise SystemExit('Episode JSONL count does not match completed summary')
    actual_keys={(r['index'],r['arm'],str(r['variant_id'])) for r in records}
    if len(actual_keys)!=len(records) or (assigned_keys is not None and actual_keys!=assigned_keys):
        raise SystemExit('Duplicate episode or incomplete retry slot assignment')
    for record in records:
        arm=record.get('arm')
        if arm!='bf16' and not evidence_ok(record.get('real_quant_evidence'),arm):
            raise SystemExit(f'Per-episode real-quant evidence failed: {arm}/{record.get("variant_id")}')
print('REAL_QUANT_GATE=PASS mode='+mode,flush=True)
PY
