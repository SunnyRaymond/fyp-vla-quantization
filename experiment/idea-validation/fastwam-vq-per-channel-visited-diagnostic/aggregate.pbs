#!/bin/bash
#PBS -N fwpcvagg
#PBS -P personal-yguo017
#PBS -q qdev
#PBS -l select=1:ncpus=1:mem=4gb:ngpus=0
#PBS -l walltime=00:10:00
#PBS -j oe
set -euo pipefail
ROOT=/scratch/users/ntu/yguo017/fastwam-vq-per-channel-visited-diagnostic-20261018
test -n "${PBS_JOBID:-}" -a -n "${PBS_NODEFILE:-}"
case "$(hostname -s)" in *login*) exit 64;; esac
awk -F. -v host="$(hostname -s)" '$1 == host {found=1} END {exit !found}' "$PBS_NODEFILE"
qstat -f "$PBS_JOBID" | grep -Eq '^[[:space:]]*job_state[[:space:]]*=[[:space:]]*R([[:space:]]|$)'
ARTIFACTS=$ROOT/artifacts/$PBS_JOBID
mkdir -p "$ARTIFACTS"
exec > >(tee -a "$ARTIFACTS/job.log") 2>&1
finish() { rc=$?; trap - EXIT; printf '%s\n' "$rc" > "$ARTIFACTS/exit_code.txt"; exit "$rc"; }
trap finish EXIT
cp "$ROOT/worker.py" "$ROOT/protocol.json" "$ARTIFACTS/"
SOURCE_ARTIFACTS=/scratch/users/ntu/yguo017/fastwam-vq-visited-diagnostic-20261018/artifacts/25863989.pbs101
for name in metrics.py visited_common.py calibration_source.py; do cp "$SOURCE_ARTIFACTS/$name" "$ARTIFACTS/"; done
cp "$SOURCE_ARTIFACTS/worker.py" "$ARTIFACTS/source_worker.py"
module purge
module load gcc/11.4.0-nscc python/3.11.7-gcc11
python3 "$ARTIFACTS/worker.py" --unit aggregate --protocol "$ARTIFACTS/protocol.json"
touch "$ARTIFACTS/PHASE_COMPLETE"
