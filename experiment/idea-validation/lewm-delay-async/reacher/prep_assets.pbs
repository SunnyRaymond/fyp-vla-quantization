#!/bin/bash
#PBS -N lewm_reacher_prep
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -l walltime=08:00:00
#PBS -j oe

set -euo pipefail
JOB_ID=${PBS_JOBID:?PBS_JOBID must be set by PBS}
test -n "${PBS_NODEFILE:-}" && test -f "$PBS_NODEFILE"
HOST=$(hostname -s | tr '[:upper:]' '[:lower:]')
case "$HOST" in *login*|*head*|*submit*) echo "refusing login/submit host $HOST" >&2; exit 2;; esac
NODE_SHORTS=$(awk '{name=tolower($1); sub(/\..*/, "", name); print name}' "$PBS_NODEFILE" | sort -u)
printf '%s\n' "$NODE_SHORTS" | grep -Fxq "$HOST" || { echo "host absent from PBS_NODEFILE" >&2; exit 2; }

STAGE=/scratch/users/ntu/yguo017/lewm-pusht-iteration
HOME_DIR=$STAGE/stablewm_home
EXPERIMENT=/scratch/users/ntu/yguo017/dino-wm-wall/experiment/idea-validation/lewm-delay-async
CONTROL=$EXPERIMENT/reacher
OUT=$CONTROL/artifacts/$JOB_ID
MODEL=$STAGE/hf_reacher
ARCHIVE=$MODEL/reacher.tar.zst
DATA=$HOME_DIR/dmc/reacher_random.h5
CKPT=$HOME_DIR/reacher/lewm_object.ckpt
PYTHON_BIN=$STAGE/venv/bin/python
test -x "$PYTHON_BIN"
test -f "$CONTROL/convert_checkpoint.py"
test -d "$STAGE/le-wm" && test -d "$STAGE/stable-worldmodel"
test ! -e "$OUT"
mkdir -p "$OUT" "$MODEL" "$HOME_DIR/dmc" "$HOME_DIR/reacher"
STATUS=1
trap 'printf "EXIT_STATUS=%s\n" "$STATUS" > "$OUT/job_status"' EXIT
exec > >(tee -a "$OUT/job.log") 2>&1
printf 'job_id=%s\nhost=%s\nstarted_utc=%s\n' "$JOB_ID" "$HOST" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$OUT/execution_identity.txt"

export PYTHONUNBUFFERED=1
export MUJOCO_GL=egl
export STABLEWM_HOME="$HOME_DIR"
export PYTHONPATH="$STAGE/le-wm:$STAGE/stable-worldmodel:${PYTHONPATH:-}"

# Install only the missing Reacher simulator dependencies in the existing venv.
if ! "$PYTHON_BIN" -c 'import mujoco, dm_control' >/dev/null 2>&1; then
  "$PYTHON_BIN" -m pip install 'mujoco>=3,<4' 'dm-control>=1,<2'
fi
"$PYTHON_BIN" -c 'import mujoco, dm_control, torch, stable_worldmodel, stable_pretraining; print("reacher_dependencies=PASS", mujoco.__version__, torch.__version__)'

fetch() {
  local url=$1 destination=$2
  if [ -s "$destination" ]; then return; fi
  curl -fL --retry 6 --connect-timeout 30 -C - -o "$destination.part" "$url"
  test -s "$destination.part"
  mv "$destination.part" "$destination"
}

MODEL_REV=62adae4b71dc474ddf8f794c476ebfe737a743ca
DATA_REV=e70a080d0d04c6072123c9ebd343acf7fff28dbf
fetch "https://huggingface.co/quentinll/lewm-reacher/resolve/$MODEL_REV/config.json?download=true" "$MODEL/config.json"
fetch "https://huggingface.co/quentinll/lewm-reacher/resolve/$MODEL_REV/weights.pt?download=true" "$MODEL/weights.pt"
if [ ! -s "$DATA" ]; then
  fetch "https://huggingface.co/datasets/quentinll/lewm-reacher/resolve/$DATA_REV/reacher.tar.zst?download=true" "$ARCHIVE"
  EXTRACT=$MODEL/extracted_$JOB_ID
  mkdir -p "$EXTRACT"
  if ! "$PYTHON_BIN" -c 'import zstandard' >/dev/null 2>&1; then
    "$PYTHON_BIN" -m pip install 'zstandard>=0.23,<1'
  fi
  "$PYTHON_BIN" - "$ARCHIVE" "$EXTRACT" <<'PY'
import sys
import tarfile

import zstandard

with open(sys.argv[1], "rb") as archive:
    with zstandard.ZstdDecompressor().stream_reader(archive) as stream:
        with tarfile.open(fileobj=stream, mode="r|") as payload:
            payload.extractall(sys.argv[2])
PY
  mapfile -t H5_FILES < <(find "$EXTRACT" -type f -name '*.h5' -print)
  if [ "${#H5_FILES[@]}" -ne 1 ]; then echo "expected exactly one HDF5 in Reacher archive, found ${#H5_FILES[@]}" >&2; exit 3; fi
  mv "${H5_FILES[0]}" "$DATA"
fi
test -s "$DATA"
"$PYTHON_BIN" -c 'import h5py,sys; f=h5py.File(sys.argv[1],"r"); print("reacher_hdf5_keys=",list(f.keys())[:20]); f.close()' "$DATA"

if [ ! -s "$CKPT" ]; then
  "$PYTHON_BIN" "$CONTROL/convert_checkpoint.py"
fi
test -s "$CKPT"
printf 'dataset=%s\ndataset_size=%s\ncheckpoint=%s\ncheckpoint_size=%s\nmodel_revision=%s\ndataset_revision=%s\n' \
  "$DATA" "$(stat -c %s "$DATA")" "$CKPT" "$(stat -c %s "$CKPT")" "$MODEL_REV" "$DATA_REV" > "$OUT/asset_manifest.txt"
printf 'ASSET_PREP_PASS\n'
STATUS=0
