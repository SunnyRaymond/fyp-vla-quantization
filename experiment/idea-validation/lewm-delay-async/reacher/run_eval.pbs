#!/bin/bash
#PBS -N lewm_reacher_eval
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=16:mem=110gb:ngpus=1
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail
JOB_ID=${PBS_JOBID:?PBS_JOBID must be set by PBS}
test -n "${PBS_NODEFILE:-}" && test -f "$PBS_NODEFILE"
HOST=$(hostname -s | tr '[:upper:]' '[:lower:]')
case "$HOST" in *login*|*head*|*submit*) echo "refusing login/submit host $HOST" >&2; exit 2;; esac
NODE_SHORTS=$(awk '{name=tolower($1); sub(/\..*/, "", name); print name}' "$PBS_NODEFILE" | sort -u)
printf '%s\n' "$NODE_SHORTS" | grep -Fxq "$HOST" || { echo "host absent from PBS_NODEFILE" >&2; exit 2; }

MODE=${LEWM_MODE:?LEWM_MODE is required}
case "$MODE" in batch50-k0|n1-k0|fixed_steps|true_async) ;; *) echo "invalid mode $MODE" >&2; exit 2;; esac
DELAY=${LEWM_DELAY_STEPS:-0}
TASK_START=${LEWM_TASK_START:-0}
TASK_COUNT=${LEWM_TASK_COUNT:-50}
case "$TASK_START:$TASK_COUNT" in *[!0-9:]*|:*) echo "invalid task slice" >&2; exit 2;; esac
if [ "$MODE" = fixed_steps ]; then
  case "$DELAY" in 1|2|4|8|16) ;; *) echo "fixed_steps requires K in 1,2,4,8,16" >&2; exit 2;; esac
else
  test "$DELAY" = 0 || { echo "$MODE does not accept LEWM_DELAY_STEPS" >&2; exit 2; }
fi
if [ "$MODE" = batch50-k0 ]; then
  test "$TASK_START" = 0 && test "$TASK_COUNT" = 50 || { echo "batch50-k0 requires all 50 manifest tasks" >&2; exit 2; }
fi

EXPERIMENT=/scratch/users/ntu/yguo017/dino-wm-wall/experiment/idea-validation/lewm-delay-async
STAGE=/scratch/users/ntu/yguo017/lewm-pusht-iteration
CONTROL=$EXPERIMENT/reacher
RUNNER=$CONTROL/runner.py
ADAPTER=$EXPERIMENT/pusht/adapter.py
LEWM_ROOT=$STAGE/le-wm
STABLEWM_ROOT=$STAGE/stable-worldmodel
STAGED_HOME=$STAGE/stablewm_home
PYTHON_BIN=$STAGE/venv/bin/python
MANIFEST=${LEWM_MANIFEST:-$CONTROL/frozen_manifest.json}
OUT=$CONTROL/artifacts/$JOB_ID
CACHE=$OUT/cache

test -f "$RUNNER" && test -f "$ADAPTER" && test -s "$MANIFEST"
test -d "$LEWM_ROOT/config/eval" && test -d "$STABLEWM_ROOT" && test -x "$PYTHON_BIN"
test -s "$STAGED_HOME/reacher/lewm_object.ckpt" && test -s "$STAGED_HOME/dmc/reacher_random.h5"
test ! -e "$OUT"
mkdir -p "$OUT" "$CACHE/reacher" "$CACHE/dmc"
ln -s "$STAGED_HOME/reacher/lewm_object.ckpt" "$CACHE/reacher/lewm_object.ckpt"
ln -s "$STAGED_HOME/dmc/reacher_random.h5" "$CACHE/dmc/reacher_random.h5"

STATUS=1
GPU_MONITOR_PID=""
cleanup() {
  if [ -n "$GPU_MONITOR_PID" ] && kill -0 "$GPU_MONITOR_PID" 2>/dev/null; then
    kill "$GPU_MONITOR_PID" 2>/dev/null || true
    wait "$GPU_MONITOR_PID" 2>/dev/null || true
  fi
  printf 'EXIT_STATUS=%s\n' "$STATUS" > "$OUT/job_status"
}
trap cleanup EXIT
exec > >(tee -a "$OUT/job.log") 2>&1
printf 'job_id=%s\nhost=%s\nmode=%s\nK=%s\ntask_start=%s\ntask_count=%s\nmanifest=%s\nstarted_utc=%s\n' \
  "$JOB_ID" "$HOST" "$MODE" "$DELAY" "$TASK_START" "$TASK_COUNT" "$MANIFEST" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$OUT/execution_identity.txt"

export PYTHONUNBUFFERED=1 WANDB_MODE=disabled MUJOCO_GL=egl STABLEWM_HOME="$CACHE"
export PYTHONPATH="$LEWM_ROOT:$STABLEWM_ROOT:${PYTHONPATH:-}"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader > "$OUT/gpu_info.csv"
nvidia-smi --query-gpu=timestamp,index,name,utilization.gpu,memory.used,memory.total --format=csv -l 5 >> "$OUT/job.log" 2>&1 &
GPU_MONITOR_PID=$!

ARGS=(--mode "$MODE" --manifest "$MANIFEST" --output "$OUT/results"
  --task-start "$TASK_START" --task-count "$TASK_COUNT" --delay-steps "$DELAY"
  --lewm-root "$LEWM_ROOT")
if [ "$MODE" != batch50-k0 ]; then
  BATCH50_GATE=${LEWM_BATCH50_GATE:?N1/fixed/async modes require LEWM_BATCH50_GATE}
  test -s "$BATCH50_GATE"
  ARGS+=(--batch50-gate "$BATCH50_GATE")
fi
if [ "$MODE" = fixed_steps ] || [ "$MODE" = true_async ]; then
  N1_GATES=${LEWM_N1_K0_GATES:?fixed/async modes require all N1 K0 slice summary paths in LEWM_N1_K0_GATES}
  IFS=: read -r -a GATE_FILES <<< "$N1_GATES"
  test "${#GATE_FILES[@]}" -gt 0
  for gate in "${GATE_FILES[@]}"; do
    test -s "$gate"
    ARGS+=(--n1-k0-gate "$gate")
  done
fi

set +e
timeout --signal=TERM --kill-after=30s 6900 "$PYTHON_BIN" "$RUNNER" "${ARGS[@]}"
RC=$?
set -e
printf 'RUNNER_EXIT_STATUS=%s\n' "$RC" > "$OUT/final_exit_status.txt"
if [ "$MODE" = batch50-k0 ]; then
  RESULT=$OUT/results/result.json
else
  RESULT=$OUT/results/summary.json
fi
if [ "$RC" -eq 0 ] && [ -s "$RESULT" ]; then STATUS=0; fi
exit "$STATUS"
