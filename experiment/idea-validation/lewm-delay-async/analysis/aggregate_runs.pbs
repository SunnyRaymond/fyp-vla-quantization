#!/bin/bash
#PBS -N lewm_result_aggregate
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=00:30:00
#PBS -j oe

set -euo pipefail
JOB_ID=${PBS_JOBID:?PBS_JOBID must be set by PBS}
test -n "${PBS_NODEFILE:-}" && test -f "$PBS_NODEFILE"
HOST=$(hostname -s | tr '[:upper:]' '[:lower:]')
case "$HOST" in *login*|*head*|*submit*) echo "refusing login/submit host $HOST" >&2; exit 2;; esac
NODE_SHORTS=$(awk '{name=tolower($1); sub(/\..*/, "", name); print name}' "$PBS_NODEFILE" | sort -u)
printf '%s\n' "$NODE_SHORTS" | grep -Fxq "$HOST" || { echo "host absent from PBS_NODEFILE" >&2; exit 2; }

EXPERIMENT=/scratch/users/ntu/yguo017/dino-wm-wall/experiment/idea-validation/lewm-delay-async
SCRIPT=$EXPERIMENT/analysis/aggregate_runs.py
ANALYZER=$EXPERIMENT/analysis/analyze_results.py
PYTHON_BIN=${LEWM_AGGREGATION_PYTHON:-/scratch/users/ntu/yguo017/lewm-pusht-iteration/venv/bin/python}
MAP=${LEWM_AGGREGATION_MAP:?set LEWM_AGGREGATION_MAP to the explicit artifact mapping JSON}
OUTPUT=${LEWM_AGGREGATION_OUTPUT:?set LEWM_AGGREGATION_OUTPUT to a new output JSON path}
SUMMARY=${OUTPUT%.json}.analysis.json
JOB_OUT=${LEWM_AGGREGATION_JOB_DIR:-$(dirname "$OUTPUT")/aggregate_$JOB_ID}

test -s "$MAP" && test -f "$SCRIPT" && test -f "$ANALYZER" && test -x "$PYTHON_BIN"
test ! -e "$OUTPUT" && test ! -e "$SUMMARY" && test ! -e "$JOB_OUT"
mkdir -p "$(dirname "$OUTPUT")" "$JOB_OUT"
STATUS=1
trap 'printf "EXIT_STATUS=%s\n" "$STATUS" > "$JOB_OUT/job_status"' EXIT
exec > >(tee -a "$JOB_OUT/job.log") 2>&1
printf 'job_id=%s\nhost=%s\nmap=%s\noutput=%s\nstarted_utc=%s\n' \
  "$JOB_ID" "$HOST" "$MAP" "$OUTPUT" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$JOB_OUT/execution_identity.txt"

"$PYTHON_BIN" "$SCRIPT" --self-check
"$PYTHON_BIN" "$ANALYZER" --self-check
set +e
timeout --signal=TERM --kill-after=15s 1500 "$PYTHON_BIN" "$SCRIPT" --input "$MAP" --output "$OUTPUT"
RC=$?
if [ "$RC" -eq 0 ]; then
  timeout --signal=TERM --kill-after=15s 1500 "$PYTHON_BIN" "$ANALYZER" --input "$OUTPUT" --output "$SUMMARY"
  RC=$?
fi
set -e
printf 'RUNNER_EXIT_STATUS=%s\n' "$RC" > "$JOB_OUT/final_exit_status.txt"
if [ "$RC" -eq 0 ] && [ -s "$OUTPUT" ] && [ -s "$SUMMARY" ]; then STATUS=0; fi
exit "$STATUS"
