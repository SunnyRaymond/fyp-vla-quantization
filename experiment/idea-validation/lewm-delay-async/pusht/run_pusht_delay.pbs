#!/bin/bash
#PBS -N lewm_pusht_delay
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=16:mem=110gb:ngpus=1
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail
JOB_ID=${PBS_JOBID:?PBS_JOBID must be set by PBS}
test -n "${PBS_NODEFILE:-}" && test -f "$PBS_NODEFILE"
HOST=$(hostname -s | tr '[:upper:]' '[:lower:]')
case "$HOST" in *login*|*head*|*submit*) echo "refusing login/submit host $HOST" >&2; exit 2;; esac
NODE_SHORTS=$(awk '{name=tolower($1); sub(/\..*/, "", name); print name}' "$PBS_NODEFILE" | sort -u)
printf '%s\n' "$NODE_SHORTS" | grep -Fxq "$HOST" || { echo "host absent from PBS_NODEFILE" >&2; exit 2; }

MODE=${LEWM_MODE:?LEWM_MODE is required}
case "$MODE" in batch50_official_k0|paired_k0|fixed_steps|true_async) ;; *) echo "invalid mode $MODE" >&2; exit 2;; esac
DELAY=${LEWM_DELAY_STEPS:-0}
case "$DELAY" in 0|1|2|4|8|16) ;; *) echo "invalid K $DELAY" >&2; exit 2;; esac
TASK_START=${LEWM_TASK_START:-0}
TASK_STOP=${LEWM_TASK_STOP:-50}
EXPERIMENT=/scratch/users/ntu/yguo017/dino-wm-wall/experiment/idea-validation/lewm-delay-async
PROJECT=/scratch/users/ntu/yguo017/dino-wm-wall
CONTROL=$PROJECT/meeting-ready/02-horizon-weighted-recurrent-student/lewm-transfer
STAGE=/scratch/users/ntu/yguo017/lewm-pusht-iteration
LEWM_ROOT=$STAGE/le-wm
STABLEWM_ROOT=$STAGE/stable-worldmodel
STAGED_HOME=$STAGE/stablewm_home
PYTHON_BIN=$STAGE/venv/bin/python
RUNNER=$EXPERIMENT/pusht/run_pusht_delay_eval.py
FREEZE=$PROJECT/experiment/idea-validation/lewm-pusht-cem-budget/FREEZE.json
OUT=$EXPERIMENT/pusht/artifacts/$JOB_ID

test -f "$RUNNER" && test -f "$EXPERIMENT/pusht/adapter.py"
test -f "$EXPERIMENT/pusht/selected_tasks_25534994.json" && test -f "$EXPERIMENT/pusht/reference_outcomes.json"
test -f "$FREEZE"
test -f "$STAGED_HOME/pusht_expert_train.h5" && test -f "$STAGED_HOME/pusht/lewm_object.ckpt"
test -d "$LEWM_ROOT/config/eval" && test -d "$STABLEWM_ROOT" && test -x "$PYTHON_BIN"
test ! -e "$OUT"
mkdir -p "$OUT/cache/datasets" "$OUT/cache/pusht"
ln -s "$STAGED_HOME/pusht_expert_train.h5" "$OUT/cache/datasets/pusht_expert_train.h5"
ln -s "$STAGED_HOME/pusht/lewm_object.ckpt" "$OUT/cache/pusht/lewm_object.ckpt"

STATUS=1
GPU_MONITOR_PID=""
cleanup() {
  if [ -n "$GPU_MONITOR_PID" ] && kill -0 "$GPU_MONITOR_PID" 2>/dev/null; then
    kill "$GPU_MONITOR_PID" 2>/dev/null || true
    wait "$GPU_MONITOR_PID" 2>/dev/null || true
  fi
  printf 'EXIT_STATUS=%s\n' "$STATUS" > "$OUT/job_status"
}
trap cleanup EXIT
exec > >(tee -a "$OUT/job.log") 2>&1
printf 'job_id=%s\nhost=%s\nmode=%s\nK=%s\ntask_start=%s\ntask_stop=%s\nstarted_utc=%s\n' \
  "$JOB_ID" "$HOST" "$MODE" "$DELAY" "$TASK_START" "$TASK_STOP" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$OUT/execution_identity.txt"
export PYTHONUNBUFFERED=1 WANDB_MODE=disabled MUJOCO_GL=egl STABLEWM_HOME="$OUT/cache"
export PYTHONPATH="$LEWM_ROOT:$STABLEWM_ROOT:$CONTROL:${PYTHONPATH:-}"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader > "$OUT/gpu_info.csv"
nvidia-smi --query-gpu=timestamp,index,name,utilization.gpu,memory.used,memory.total --format=csv -l 5 >> "$OUT/job.log" 2>&1 &
GPU_MONITOR_PID=$!

ARGS=(--mode "$MODE" --task-start "$TASK_START" --task-stop "$TASK_STOP" --delay-steps "$DELAY"
  --lewm-root "$LEWM_ROOT" --stablewm-root "$STABLEWM_ROOT" --control-root "$CONTROL"
  --staged-home "$STAGED_HOME" --cache-root "$OUT/cache" --freeze "$FREEZE" --out "$OUT")
if [ "$MODE" != batch50_official_k0 ]; then
  GATE_DIR=${LEWM_GATE_DIR:?LEWM_GATE_DIR is required after batch50 gate}
  GATE_FILE=$GATE_DIR/batch50_official_k0.json
  test -f "$GATE_FILE"
  ARGS+=(--k0-gate "$GATE_FILE")
fi
set +e
timeout --signal=TERM --kill-after=30s 6900 "$PYTHON_BIN" "$RUNNER" "${ARGS[@]}"
RC=$?
set -e
printf 'RUNNER_EXIT_STATUS=%s\n' "$RC" > "$OUT/final_exit_status.txt"
if [ "$MODE" = batch50_official_k0 ]; then
  RESULT=$OUT/batch50_official_k0.json
else
  RESULT=$OUT/run_summary_${MODE}_k${DELAY}_${TASK_START}_${TASK_STOP}.json
fi
if [ "$RC" -eq 0 ] && [ -s "$RESULT" ]; then STATUS=0; fi
exit "$STATUS"
