#!/bin/bash
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=8:mem=36gb
#PBS -l walltime=00:20:00
#PBS -j oe
set -euo pipefail
NEW_ROOT=/scratch/users/ntu/yguo017/fastwam-teacher-multiseed-20261021
PARENT=/scratch/users/ntu/yguo017/fastwam-vq-c8-action-latent-plus-20261015
ROOT=/scratch/users/ntu/yguo017/fastwam-libero-plus-pilot-20261005
DIAG_ROOT=$NEW_ROOT
SMOOTH_ROOT=/scratch/users/ntu/yguo017/fastwam-smooth-vq-phases12-20261006
SOURCE_ROOT=/scratch/users/ntu/yguo017/fastwam-a4-phases12-20261006
BASE=/scratch/users/ntu/yguo017/fastwam-smoke
SIF=/scratch/users/ntu/yguo017/openvla-oft-vla-eval-libero/containers/libero-latest.sif
test -n "${PBS_JOBID:-}" -a -n "${PBS_NODEFILE:-}"
case "$(hostname -s)" in *login*) echo 'Refusing login-node execution'; exit 64;; esac
awk -F. -v host="$(hostname -s)" '$1 == host {found=1} END {exit !found}' "$PBS_NODEFILE"
qstat -f "$PBS_JOBID" | grep -Eq '^[[:space:]]*job_state[[:space:]]*=[[:space:]]*R([[:space:]]|$)'
ARTIFACTS=$NEW_ROOT/artifacts/$PBS_JOBID
mkdir -p "$ARTIFACTS"
export ARTIFACTS
exec > >(tee -a "$ARTIFACTS/job.log") 2>&1
FW_JOB_START_EPOCH=$(date +%s)
export FW_JOB_START_EPOCH
finish() { rc=$?; trap - EXIT; printf '%s\n' "$rc" > "$ARTIFACTS/exit_code.txt"; exit "$rc"; }
trap finish EXIT
for file in common.py collect.py protocol.json source_plan.json; do cp "$NEW_ROOT/$file" "$ARTIFACTS/"; done
cp "$PARENT/environment.sh" "$ARTIFACTS/environment.sh"
source "$ARTIFACTS/environment.sh"
NV_ARGS=()
FW_CPU_THREADS=6
FW_SOFT_DEADLINE_SECONDS=1050
export FW_CPU_THREADS FW_SOFT_DEADLINE_SECONDS
case "$TEACHER_UNIT" in
  prepare)
    for file in analyze.py analysis_selfcheck.py; do cp "$NEW_ROOT/$file" "$ARTIFACTS/"; done
    run_python "$ARTIFACTS/analysis_selfcheck.py"
    run_python "$ARTIFACTS/collect.py" --unit prepare;;
  analysis)
    for file in analyze.py analysis_selfcheck.py; do cp "$NEW_ROOT/$file" "$ARTIFACTS/"; done
    run_python "$ARTIFACTS/analysis_selfcheck.py"
    run_python "$ARTIFACTS/analyze.py";;
  *) echo 'Unknown CPU unit'; exit 64;;
esac
touch "$ARTIFACTS/PHASE_COMPLETE"
