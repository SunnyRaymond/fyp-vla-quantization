#!/bin/bash
#PBS -N lewm_goal_query
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=16:mem=110gb:ngpus=1
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail

JOB_ID=${PBS_JOBID:-}
if [ -z "$JOB_ID" ]; then
  echo "PBS_JOBID must be set by PBS" >&2
  exit 2
fi

REMOTE_ROOT=/scratch/users/ntu/yguo017/dino-wm-wall/experiment/idea-validation/lewm-goal-query-pilot
CONTROL="$REMOTE_ROOT/source"
ARTIFACTS="$REMOTE_ROOT/artifacts"
OUT="$ARTIFACTS/$JOB_ID"
TRANSFER=/scratch/users/ntu/yguo017/dino-wm-wall/meeting-ready/02-horizon-weighted-recurrent-student/lewm-transfer
STAGE_ROOT=/scratch/users/ntu/yguo017/lewm-pusht-iteration
LEWM_ROOT="$STAGE_ROOT/le-wm"
STABLEWM_ROOT="$STAGE_ROOT/stable-worldmodel"
STABLEWM_HOME="$STAGE_ROOT/stablewm_home"
PYTHON_BIN="$STAGE_ROOT/venv/bin/python"
DATASET="$STABLEWM_HOME/pusht_expert_train.h5"
TRAINING_ROWS="$TRANSFER/anchor-aligned-bank/artifacts/25223859.pbs101/anchor_aligned_train_rows.pt"
MANIFEST="$TRANSFER/state-coverage/artifacts/24926383.pbs101/context_manifest_512.json"
TEMPORAL_FREEZE="$TRANSFER/temporal-balanced-train/LEWM_TEMPORAL_BALANCED_TRAIN_FREEZE.json"
RUNNER="$CONTROL/runner.py"
FREEZE="$CONTROL/FREEZE.json"
PROTOCOL="$CONTROL/PROTOCOL.zh.md"

test ! -e "$OUT" || { echo "refusing to overwrite existing output: $OUT" >&2; exit 2; }
mkdir -p "$ARTIFACTS"
mkdir "$OUT"
exec > >(tee -a "$OUT/job.log") 2>&1

STATUS=2
RUNNER_RC=NOT_STARTED
STATUS_REASON=preflight_failed
GPU_MONITOR_PID=
stop_gpu_monitor() {
  if [ -n "$GPU_MONITOR_PID" ] && kill -0 "$GPU_MONITOR_PID" 2>/dev/null; then
    kill "$GPU_MONITOR_PID" 2>/dev/null || true
    wait "$GPU_MONITOR_PID" 2>/dev/null || true
  fi
}
finish() {
  stop_gpu_monitor
  printf 'EXIT_STATUS=%s\nRUNNER_EXIT_STATUS=%s\nSTATUS_REASON=%s\n' \
    "$STATUS" "$RUNNER_RC" "$STATUS_REASON" > "$OUT/job_status.txt"
  printf 'EXIT_STATUS=%s\nRUNNER_EXIT_STATUS=%s\n' \
    "$STATUS" "$RUNNER_RC" > "$OUT/final_exit_status.txt"
}
trap finish EXIT

test -n "${PBS_NODEFILE:-}" && test -f "$PBS_NODEFILE" || {
  echo "PBS_NODEFILE is missing" >&2
  exit 2
}
HOST=$(hostname -s | tr '[:upper:]' '[:lower:]')
case "$HOST" in
  *login*|*head*|*submit*) echo "refusing probable login/submit node: $HOST" >&2; exit 2 ;;
esac
NODE_SHORTS=$(awk '{name=tolower($1); sub(/\..*/, "", name); print name}' "$PBS_NODEFILE" | sort -u)
if ! printf '%s\n' "$NODE_SHORTS" | grep -Fxq "$HOST"; then
  echo "current host $HOST is not listed in PBS_NODEFILE" >&2
  exit 2
fi
case "${CUDA_VISIBLE_DEVICES:-}" in
  ""|-1) echo "CUDA_VISIBLE_DEVICES is not assigned by PBS" >&2; exit 2 ;;
esac

for FILE in "$RUNNER" "$FREEZE" "$PROTOCOL" "$PYTHON_BIN" "$DATASET" \
  "$TRAINING_ROWS" "$MANIFEST" "$TEMPORAL_FREEZE"; do
  test -f "$FILE" || { echo "missing required file: $FILE" >&2; exit 2; }
done
test -x "$PYTHON_BIN"
test -d "$LEWM_ROOT/config/eval" && test -d "$STABLEWM_ROOT" && test -d "$STABLEWM_HOME"

SNAPSHOT="$OUT/source_snapshot"
mkdir "$SNAPSHOT"
cp "$RUNNER" "$FREEZE" "$PROTOCOL" "$SNAPSHOT/"
printf 'job_id=%s\nhost=%s\nremote_root=%s\nsource_snapshot=%s\npython=%s\nstarted_utc=%s\n' \
  "$JOB_ID" "$HOST" "$REMOTE_ROOT" "$SNAPSHOT" "$PYTHON_BIN" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  > "$OUT/execution_identity.txt"

export PYTHONUNBUFFERED=1
export WANDB_MODE=disabled
export MUJOCO_GL=egl
export STABLEWM_HOME
export PYTHONPATH="$LEWM_ROOT:$STABLEWM_ROOT:$TRANSFER:$SNAPSHOT:${PYTHONPATH:-}"

"$PYTHON_BIN" --version
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader > "$OUT/gpu_info.csv"
nvidia-smi --query-gpu=timestamp,index,name,utilization.gpu,memory.used,memory.total --format=csv -l 15 >> "$OUT/job.log" 2>&1 &
GPU_MONITOR_PID=$!

set +e
timeout --signal=TERM --kill-after=30s 6900 "$PYTHON_BIN" "$SNAPSHOT/runner.py" \
  --transfer-root "$TRANSFER" --lewm-root "$LEWM_ROOT" \
  --stablewm-root "$STABLEWM_ROOT" --stablewm-home "$STABLEWM_HOME" \
  --dataset "$DATASET" --training-rows "$TRAINING_ROWS" \
  --manifest "$MANIFEST" --temporal-freeze "$TEMPORAL_FREEZE" \
  --freeze "$SNAPSHOT/FREEZE.json" --out "$OUT"
RUNNER_RC=$?
set -e
stop_gpu_monitor
GPU_MONITOR_PID=

if [ "$RUNNER_RC" -eq 0 ] && [ -s "$OUT/run_summary.json" ]; then
  STATUS=0
  STATUS_REASON=runner_completed
elif [ "$RUNNER_RC" -eq 0 ]; then
  STATUS=3
  STATUS_REASON=missing_run_summary
  echo "runner exited 0 but did not write a nonempty run_summary.json" >&2
else
  STATUS=$RUNNER_RC
  STATUS_REASON=runner_exit
fi
trap - EXIT
finish
exit "$STATUS"
