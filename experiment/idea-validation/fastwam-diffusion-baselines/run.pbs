#!/bin/bash
#PBS -N dfbase0001
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=32:mem=220gb:ngpus=4
#PBS -l walltime=24:00:00
#PBS -j oe
set -euo pipefail

test -n "${PBS_JOBID:-}" -a -n "${PBS_JOBNAME:-}" -a -s "${PBS_NODEFILE:-}" || { echo 'PBS allocation variables required' >&2; exit 64; }
case "$(hostname -s)" in *login*) echo 'Refusing login-node execution' >&2; exit 64;; esac
grep -Fqx "$(hostname -s)" <(awk -F. '{print $1}' "$PBS_NODEFILE") || { echo 'Host outside PBS allocation' >&2; exit 64; }
[[ "$PBS_JOBNAME" =~ ^dfbase[0-9]{4}$ ]] || { echo 'Unexpected PBS job name' >&2; exit 64; }
ALLOCATION_QSTAT=$(qstat -f "$PBS_JOBID") || { echo 'Cannot verify PBS allocation' >&2; exit 64; }
grep -Eq '^[[:space:]]*job_state[[:space:]]*=[[:space:]]*R([[:space:]]|$)' <<< "$ALLOCATION_QSTAT" || { echo 'PBS job is not running' >&2; exit 64; }

# PBS executes a spool copy; its directory does not contain our protocol.
SCRIPT_DIR=/scratch/users/ntu/yguo017/fastwam-diffusion-baselines-20261019
mapfile -t P < <(python3 - "$SCRIPT_DIR/protocol.json" <<'PY_PATHS'
import json, sys
from pathlib import Path
p = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
s, roots = p["sources"], p["roots"]
for value in (
    p["remote_root"], roots["pilot"], roots["base"], roots["old_banks"], roots["old_inputs"],
    s["runtime_artifacts"], s["previous_episode_artifacts"], s["reference_loader_artifacts"],
    s["calibration_artifacts"], s["calibration_plan"], s["bf16_teacher_directory"],
    p["cohort"]["reference_manifest"],
):
    print(value)
PY_PATHS
)
test "${#P[@]}" -eq 12 || { echo 'Could not resolve frozen source paths' >&2; exit 65; }
NEW_ROOT=${P[0]}; ROOT=${P[1]}; BASE=${P[2]}; SMOOTH_ROOT=${P[3]}; SOURCE_ROOT=${P[4]}
RUNTIME_SOURCE=${P[5]}; PREVIOUS_SOURCE=${P[6]}; REFERENCE_SOURCE=${P[7]}; CALIBRATION_SOURCE=${P[8]}
CALIBRATION_PLAN=${P[9]}; BF16_TEACHER_DIRECTORY=${P[10]}; MANIFEST=${P[11]}
DIAG_ROOT=$NEW_ROOT
SIF=/scratch/users/ntu/yguo017/openvla-oft-vla-eval-libero/containers/libero-latest.sif
ARTIFACTS=$NEW_ROOT/artifacts/$PBS_JOBID
RESULTS=$NEW_ROOT/results
FW_JOB_START_EPOCH=$(date +%s)
FW_CPU_THREADS=8
FW_SOFT_DEADLINE_SECONDS=85500
FW_DIFFUSION_RESUME_SOURCE_JOB_ID=${FW_DIFFUSION_RESUME_SOURCE_JOB_ID:-}
export NEW_ROOT ROOT BASE SMOOTH_ROOT SOURCE_ROOT DIAG_ROOT SIF ARTIFACTS RESULTS
export FW_JOB_START_EPOCH FW_CPU_THREADS FW_SOFT_DEADLINE_SECONDS FW_DIFFUSION_RESUME_SOURCE_JOB_ID
mkdir -p "$ARTIFACTS" "$RESULTS/workers"
printf '%s\n' "$ALLOCATION_QSTAT" > "$ARTIFACTS/allocation.txt"
exec > >(tee -a "$ARTIFACTS/job.log") 2>&1

PIPELINE_READY=0
PIPELINE_CHECKPOINTED=0
GPU_MONITOR_PID=
WORKERS=()
write_phase() {
  local phase="$1" stamp
  stamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  printf '{"protocol":"fastwam-diffusion-baselines-v1","pbs_jobid":"%s","job_name":"%s","phase":"%s","updated_utc":"%s"}\n' \
    "$PBS_JOBID" "$PBS_JOBNAME" "$phase" "$stamp" > "$ARTIFACTS/RUN_PHASE.json.tmp"
  mv -f "$ARTIFACTS/RUN_PHASE.json.tmp" "$ARTIFACTS/RUN_PHASE.json"
}
finish() {
  local rc=$?
  trap - EXIT TERM INT
  if (( rc != 0 )); then
    for pid in "${WORKERS[@]:-}"; do kill -TERM "$pid" 2>/dev/null || true; done
  fi
  if [[ -n "$GPU_MONITOR_PID" ]]; then kill "$GPU_MONITOR_PID" 2>/dev/null || true; wait "$GPU_MONITOR_PID" 2>/dev/null || true; fi
  if (( rc == 0 && PIPELINE_READY == 1 )); then
    write_phase complete || rc=65
    if (( rc == 0 )); then touch "$ARTIFACTS/PIPELINE_COMPLETE"; rm -f "$ARTIFACTS/PIPELINE_CHECKPOINTED"; fi
  elif (( rc == 0 && PIPELINE_CHECKPOINTED == 1 )); then
    write_phase checkpointed || rc=65
    if (( rc == 0 )); then touch "$ARTIFACTS/PIPELINE_CHECKPOINTED"; rm -f "$ARTIFACTS/PIPELINE_COMPLETE"; fi
  else
    (( rc != 0 )) || rc=65
    write_phase failed || true
    rm -f "$ARTIFACTS/PIPELINE_COMPLETE" "$ARTIFACTS/PIPELINE_CHECKPOINTED"
  fi
  printf '%s\n' "$rc" > "$ARTIFACTS/exit_code.txt.tmp"
  mv -f "$ARTIFACTS/exit_code.txt.tmp" "$ARTIFACTS/exit_code.txt"
  exit "$rc"
}
trap finish EXIT
trap 'exit 143' TERM INT

write_phase allocation_verified
case "${CUDA_VISIBLE_DEVICES:-}" in '') echo 'No allocated GPUs' >&2; exit 65;; esac
IFS=, read -r -a GPU_IDS <<< "$CUDA_VISIBLE_DEVICES"
test "${#GPU_IDS[@]}" -eq 4 || { echo 'Expected four allocated GPU identifiers' >&2; exit 65; }
GPU_UUIDS=()
for gpu in "${GPU_IDS[@]}"; do
  uuid=$(nvidia-smi -i "$gpu" --query-gpu=uuid --format=csv,noheader | tr -d '[:space:]')
  test -n "$uuid" || { echo 'Could not resolve an allocated GPU UUID' >&2; exit 65; }
  for previous in "${GPU_UUIDS[@]:-}"; do test "$uuid" != "$previous" || { echo 'Duplicate allocated GPU UUID' >&2; exit 65; }; done
  GPU_UUIDS+=("$uuid")
done
(
  while :; do
    for uuid in "${GPU_UUIDS[@]}"; do
      printf 'GPU_SAMPLE timestamp=%s ' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      nvidia-smi -i "$uuid" --query-gpu=uuid,name,utilization.gpu,memory.used,memory.total --format=csv,noheader || true
    done
    sleep 15
  done
) & GPU_MONITOR_PID=$!

test -s "$NEW_ROOT/protocol.json" -a -s "$NEW_ROOT/run.pbs" -a -s "$NEW_ROOT/environment.sh" \
  -a -s "$NEW_ROOT/diffusion_quant.py" -a -s "$NEW_ROOT/runtime.py" \
  -a -s "$NEW_ROOT/evaluate.py" -a -s "$NEW_ROOT/aggregate.py" || { echo 'Missing uploaded evaluation source' >&2; exit 65; }
for f in runner.py quantization.py libero_state_loader.py; do test -s "$RUNTIME_SOURCE/$f" || { echo "Missing frozen runtime source: $f" >&2; exit 65; }; done
for f in calibration_source.py smooth_vq.py codebook.py micro_codebook.py; do test -s "$CALIBRATION_SOURCE/$f" || { echo "Missing frozen calibration source: $f" >&2; exit 65; }; done
test -s "$PREVIOUS_SOURCE/vq_adapter.py" -a -s "$REFERENCE_SOURCE/aggregate.py" \
  -a -s "$REFERENCE_SOURCE/reference_aggregate.py" || { echo 'Missing frozen episode/reference source' >&2; exit 65; }
test -s "$CALIBRATION_PLAN" -a -d "$BF16_TEACHER_DIRECTORY" -a -s "$MANIFEST" \
  -a -s "$ROOT/env_status.json" -a -s "$SIF" || { echo 'A frozen calibration, teacher, cohort, environment, or container source is missing' >&2; exit 65; }
test -d "$BASE/FastWAM" -a -d "$BASE/checkpoints" || { echo 'FastWAM runtime or checkpoint source is unavailable' >&2; exit 65; }

write_phase source_staging
cp "$NEW_ROOT/run.pbs" "$NEW_ROOT/protocol.json" "$NEW_ROOT/environment.sh" \
  "$NEW_ROOT/diffusion_quant.py" "$NEW_ROOT/runtime.py" "$NEW_ROOT/evaluate.py" "$NEW_ROOT/aggregate.py" "$ARTIFACTS/"
if [[ -s "$NEW_ROOT/gpu_selfcheck.py" ]]; then cp "$NEW_ROOT/gpu_selfcheck.py" "$ARTIFACTS/"; fi
cp "$RUNTIME_SOURCE/runner.py" "$RUNTIME_SOURCE/quantization.py" \
  "$RUNTIME_SOURCE/libero_state_loader.py" "$ARTIFACTS/"
cp "$CALIBRATION_SOURCE/calibration_source.py" "$CALIBRATION_SOURCE/smooth_vq.py" \
  "$CALIBRATION_SOURCE/codebook.py" "$CALIBRATION_SOURCE/micro_codebook.py" "$ARTIFACTS/"
cp "$PREVIOUS_SOURCE/vq_adapter.py" "$ARTIFACTS/previous_vq_adapter.py"
cp "$REFERENCE_SOURCE/aggregate.py" "$ARTIFACTS/reference_loaders.py"
cp "$REFERENCE_SOURCE/reference_aggregate.py" "$ARTIFACTS/"
cp -n "$MANIFEST" "$RESULTS/manifest.json"
cmp -s "$MANIFEST" "$RESULTS/manifest.json" || { echo 'Frozen cohort manifest mismatch' >&2; exit 65; }
cp -n "$NEW_ROOT/protocol.json" "$RESULTS/protocol.json"
cmp -s "$NEW_ROOT/protocol.json" "$RESULTS/protocol.json" || { echo 'Frozen protocol mismatch' >&2; exit 65; }

if [[ -n "$FW_DIFFUSION_RESUME_SOURCE_JOB_ID" ]]; then
  [[ "$FW_DIFFUSION_RESUME_SOURCE_JOB_ID" =~ ^[0-9]+\.[A-Za-z0-9_.-]+$ ]] || { echo 'Invalid checkpoint source job id' >&2; exit 65; }
  python3 - "$NEW_ROOT" "$RESULTS" "$FW_DIFFUSION_RESUME_SOURCE_JOB_ID" <<'PY_RESUME_GATE'
import json, sys
from pathlib import Path
root, results, source = Path(sys.argv[1]), Path(sys.argv[2]), sys.argv[3]
artifact = root / "artifacts" / source
try:
    phase = json.loads((artifact / "RUN_PHASE.json").read_text())
    summary = json.loads((results / "summary.json").read_text())
    marker = json.loads((results / "PIPELINE_CHECKPOINTED").read_text())
    if ((artifact / "exit_code.txt").read_text().strip() != "0"
            or not (artifact / "PIPELINE_CHECKPOINTED").is_file()
            or (artifact / "PIPELINE_COMPLETE").exists()
            or phase.get("protocol") != "fastwam-diffusion-baselines-v1"
            or phase.get("phase") != "checkpointed"
            or summary.get("protocol") != phase.get("protocol")
            or summary.get("status") != "checkpointed" or summary.get("complete") is not False
            or marker.get("protocol") != phase.get("protocol") or marker.get("complete") is not False
            or summary.get("reference_episode_slots") != 2240
            or marker.get("reference_episode_slots") != 2240):
        raise SystemExit("Checkpoint source is not a successful frozen-protocol checkpoint")
    total, arms = 0, {"svdquant_w4a4": 0, "viditq_w4a4": 0}
    for worker in range(4):
        worker_root = results / "workers" / f"worker_{worker}"
        progress = json.loads((worker_root / "progress.json").read_text())
        receipt = json.loads((worker_root / "summary.json").read_text())
        arm = "svdquant_w4a4" if worker < 2 else "viditq_w4a4"
        indices = list(range(worker % 2, 280, 2))
        count = receipt.get("episodes")
        if (progress != receipt or receipt.get("protocol") != phase["protocol"]
                or receipt.get("worker_id") != worker or receipt.get("arm") != arm
                or receipt.get("expected") != 140 or type(count) is not int or not 0 <= count <= 140
                or receipt.get("indices") != indices or receipt.get("completed_indices") != indices[:count]
                or receipt.get("status") not in ("complete", "checkpointed")):
            raise SystemExit(f"Worker {worker} checkpoint receipt is invalid")
        if receipt["status"] == "complete" and (count != 140 or receipt.get("complete") is not True):
            raise SystemExit(f"Worker {worker} completion receipt is inconsistent")
        if receipt["status"] == "checkpointed" and (receipt.get("complete") is not False
                or receipt.get("soft_deadline_reached") is not True):
            raise SystemExit(f"Worker {worker} checkpoint receipt is inconsistent")
        total += count
        arms[arm] += count
    if (total != summary.get("episode_slots") or total != marker.get("episode_slots")
            or arms != summary.get("arm_counts") or arms != marker.get("arm_counts")
            or not 0 <= total < 560):
        raise SystemExit("Checkpoint totals do not match all four worker receipts")
except (OSError, ValueError, KeyError) as exc:
    raise SystemExit(f"Checkpoint source is incomplete: {exc}")
PY_RESUME_GATE
  unset APPTAINERENV_FW_DIFFUSION_RESUME APPTAINERENV_FW_DIFFUSION_RESUME_SOURCE_JOB_ID
  export APPTAINERENV_FW_DIFFUSION_RESUME=1
  export APPTAINERENV_FW_DIFFUSION_RESUME_SOURCE_JOB_ID="$FW_DIFFUSION_RESUME_SOURCE_JOB_ID"
fi

source "$ARTIFACTS/environment.sh"
export FW_JOB_START_EPOCH FW_CPU_THREADS FW_SOFT_DEADLINE_SECONDS
write_phase evaluating
for worker in 0 1 2 3; do
  gpu_uuid=${GPU_UUIDS[$worker]}
  rc_path="$ARTIFACTS/worker_${worker}.rc"
  rm -f "$rc_path" "$rc_path.tmp"
  (
    child_pid=
    stop_worker() {
      if [[ -n "$child_pid" ]]; then kill -TERM "$child_pid" 2>/dev/null || true; wait "$child_pid" 2>/dev/null || true; fi
      printf '143\n' > "$rc_path.tmp"
      mv -f "$rc_path.tmp" "$rc_path"
      exit 143
    }
    trap stop_worker TERM INT
    CUDA_VISIBLE_DEVICES="$gpu_uuid" run_python "$ARTIFACTS/evaluate.py" \
      --protocol "$ARTIFACTS/protocol.json" --manifest "$RESULTS/manifest.json" \
      --worker-id "$worker" --out "$RESULTS/workers/worker_$worker" &
    child_pid=$!
    set +e
    wait "$child_pid"
    rc=$?
    set -e
    printf '%s\n' "$rc" > "$rc_path.tmp"
    mv -f "$rc_path.tmp" "$rc_path"
    exit "$rc"
  ) > "$ARTIFACTS/worker_${worker}.log" 2>&1 &
  WORKERS+=("$!")
  echo "WORKER_STARTED worker=$worker gpu_uuid=$gpu_uuid arm=$([[ $worker -lt 2 ]] && echo svdquant_w4a4 || echo viditq_w4a4) indices=${worker}%2+2k expected=140"
  if (( worker < 3 )); then sleep 20; fi
done

declare -A WORKER_DONE=()
while (( ${#WORKER_DONE[@]} < 4 )); do
  failed_worker=
  failed_rc=0
  for worker in 0 1 2 3; do
    [[ -z "${WORKER_DONE[$worker]:-}" ]] || continue
    rc_path="$ARTIFACTS/worker_${worker}.rc"
    if [[ -s "$rc_path" ]]; then
      rc=$(<"$rc_path")
      WORKER_DONE[$worker]=1
      if (( rc != 0 )); then failed_worker=$worker; failed_rc=$rc; break; fi
    fi
  done
  if [[ -n "$failed_worker" ]]; then
    echo "WORKER_FAILED worker=$failed_worker exit_code=$failed_rc; stopping remaining workers" >&2
    for worker in 0 1 2 3; do [[ -n "${WORKER_DONE[$worker]:-}" ]] || kill -TERM "${WORKERS[$worker]}" 2>/dev/null || true; done
    for pid in "${WORKERS[@]}"; do wait "$pid" 2>/dev/null || true; done
    exit "$failed_rc"
  fi
  (( ${#WORKER_DONE[@]} == 4 )) || sleep 2
done
for pid in "${WORKERS[@]}"; do wait "$pid"; done
WORKERS=()

write_phase aggregating
run_python "$ARTIFACTS/aggregate.py" --protocol "$ARTIFACTS/protocol.json" \
  --manifest "$RESULTS/manifest.json" --results "$RESULTS"
run_python - "$ARTIFACTS/protocol.json" "$RESULTS" <<'PY_RESULT_GATE'
import json, sys
from pathlib import Path
p = json.loads(Path(sys.argv[1]).read_text())
results = Path(sys.argv[2])
summary = json.loads((results / "summary.json").read_text())
complete = results / "PIPELINE_COMPLETE"
checkpoint = results / "PIPELINE_CHECKPOINTED"
if summary.get("protocol") != p["protocol"] or summary.get("reference_episode_slots") != 2240:
    raise SystemExit("Aggregate summary differs from the frozen protocol or 2,240 reference slots")
total, arms = 0, {"svdquant_w4a4": 0, "viditq_w4a4": 0}
for worker in range(4):
    worker_root = results / "workers" / f"worker_{worker}"
    progress = json.loads((worker_root / "progress.json").read_text())
    receipt = json.loads((worker_root / "summary.json").read_text())
    arm = "svdquant_w4a4" if worker < 2 else "viditq_w4a4"
    indices = list(range(worker % 2, 280, 2))
    count = receipt.get("episodes")
    if (progress != receipt or receipt.get("protocol") != p["protocol"]
            or receipt.get("worker_id") != worker or receipt.get("arm") != arm
            or receipt.get("expected") != 140 or type(count) is not int or not 0 <= count <= 140
            or receipt.get("indices") != indices or receipt.get("completed_indices") != indices[:count]):
        raise SystemExit(f"Worker {worker} has an invalid 140-episode prefix receipt")
    if receipt.get("status") == "complete":
        if count != 140 or receipt.get("complete") is not True:
            raise SystemExit(f"Worker {worker} is not complete")
    elif receipt.get("status") == "checkpointed":
        if receipt.get("complete") is not False or receipt.get("soft_deadline_reached") is not True:
            raise SystemExit(f"Worker {worker} checkpoint is malformed")
    else:
        raise SystemExit(f"Worker {worker} has an invalid status")
    total += count
    arms[arm] += count
if summary.get("episode_slots") != total or summary.get("arm_counts") != arms:
    raise SystemExit("Aggregate totals differ from the four worker receipts")
if summary.get("status") == "complete":
    marker = json.loads(complete.read_text())
    if (total != 560 or arms != {"svdquant_w4a4": 280, "viditq_w4a4": 280}
            or summary.get("complete") is not True or marker.get("protocol") != p["protocol"]
            or marker.get("complete") is not True or marker.get("episode_slots") != 560
            or marker.get("arm_counts") != arms or marker.get("reference_episode_slots") != 2240
            or checkpoint.exists()):
        raise SystemExit("560/2,240 completion gate failed")
    print("PIPELINE_COMPLETE 560/560 episodes; references=2240", flush=True)
elif summary.get("status") == "checkpointed":
    marker = json.loads(checkpoint.read_text())
    if (not 0 <= total < 560 or summary.get("complete") is not False
            or marker.get("protocol") != p["protocol"] or marker.get("complete") is not False
            or marker.get("episode_slots") != total or marker.get("arm_counts") != arms
            or marker.get("reference_episode_slots") != 2240 or complete.exists()):
        raise SystemExit("Checkpoint aggregate gate failed")
    print(f"PIPELINE_CHECKPOINTED {total}/560 episodes", flush=True)
else:
    raise SystemExit("Aggregate is neither complete nor checkpointed")
PY_RESULT_GATE
status=$(python3 -c "import json; print(json.load(open('$RESULTS/summary.json'))['status'])")
if [[ "$status" == complete ]]; then PIPELINE_READY=1; else PIPELINE_CHECKPOINTED=1; fi
