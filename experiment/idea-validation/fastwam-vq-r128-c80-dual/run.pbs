#!/bin/bash
#PBS -N fwvr128c80d
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=32:mem=220gb:ngpus=2
#PBS -l walltime=08:00:00
#PBS -j oe
set -euo pipefail

NEW_ROOT=/scratch/users/ntu/yguo017/fastwam-vq-r128-c80-dual-20261022
PARENT=/scratch/users/ntu/yguo017/fastwam-vq-c8-action-latent-plus-20261015
ROOT=/scratch/users/ntu/yguo017/fastwam-libero-plus-pilot-20261005
BASE=/scratch/users/ntu/yguo017/fastwam-smoke
SMOOTH_ROOT=/scratch/users/ntu/yguo017/fastwam-smooth-vq-phases12-20261006
SOURCE_ROOT=/scratch/users/ntu/yguo017/fastwam-a4-phases12-20261006
DIAG_ROOT=$NEW_ROOT
R128_ROOT=/scratch/users/ntu/yguo017/fastwam-r128-improvements-20261021
SIF=/scratch/users/ntu/yguo017/openvla-oft-vla-eval-libero/containers/libero-latest.sif
RUNTIME_ARTIFACTS=$PARENT/artifacts/25814264.pbs101
PROTOCOL_ID=fastwam-vq-r128-c80-dual-v1

test -n "${PBS_JOBID:-}" || { echo 'PBS_JOBID required' >&2; exit 64; }
test -n "${PBS_NODEFILE:-}" || { echo 'PBS_NODEFILE required' >&2; exit 64; }
test -s "$PBS_NODEFILE" || { echo 'PBS_NODEFILE is empty or unavailable' >&2; exit 64; }
HOST=$(hostname -s)
case "$HOST" in *login*) echo 'Refusing login-node execution' >&2; exit 64;; esac
awk -F. -v host="$HOST" '$1 == host {found=1} END {exit !found}' "$PBS_NODEFILE" || {
  echo 'Current host is not in the approved PBS allocation' >&2; exit 64;
}
ALLOCATION_QSTAT=$(qstat -f "$PBS_JOBID")
grep -Eq '^[[:space:]]*job_state[[:space:]]*=[[:space:]]*R([[:space:]]|$)' <<< "$ALLOCATION_QSTAT" || {
  echo 'PBS job is not in running state; refusing workload startup' >&2; exit 64;
}
grep -Eiq '^[[:space:]]*queue[[:space:]]*=[[:space:]]*g2([[:space:]]|$)' <<< "$ALLOCATION_QSTAT" || {
  echo 'PBS did not route this normal-queue job to g2; refusing workload startup' >&2; exit 64;
}

FW_JOB_START_EPOCH=$(date +%s)
export FW_JOB_START_EPOCH
ARTIFACTS=$NEW_ROOT/artifacts/$PBS_JOBID
RESULTS=$NEW_ROOT/results
mkdir -p "$ARTIFACTS" "$RESULTS"
printf '%s\n' "$ALLOCATION_QSTAT" > "$ARTIFACTS/allocation.txt"
exec > >(tee -a "$ARTIFACTS/job.log") 2>&1
GPU_MONITOR_PID=
finish() {
  rc=$?
  trap - EXIT TERM INT
  set +e
  if [[ -n "$GPU_MONITOR_PID" ]]; then
    kill "$GPU_MONITOR_PID" 2>/dev/null
    wait "$GPU_MONITOR_PID" 2>/dev/null
  fi
  if (( rc == 0 )) && [[ -s "$RESULTS/summary.json" ]] && \
      cp "$RESULTS/summary.json" "$ARTIFACTS/worker_summary.json" && \
      python3 - "$ARTIFACTS/worker_summary.json" "$PROTOCOL_ID" "$PBS_JOBID" <<'PY'
import json, math, sys
from pathlib import Path

s=json.loads(Path(sys.argv[1]).read_text(encoding='utf-8'))
if not isinstance(s, dict) or s.get('status') != 'complete' or s.get('complete') is not True:
    raise SystemExit('root summary is not complete')
if s.get('protocol') != sys.argv[2] or s.get('pbs_jobid') != sys.argv[3]:
    raise SystemExit('root summary protocol or PBS handle differs')
for key, count in (('banks', 614), ('moments', 80)):
    r=s.get(key) or {}
    if r.get('expected') != count or r.get('available') != count or r.get('receipt') is not True:
        raise SystemExit(f'{key} receipt/count gate failed')
g=s.get('gates') or {}
if any(g.get(k) is not True for k in ('source', 'repro', 'frozen')):
    raise SystemExit('source/reproduction/frozen gate failed')
for key, limit in (('formal_parity_max_error', 1e-6), ('orthogonality_max_error', 5e-5)):
    value=g.get(key)
    if type(value) not in (int, float) or not math.isfinite(value) or value > limit:
        raise SystemExit(f'{key} gate failed')
if (s.get('new_teacher_queries') != 0 or s.get('comparison_file') != 'results/comparison.json'
        or s.get('comparison_complete') is not True):
    raise SystemExit('teacher-query or comparison receipt gate failed')
for arm in ('R0_VQ0', 'Seq8', 'Joint8'):
    r=(s.get('endpoints') or {}).get(arm) or {}
    if r.get('calibration') != 80 or r.get('heldout') != 80:
        raise SystemExit(f'{arm} C80 endpoint gate failed')
    if arm in ('Seq8', 'Joint8') and (r.get('updates') != 8 or r.get('exposures') != 80):
        raise SystemExit(f'{arm} training-budget gate failed')
for arm in ('H_VQ8', 'R0_W16A4'):
    if ((s.get('references') or {}).get(arm) or {}).get('heldout') != 80:
        raise SystemExit(f'{arm} reference gate failed')
PY
  then
    touch "$ARTIFACTS/PHASE_COMPLETE" || rc=65
  else
    echo 'Exit was not successful or the root final summary failed verification; no PHASE_COMPLETE marker' >&2
    (( rc != 0 )) || rc=65
    rm -f "$ARTIFACTS/PHASE_COMPLETE"
  fi
  printf '%s\n' "$rc" > "$ARTIFACTS/exit_code.txt"
  exit "$rc"
}
trap finish EXIT
trap 'exit 143' TERM INT
printf 'PBS_JOBID=%s host=%s allocation_start_epoch=%s route=g2\n' "$PBS_JOBID" "$HOST" "$FW_JOB_START_EPOCH"
grep -E '^[[:space:]]*(job_state|queue|exec_host)[[:space:]]*=' <<< "$ALLOCATION_QSTAT" || true

test -s "$ROOT/env_status.json" -a -s "$ROOT/runner.py" -a -s "$ROOT/quantization.py" -a -s "$ROOT/libero_state_loader.py"
test -d "$R128_ROOT" -a -s "$R128_ROOT/protocol.json"
test -d "$BASE/FastWAM" -a -d "$BASE/checkpoints" -a -s "$SIF"
test -s "$NEW_ROOT/protocol.json" -a -s "$NEW_ROOT/worker.py"
test -s "$RUNTIME_ARTIFACTS/runner.py" -a -s "$RUNTIME_ARTIFACTS/quantization.py" -a -s "$RUNTIME_ARTIFACTS/libero_state_loader.py"
test -s "$RUNTIME_ARTIFACTS/smooth_vq.py" -a -s "$RUNTIME_ARTIFACTS/codebook.py" -a -s "$RUNTIME_ARTIFACTS/micro_codebook.py"
test -s "$RUNTIME_ARTIFACTS/sampler.py" -a -s "$RUNTIME_ARTIFACTS/latent_reference.py" -a -s "$RUNTIME_ARTIFACTS/checkpointing.py"
test -s "$RUNTIME_ARTIFACTS/calibration_source.py" -a -s "$PARENT/train_banks.py" -a -s "$PARENT/batched_transform.py"

shopt -s nullglob
LOCAL_PY_FILES=("$NEW_ROOT"/*.py)
test "${#LOCAL_PY_FILES[@]}" -gt 0 || { echo 'No local Python sources found' >&2; exit 65; }
cp "${LOCAL_PY_FILES[@]}" "$NEW_ROOT/protocol.json" "$NEW_ROOT/run.pbs" "$NEW_ROOT/environment.sh" "$ARTIFACTS/"
for file in runner.py quantization.py libero_state_loader.py smooth_vq.py codebook.py micro_codebook.py sampler.py latent_reference.py checkpointing.py calibration_source.py; do
  if [[ ! -e "$ARTIFACTS/$file" ]]; then cp "$RUNTIME_ARTIFACTS/$file" "$ARTIFACTS/$file"; fi
done
if [[ ! -e "$ARTIFACTS/c8_train_banks.py" ]]; then cp "$PARENT/train_banks.py" "$ARTIFACTS/c8_train_banks.py"; fi
if [[ ! -e "$ARTIFACTS/batched_transform.py" ]]; then cp "$PARENT/batched_transform.py" "$ARTIFACTS/batched_transform.py"; fi

FW_CPU_THREADS=16
FW_SOFT_DEADLINE_SECONDS=28500
FW_SAVE_RESERVE_SECONDS=300
export FW_CPU_THREADS FW_SOFT_DEADLINE_SECONDS FW_SAVE_RESERVE_SECONDS
source "$ARTIFACTS/environment.sh"

test -n "${CUDA_VISIBLE_DEVICES:-}" || { echo 'No allocated GPU identifiers' >&2; exit 65; }
IFS=, read -r -a ALLOCATED_IDS <<< "$CUDA_VISIBLE_DEVICES"
test "${#ALLOCATED_IDS[@]}" -eq 2 || { echo 'Expected exactly two allocated GPUs' >&2; exit 65; }
mapfile -t GPU_UUIDS < <(nvidia-smi -i "$CUDA_VISIBLE_DEVICES" --query-gpu=uuid --format=csv,noheader \
  | awk '{gsub(/^[ \t]+|[ \t]+$/, ""); if (length) print}')
test "${#GPU_UUIDS[@]}" -eq 2 -a -n "${GPU_UUIDS[0]}" -a -n "${GPU_UUIDS[1]}" || {
  echo 'Could not resolve two allocated GPU UUIDs' >&2; exit 65;
}
GPU_UUID0=${GPU_UUIDS[0]}
GPU_UUID1=${GPU_UUIDS[1]}
printf 'ALLOCATED_GPU_UUIDS=%s,%s\n' "$GPU_UUID0" "$GPU_UUID1"
(
  while :; do
    timestamp=$(date -Is)
    nvidia-smi -i "$GPU_UUID0,$GPU_UUID1" --query-gpu=uuid,name,utilization.gpu,memory.used,memory.total --format=csv,noheader \
      | while IFS= read -r sample; do printf 'GPU_SAMPLE timestamp=%s %s\n' "$timestamp" "$sample"; done || echo GPU_SAMPLE_ERROR
    sleep 15
  done
) &
GPU_MONITOR_PID=$!

launch_worker() {
  local gpu_uuid=$1
  shift
  CUDA_VISIBLE_DEVICES="$gpu_uuid" run_python "$ARTIFACTS/worker.py" \
    --protocol "$ARTIFACTS/protocol.json" "$@"
}
run_parallel_stage() {
  local stage=$1 rc0=0 rc1=0
  launch_worker "$GPU_UUID0" --stage "$stage" --shard 0 &
  local pid0=$!
  launch_worker "$GPU_UUID1" --stage "$stage" --shard 1 &
  local pid1=$!
  wait "$pid0" || rc0=$?
  wait "$pid1" || rc1=$?
  if (( rc0 != 0 || rc1 != 0 )); then
    printf 'STAGE_FAILED stage=%s shard0_rc=%s shard1_rc=%s\n' "$stage" "$rc0" "$rc1"
    return 1
  fi
}

run_parallel_stage moments
run_parallel_stage fit
run_parallel_stage common_eval
launch_worker "$GPU_UUID0" --stage gate
launch_worker "$GPU_UUID0" --stage arm --arm Seq8 &
SEQ8_PID=$!
launch_worker "$GPU_UUID1" --stage arm --arm Joint8 &
JOINT8_PID=$!
SEQ8_RC=0
JOINT8_RC=0
wait "$SEQ8_PID" || SEQ8_RC=$?
wait "$JOINT8_PID" || JOINT8_RC=$?
if (( SEQ8_RC != 0 || JOINT8_RC != 0 )); then
  printf 'ARMS_FAILED Seq8_rc=%s Joint8_rc=%s\n' "$SEQ8_RC" "$JOINT8_RC"
  exit 1
fi
launch_worker "$GPU_UUID0" --stage finalize
