#!/bin/bash
#PBS -N fwvc13cmp
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=2:mem=8gb
#PBS -l walltime=00:10:00
#PBS -j oe
set -euo pipefail

test -n "${PBS_JOBID:-}" || { echo "PBS_JOBID is required"; exit 64; }
case "$(hostname -s)" in *login*) echo "Compute node required"; exit 64;; esac
test -s "${PBS_NODEFILE:-}" || { echo "PBS_NODEFILE is required"; exit 64; }
grep -Fqx "$(hostname -s)" <(awk -F. '{print $1}' "$PBS_NODEFILE") || {
  echo "Current host is absent from PBS_NODEFILE"; exit 64;
}

ROOT=/scratch/users/ntu/yguo017/fastwam-vq-calibration-suites-20261013
ARTIFACTS="$ROOT/artifacts/$PBS_JOBID"
OUT="$ROOT/results/comparison"
mkdir -p "$ROOT/artifacts" "$OUT"
mkdir "$ARTIFACTS"
exec > >(tee -a "$ARTIFACTS/job.log") 2>&1

finish() {
  rc=$?
  set +e
  printf '%s\n' "$rc" > "$ARTIFACTS/exit_code.txt"
  exit "$rc"
}
trap finish EXIT
qstat -f "$PBS_JOBID" > "$ARTIFACTS/allocation.txt"

module purge
module load gcc/11.4.0-nscc python/3.11.7-gcc11

copy_small() {
  local bytes
  test -f "$1"
  bytes=$(wc -c < "$1")
  [[ "$bytes" =~ ^[0-9]+$ && "$bytes" -le 262144 ]] || {
    echo "Refusing missing or oversized control file: $1"; exit 73;
  }
  cp -- "$1" "$2"
}
copy_small "$ROOT/protocol.json" "$ARTIFACTS/protocol.json"
copy_small "$ROOT/compare_calibration.py" "$ARTIFACTS/compare_calibration.py"

python3 "$ARTIFACTS/compare_calibration.py" \
  --protocol "$ARTIFACTS/protocol.json" \
  --root "$ROOT" \
  --out "$OUT"

copy_small "$OUT/comparison.json" "$ARTIFACTS/comparison.json"
copy_small "$OUT/report.md" "$ARTIFACTS/report.md"
python3 - "$ARTIFACTS" "$PBS_JOBID" <<'PY'
import json, sys
from pathlib import Path

artifact = Path(sys.argv[1])
job_id = sys.argv[2]
result = json.loads((artifact / "comparison.json").read_text(encoding="utf-8"))
report = artifact / "report.md"
assert result.get("status") == "complete"
assert result.get("comparison_pbs_jobid") == job_id
assert (artifact / "comparison.json").stat().st_size < 256 * 1024
assert report.is_file() and report.stat().st_size < 256 * 1024
(artifact / "summary.json").write_text(json.dumps({
    "status": "complete", "phase": "comparison", "protocol": result["protocol"],
    "pbs_jobid": job_id, "case_count": result["shared_test"]["case_count"],
    "query_count_per_cohort": result["shared_test"]["query_count_per_cohort"],
    "target_linears": 614, "cohorts": ["c8", "c80"],
    "comparison_bytes": (artifact / "comparison.json").stat().st_size,
    "report_bytes": report.stat().st_size,
}, indent=2) + "\n", encoding="utf-8")
PY
copy_small "$ARTIFACTS/summary.json" "$OUT/summary.json"
touch "$ARTIFACTS/PIPELINE_COMPLETE"
echo "CALIBRATION_COMPARISON_COMPLETE job_id=$PBS_JOBID output=$OUT"
