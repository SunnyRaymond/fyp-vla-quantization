#!/bin/bash
#PBS -N fwrotmem1009
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=1:mem=2gb
#PBS -l walltime=00:05:00
#PBS -j oe
set -euo pipefail
test -n "${PBS_JOBID:-}" || { echo 'PBS_JOBID required' >&2; exit 64; }
case "$(hostname -s)" in *login*) echo 'Refusing login-node execution' >&2; exit 64;; esac
test -s "${PBS_NODEFILE:-}" || { echo 'PBS_NODEFILE required' >&2; exit 64; }
grep -Fqx "$(hostname -s)" <(awk -F. '{print $1}' "$PBS_NODEFILE") || { echo 'Not in approved allocation' >&2; exit 64; }
python3 /scratch/users/ntu/yguo017/fastwam-rotation-baselines-20261008/summarize_memory.py
