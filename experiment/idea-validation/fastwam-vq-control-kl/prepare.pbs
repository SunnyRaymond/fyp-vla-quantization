#!/bin/bash
#PBS -N fwctrlprep
#PBS -P personal-yguo017
#PBS -q qdev
#PBS -l select=1:ncpus=4:mem=16gb:ngpus=0
#PBS -l walltime=00:20:00
#PBS -j oe
set -euo pipefail
test -n "${PBS_JOBID:-}" -a -s "${PBS_NODEFILE:-}"
case "$(hostname -s)" in *login*) exit 64;; esac
awk -F. -v host="$(hostname -s)" '$1 == host {found=1} END {exit !found}' "$PBS_NODEFILE"
qstat -f "$PBS_JOBID" | grep -Eq '^[[:space:]]*job_state[[:space:]]*=[[:space:]]*R([[:space:]]|$)'
NEW_ROOT=/scratch/users/ntu/yguo017/fastwam-vq-control-kl-20261021
SOURCE=/scratch/users/ntu/yguo017/fastwam-vq-softbin-relational-plus-20261020/artifacts/25886452.pbs101
ARTIFACTS=$NEW_ROOT/artifacts/$PBS_JOBID
mkdir -p "$ARTIFACTS"
export ARTIFACTS
exec > >(tee -a "$ARTIFACTS/job.log") 2>&1
finish() { rc=$?; trap - EXIT; printf '%s\n' "$rc" > "$ARTIFACTS/exit_code.txt"; exit "$rc"; }
trap finish EXIT
cp "$SOURCE/"*.py "$ARTIFACTS/"
cp "$SOURCE/aggregate.py" "$ARTIFACTS/source_aggregate.py"
for name in protocol.json prepare.py coverage_inventory.py control_common.py; do cp "$NEW_ROOT/$name" "$ARTIFACTS/"; done
module purge
module load gcc/11.4.0-nscc python/3.11.7-gcc11
case "${FW_CONTROL_UNIT:-prepare}" in
  prepare) python3 "$ARTIFACTS/prepare.py";;
  coverage_inventory) python3 "$ARTIFACTS/coverage_inventory.py";;
  *) exit 64;;
esac
touch "$ARTIFACTS/PHASE_COMPLETE"
