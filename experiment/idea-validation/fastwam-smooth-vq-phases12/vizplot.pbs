#!/bin/bash
#PBS -N fwsvvizplot
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=00:30:00
#PBS -j oe
set -euo pipefail
test -n "${PBS_JOBID:-}" || exit 64
case "$(hostname -s)" in *login*) exit 64;; esac
test -s "${PBS_NODEFILE:-}" || exit 64
grep -Fqx "$(hostname -s)" <(awk -F. '{print $1}' "$PBS_NODEFILE") || exit 64
ROOT=/scratch/users/ntu/yguo017/fastwam-libero-plus-pilot-20261005
DIAG_ROOT=/scratch/users/ntu/yguo017/fastwam-smooth-vq-phases12-20261006
BASE=/scratch/users/ntu/yguo017/fastwam-smoke
SIF=/scratch/users/ntu/yguo017/openvla-oft-vla-eval-libero/containers/libero-latest.sif
ARTIFACTS="$DIAG_ROOT/artifacts/$PBS_JOBID"
mkdir -p "$ARTIFACTS"
exec > >(tee -a "$ARTIFACTS/job.log") 2>&1
finish() {
  rc=$?
  printf '%s\n' "$rc" > "$ARTIFACTS/exit_code.txt"
  if [[ $rc -eq 0 ]]; then touch "$ARTIFACTS/PIPELINE_COMPLETE"; fi
}
trap finish EXIT
qstat -f "$PBS_JOBID" > "$ARTIFACTS/allocation.txt"
FW_REQUIRE_GPU=0
FW_CPU_THREADS=4
cp "$DIAG_ROOT/vizplot.pbs" "$DIAG_ROOT/environment.sh" "$DIAG_ROOT/plot_visualization.py" "$DIAG_ROOT/summarize_visualization.py" "$DIAG_ROOT/run_validation.py" "$ARTIFACTS/"
source "$ARTIFACTS/environment.sh"
test -s "$DIAG_ROOT/results/vizplot/summary.json"
test ! -e "$DIAG_ROOT/results/vizplot_first_25728424.pbs101"
mv -- "$DIAG_ROOT/results/vizplot" "$DIAG_ROOT/results/vizplot_first_25728424.pbs101"
run_python "$ARTIFACTS/plot_visualization.py" --data "$DIAG_ROOT/results/visualize" --full "$DIAG_ROOT/results/full" --out "$DIAG_ROOT/results/vizplot"
run_python "$ARTIFACTS/summarize_visualization.py" --data "$DIAG_ROOT/results/visualize" --full "$DIAG_ROOT/results/full" --out "$DIAG_ROOT/results/vizplot"
cp "$DIAG_ROOT/results/vizplot/summary.json" "$ARTIFACTS/summary.json"
echo VISUALIZATION_PLOTS_COMPLETE
