#!/usr/bin/env bash
#PBS -N lpwm_history
#PBS -q normal
#PBS -P personal-yguo017
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -l walltime=01:30:00
#PBS -j oe

set -Eeuo pipefail
umask 077

ROOT=/scratch/users/ntu/yguo017/lpwm-real-history
CONTROL_SOURCE="$ROOT/control/source"
CPU_PREFLIGHT="$ROOT/artifacts/25577523.pbs101/preflight.json"
ENV_IDENTITY="$ROOT/artifacts/25577523.pbs101/env_identity.pkl"
REPO=/scratch/users/ntu/yguo017/experiment/reproduction/lpwm/lpworldmodel-bdd812d
PYTHON=/scratch/users/ntu/yguo017/lewm-pusht-iteration/venv/bin/python
OVERLAY1=/scratch/users/ntu/yguo017/dino-wm-wall/artifacts/pusht-python-overlay-pusht-v5
OVERLAY2=/scratch/users/ntu/yguo017/experiment/reproduction/lpwm/runtime-overlay-minimal

fail() { printf 'GUARD_FAILURE: %s\n' "$*" >&2; exit 1; }

[[ -n "${PBS_JOBID:-}" && "$PBS_JOBID" =~ ^[[:alnum:]_.-]+$ ]] || fail 'missing or invalid PBS_JOBID'
[[ -n "${PBS_NODEFILE:-}" && -s "$PBS_NODEFILE" ]] || fail 'missing or empty PBS_NODEFILE'

HOSTNAME_FULL=$(hostname)
HOSTNAME_SHORT=${HOSTNAME_FULL%%.*}
case "${HOSTNAME_FULL,,}" in
  *login*|*head*|*submit*) fail "login/head/submit host rejected: $HOSTNAME_FULL" ;;
esac
awk -v host="$HOSTNAME_FULL" -v short="$HOSTNAME_SHORT" '
  { node=$0; sub(/\..*$/, "", node); if ($0 == host || node == short) found=1 }
  END { exit !found }
' "$PBS_NODEFILE" || fail "hostname is absent from PBS_NODEFILE: $HOSTNAME_FULL"
[[ "${CUDA_VISIBLE_DEVICES:-}" =~ ^([0-9]+|GPU-[[:alnum:]-]+)$ ]] || fail 'CUDA_VISIBLE_DEVICES must name exactly one allocated GPU'

[[ -s "$CPU_PREFLIGHT" ]] || fail "CPU preflight report is missing: $CPU_PREFLIGHT"
[[ -s "$ENV_IDENTITY" ]] || fail "environment identity bundle is missing: $ENV_IDENTITY"
[[ -f "$CONTROL_SOURCE/run_history_mechanism.py" ]] || fail 'runner is missing from control/source'
[[ -f "$CONTROL_SOURCE/run_history_mechanism.pbs" ]] || fail 'PBS wrapper is missing from control/source'
[[ -f "$CONTROL_SOURCE/FREEZE.json" ]] || fail 'FREEZE.json is missing from control/source'
[[ -f "$CONTROL_SOURCE/PROTOCOL.zh.md" ]] || fail 'PROTOCOL.zh.md is missing from control/source'
[[ -x "$PYTHON" ]] || fail "runtime Python is not executable: $PYTHON"
[[ -d "$REPO" ]] || fail "source repository is missing: $REPO"

OUT="$ROOT/artifacts/$PBS_JOBID"
mkdir -p "$ROOT/artifacts"
mkdir "$OUT" || fail "refusing to overwrite existing output directory: $OUT"
JOB_LOG="$OUT/job.log"
SNAPSHOT="$OUT/source_snapshot"
SOURCE_REFERENCE="$OUT/source_reference"
RUN_SUMMARY="$OUT/results/run_summary.json"
RUNNER_EXIT_STATUS=NOT_STARTED
GPU_MONITOR_PID=
: > "$JOB_LOG"
exec > >(tee -a "$JOB_LOG") 2>&1

finish() {
  local wrapper_status=$?
  trap - EXIT
  set +e
  if [[ -n "$GPU_MONITOR_PID" ]]; then
    kill "$GPU_MONITOR_PID" 2>/dev/null
    wait "$GPU_MONITOR_PID" 2>/dev/null
  fi
  local summary_present=NO
  [[ -s "$RUN_SUMMARY" ]] && summary_present=YES
  printf 'WRAPPER_EXIT_STATUS=%s\nRUNNER_EXIT_STATUS=%s\nRUN_SUMMARY_PRESENT=%s\n' \
    "$wrapper_status" "$RUNNER_EXIT_STATUS" "$summary_present" \
    | tee "$OUT/final_exit_status.txt"
  exit "$wrapper_status"
}
trap finish EXIT

mkdir "$SNAPSHOT" "$SOURCE_REFERENCE"
cp -p "$CONTROL_SOURCE/run_history_mechanism.py" \
  "$CONTROL_SOURCE/run_history_mechanism.pbs" \
  "$CONTROL_SOURCE/FREEZE.json" \
  "$CONTROL_SOURCE/PROTOCOL.zh.md" "$SNAPSHOT/"
cp -p "$CPU_PREFLIGHT" "$SOURCE_REFERENCE/preflight.json"
{
  printf 'CPU_PREFLIGHT_JOB=25577523.pbs101\n'
  printf 'CPU_PREFLIGHT_PATH=%s\n' "$CPU_PREFLIGHT"
  printf 'ENV_IDENTITY_PATH=%s\n' "$ENV_IDENTITY"
  printf 'ENV_IDENTITY_PRESENT=yes\n'
  printf 'SOURCE_SNAPSHOT=%s\n' "$SNAPSHOT"
} > "$SOURCE_REFERENCE/inputs.txt"

GPU_INFO=$(nvidia-smi -i "$CUDA_VISIBLE_DEVICES" \
  --query-gpu=name,uuid,memory.total --format=csv,noheader,nounits)
[[ -n "$GPU_INFO" ]] || fail 'nvidia-smi returned no GPU identity'
printf 'GPU_INFO name,uuid,memory.total: %s\n' "$GPU_INFO"

(
  while :; do
    sample_time=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
    if sample=$(nvidia-smi -i "$CUDA_VISIBLE_DEVICES" \
      --query-gpu=uuid,utilization.gpu,memory.used,memory.total \
      --format=csv,noheader,nounits 2>&1); then
      sample=${sample//$'\n'/; }
      printf '%s nvidia-smi uuid,utilization.gpu,memory.used,memory.total: %s\n' "$sample_time" "$sample"
    else
      printf '%s nvidia-smi ERROR: %s\n' "$sample_time" "$sample"
    fi
    sleep 5
  done
) >> "$JOB_LOG" 2>&1 &
GPU_MONITOR_PID=$!

export PYTHONPATH="$OVERLAY1:$OVERLAY2:$REPO${PYTHONPATH:+:$PYTHONPATH}"
export WANDB_MODE=offline PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=4
export TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1
cd "$REPO"

printf 'RUNNER_START_UTC=%s\nOUT=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$OUT"
set +e
timeout --signal=TERM --kill-after=30s 4800s "$PYTHON" \
  "$SNAPSHOT/run_history_mechanism.py" \
  --freeze "$SNAPSHOT/FREEZE.json" \
  --cpu-preflight "$CPU_PREFLIGHT" \
  --env-identity "$ENV_IDENTITY" \
  --out "$OUT"
RUNNER_EXIT_STATUS=$?
set -e
printf 'RUNNER_EXIT_STATUS=%s\n' "$RUNNER_EXIT_STATUS"
if (( RUNNER_EXIT_STATUS != 0 )); then
  exit "$RUNNER_EXIT_STATUS"
fi
[[ -s "$RUN_SUMMARY" ]] || fail "runner exited successfully without required results/run_summary.json: $RUN_SUMMARY"
printf 'RUN_SUMMARY_PRESENT=yes\n'
