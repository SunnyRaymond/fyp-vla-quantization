#!/bin/bash
#PBS -N lpwm_hist_prep
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=4:mem=32gb
#PBS -l walltime=00:25:00
#PBS -j oe

set -euo pipefail

JOB_ID=${PBS_JOBID:-}
if [ -z "$JOB_ID" ]; then
  echo "PBS_JOBID must be set by PBS" >&2
  exit 2
fi
test -n "${PBS_NODEFILE:-}" && test -f "$PBS_NODEFILE" || {
  echo "PBS_NODEFILE is missing" >&2
  exit 2
}
HOST=$(hostname -s | tr '[:upper:]' '[:lower:]')
case "$HOST" in
  *login*|*head*|*submit*) echo "refusing probable login/submit node: $HOST" >&2; exit 2 ;;
esac
NODE_SHORTS=$(awk '{name=tolower($1); sub(/\..*/, "", name); print name}' "$PBS_NODEFILE" | sort -u)
if ! printf '%s\n' "$NODE_SHORTS" | grep -Fxq "$HOST"; then
  echo "current host $HOST is not listed in PBS_NODEFILE" >&2
  exit 2
fi

TASK_ROOT=/scratch/users/ntu/yguo017/lpwm-real-history
CONTROL="$TASK_ROOT/source"
ARTIFACT_ROOT="$TASK_ROOT/artifacts"
OUT="$ARTIFACT_ROOT/$JOB_ID"
REPO=/scratch/users/ntu/yguo017/experiment/reproduction/lpwm/lpworldmodel-bdd812d
PYTHON_BIN=/scratch/users/ntu/yguo017/lewm-pusht-iteration/venv/bin/python
PUSHT_OVERLAY=/scratch/users/ntu/yguo017/dino-wm-wall/artifacts/pusht-python-overlay-pusht-v5
MINIMAL_OVERLAY=/scratch/users/ntu/yguo017/experiment/reproduction/lpwm/runtime-overlay-minimal

test ! -e "$OUT" || { echo "refusing to overwrite: $OUT" >&2; exit 2; }
for FILE in "$CONTROL/cpu_preflight.py" "$CONTROL/FREEZE.json" "$CONTROL/PROTOCOL.zh.md"; do
  test -f "$FILE" || { echo "missing required control file: $FILE" >&2; exit 2; }
done
for DIR in "$REPO" "$PUSHT_OVERLAY" "$MINIMAL_OVERLAY"; do
  test -d "$DIR" || { echo "missing required directory: $DIR" >&2; exit 2; }
done
test -x "$PYTHON_BIN"
mkdir -p "$ARTIFACT_ROOT"
mkdir "$OUT"
mkdir "$OUT/source_snapshot"
cp "$CONTROL/cpu_preflight.py" "$CONTROL/FREEZE.json" "$CONTROL/PROTOCOL.zh.md" "$OUT/source_snapshot/"
exec > >(tee -a "$OUT/job.log") 2>&1

STATUS=2
REASON=preflight_failed
finish() {
  printf 'EXIT_STATUS=%s\nSTATUS_REASON=%s\n' "$STATUS" "$REASON" > "$OUT/job_status.txt"
  printf 'EXIT_STATUS=%s\n' "$STATUS" > "$OUT/final_exit_status.txt"
}
trap finish EXIT

printf 'job_id=%s\nhost=%s\nrepo=%s\nstarted_utc=%s\n' \
  "$JOB_ID" "$HOST" "$REPO" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$OUT/execution_identity.txt"
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=4
export PYTHONPATH="$PUSHT_OVERLAY:$MINIMAL_OVERLAY:$REPO${PYTHONPATH:+:$PYTHONPATH}"

set +e
timeout --signal=TERM --kill-after=15s 1200 "$PYTHON_BIN" "$OUT/source_snapshot/cpu_preflight.py" --out "$OUT/preflight.json"
RUNNER_RC=$?
set -e
printf 'RUNNER_EXIT_STATUS=%s\n' "$RUNNER_RC"
if [ "$RUNNER_RC" -eq 0 ] && [ -s "$OUT/preflight.json" ]; then
  STATUS=0
  REASON=cpu_preflight_completed
elif [ "$RUNNER_RC" -eq 0 ]; then
  STATUS=3
  REASON=missing_preflight_report
  echo "preflight exited 0 but did not produce preflight.json" >&2
else
  STATUS=$RUNNER_RC
  REASON=cpu_preflight_failed
fi
trap - EXIT
finish
exit "$STATUS"
