#!/bin/bash
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=16:mem=110gb:ngpus=1
#PBS -l walltime=06:00:00
#PBS -j oe
source /scratch/users/ntu/yguo017/fastwam-vq-c8-latent-anchor-kl-20261021/allocation.sh
FW_SOFT_DEADLINE_SECONDS=20700
GPU_UUID=$(nvidia-smi -i "$CUDA_VISIBLE_DEVICES" --query-gpu=uuid --format=csv,noheader | tr -d '[:space:]')
test -n "$GPU_UUID"
(
  trap - EXIT
  while :; do
    printf 'GPU_SAMPLE timestamp=%s ' "$(date -Is)"
    nvidia-smi -i "$GPU_UUID" --query-gpu=uuid,name,utilization.gpu,memory.used,memory.total --format=csv,noheader || true
    sleep 15
  done
) &
GPU_MONITOR_PID=$!
export CUDA_VISIBLE_DEVICES="$GPU_UUID"
FW_CPU_THREADS=8
export FW_CPU_THREADS FW_SOFT_DEADLINE_SECONDS
cp "$NEW_ROOT/mechanism_protocol.json" "$ARTIFACTS/"
cp "$NEW_ROOT/mechanism_frozen_reader.py" "$ARTIFACTS/"
run_python "$ARTIFACTS/mechanism_worker.py"
touch "$ARTIFACTS/PHASE_COMPLETE"
