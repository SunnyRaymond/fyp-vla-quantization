#!/bin/bash
#PBS -N fwpr1012ca
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -l walltime=02:00:00
#PBS -j oe
set -euo pipefail
test -n "${PBS_JOBID:-}" || exit 64
case "$(hostname -s)" in *login*) exit 64;; esac
test -s "${PBS_NODEFILE:-}" || exit 64
grep -Fqx "$(hostname -s)" <(awk -F. '{print $1}' "$PBS_NODEFILE") || exit 64
export FW_JOB_START_EPOCH=$(date +%s)
ROOT=/scratch/users/ntu/yguo017/fastwam-prism-visualization-20261012
export ARTIFACTS="$ROOT/artifacts/$PBS_JOBID"
OUT="$ROOT/results/full"
LOCK="$ROOT/results/plot.writer-lock"
mkdir -p "$ARTIFACTS"
exec > >(tee -a "$ARTIFACTS/job.log") 2>&1
LOCK_HELD=0
finish() {
  rc=$?
  set +e
  if [[ "$LOCK_HELD" == 1 ]]; then rmdir -- "$LOCK" 2>/dev/null || true; fi
  printf '%s\n' "$rc" > "$ARTIFACTS/exit_code.txt"
}
trap finish EXIT
mkdir "$LOCK" || exit 73
LOCK_HELD=1
qstat -f "$PBS_JOBID" > "$ARTIFACTS/allocation.txt"
for name in protocol.json plot.py README.zh.md environment.sh plot.pbs; do cp -- "$ROOT/$name" "$ARTIFACTS/$name"; done
FW_REQUIRE_GPU=0
FW_CPU_THREADS=8
source "$ARTIFACTS/environment.sh"
run_python "$ARTIFACTS/plot.py" --protocol "$ARTIFACTS/protocol.json" --out "$OUT"
test -s "$OUT/plots/manifest.json"
test -s "$OUT/plots/index.html"
cp -- "$OUT/plots/manifest.json" "$ARTIFACTS/summary.json"
status=$(run_python -c 'import json,sys; print(json.load(open(sys.argv[1]))["status"])' "$OUT/plots/manifest.json")
case "$status" in
  complete) touch "$ARTIFACTS/PIPELINE_COMPLETE";;
  checkpointed) touch "$ARTIFACTS/PIPELINE_CHECKPOINTED";;
  *) exit 65;;
esac
