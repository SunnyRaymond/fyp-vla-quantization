#!/bin/bash
#PBS -N fwbi_data
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -l walltime=01:59:00
#PBS -j oe
set -euo pipefail
ROOT=/scratch/users/ntu/yguo017/fastwam-vq-bilevel-rho-20261019
SOURCE=/scratch/users/ntu/yguo017/fastwam-vq-calibration-suites-20261013
test -n "${PBS_JOBID:-}" -a -n "${PBS_NODEFILE:-}"
case "$(hostname -s)" in *login*) exit 64;; esac
awk -F. -v host="$(hostname -s)" '$1 == host {found=1} END {exit !found}' "$PBS_NODEFILE"
qstat -f "$PBS_JOBID" | grep -Eq '^[[:space:]]*job_state[[:space:]]*=[[:space:]]*R([[:space:]]|$)'
ARTIFACTS=$ROOT/artifacts/$PBS_JOBID
mkdir -p "$ARTIFACTS"
exec > >(tee -a "$ARTIFACTS/job.log") 2>&1
FW_JOB_START_EPOCH=$(date +%s)
export FW_JOB_START_EPOCH
finish() { rc=$?; trap - EXIT; printf '%s\n' "$rc" > "$ARTIFACTS/exit_code.txt"; exit "$rc"; }
trap finish EXIT
for file in protocol.json stage2_protocol.json stage2.py prepare_data.py worker.py core.py cpu.pbs; do cp "$ROOT/$file" "$ARTIFACTS/"; done
cp "$SOURCE/prepare_calibration.py" "$ARTIFACTS/render_reference.py"
cp "$SOURCE/environment.sh" "$ARTIFACTS/environment.sh"
FW_REQUIRE_GPU=0
FW_CPU_THREADS=8
FW_ALLOW_DATA_HTTP=1
FW_SOFT_DEADLINE_SECONDS=6300
source "$ARTIFACTS/environment.sh"
if [[ "$FW_BILEVEL_UNIT" == data_prepare ]]; then
  run_python "$ARTIFACTS/prepare_data.py"
elif [[ "$FW_BILEVEL_UNIT" == stage2_compare ]]; then
  run_python "$ARTIFACTS/stage2.py" --unit "$FW_BILEVEL_UNIT" --protocol "$ARTIFACTS/protocol.json" --stage2-protocol "$ARTIFACTS/stage2_protocol.json"
else
  run_python "$ARTIFACTS/worker.py" --unit "$FW_BILEVEL_UNIT" --protocol "$ARTIFACTS/protocol.json"
fi
touch "$ARTIFACTS/PHASE_COMPLETE"
