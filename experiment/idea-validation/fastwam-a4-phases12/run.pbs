#!/bin/bash
#PBS -N fw12gpu
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=16:mem=110gb:ngpus=1
#PBS -l walltime=01:50:00
#PBS -j oe
set -euo pipefail
test -n "${PBS_JOBID:-}" || exit 64
case "$(hostname -s)" in *login*) exit 64;; esac
test -s "${PBS_NODEFILE:-}" || exit 64
grep -Fqx "$(hostname -s)" <(awk -F. '{print $1}' "$PBS_NODEFILE") || exit 64
ROOT=/scratch/users/ntu/yguo017/fastwam-libero-plus-pilot-20261005
DIAG_ROOT=/scratch/users/ntu/yguo017/fastwam-a4-phases12-20261006
BASE=/scratch/users/ntu/yguo017/fastwam-smoke
SIF=/scratch/users/ntu/yguo017/openvla-oft-vla-eval-libero/containers/libero-latest.sif
ARTIFACTS="$DIAG_ROOT/artifacts/$PBS_JOBID"
mkdir -p "$ARTIFACTS"
exec > >(tee -a "$ARTIFACTS/job.log") 2>&1
finish() {
  rc=$?
  if [[ -n "${GPU_MONITOR_PID:-}" ]]; then kill "$GPU_MONITOR_PID" 2>/dev/null || true; wait "$GPU_MONITOR_PID" 2>/dev/null || true; fi
  printf '%s\n' "$rc" > "$ARTIFACTS/exit_code.txt"
  if [[ $rc -eq 0 ]]; then touch "$ARTIFACTS/PIPELINE_COMPLETE"; fi
}
trap finish EXIT
qstat -f "$PBS_JOBID" > "$ARTIFACTS/allocation.txt"
FW_REQUIRE_GPU=1
test -s "$DIAG_ROOT/plan.json"
cp "$DIAG_ROOT/run.pbs" "$DIAG_ROOT/environment.sh" "$DIAG_ROOT/run_diagnostic.py" "$DIAG_ROOT/stage_quantization.py" "$DIAG_ROOT/plan.json" "$DIAG_ROOT/protocol.json" "$ARTIFACTS/"
cp "$ROOT/runner.py" "$ROOT/quantization.py" "$ROOT/libero_state_loader.py" "$ARTIFACTS/"
source "$ARTIFACTS/environment.sh"
test -n "${CUDA_VISIBLE_DEVICES:-}" || exit 65
run_python - "$CUDA_VISIBLE_DEVICES" <<'PY_GPU'
import sys, torch
mask=sys.argv[1]
assert mask.startswith('GPU-') and ',' not in mask, mask
assert torch.cuda.device_count()==1, torch.cuda.device_count()
props=torch.cuda.get_device_properties(0)
cap=torch.cuda.get_device_capability(0)
assert cap[0]>=8, cap
actual=str(props.uuid)
assert actual.removeprefix('GPU-').lower()==mask.removeprefix('GPU-').lower(), (mask,actual)
print('Allocated GPU verified:', props.name, actual, f'SM{cap[0]}{cap[1]}', flush=True)
PY_GPU
(
  while :; do
    printf 'GPU_SAMPLE timestamp=%s ' "$(date -Is)"
    nvidia-smi -i "$CUDA_VISIBLE_DEVICES" --query-gpu=uuid,name,utilization.gpu,memory.used,memory.total --format=csv,noheader || echo GPU_SAMPLE_ERROR
    sleep 15
  done
) &
GPU_MONITOR_PID=$!
CASE_ID=${FW_CASE_ID:-${PBS_ARRAY_INDEX:-}}
[[ "$CASE_ID" =~ ^[0-9]+$ ]] || exit 64
(( CASE_ID >= 0 && CASE_ID <= 21 )) || exit 64
run_python "$ARTIFACTS/run_diagnostic.py" --case-id "$CASE_ID" --diag-root "$DIAG_ROOT" --plan "$ARTIFACTS/plan.json"
printf -v CASE_DIR 'case_%02d' "$CASE_ID"
cp "$DIAG_ROOT/results/$CASE_DIR/case_summary.json" "$ARTIFACTS/case_summary.json"
echo PHASE12_GPU_CASE_COMPLETE
