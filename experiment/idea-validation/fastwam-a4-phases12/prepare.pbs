#!/bin/bash
#PBS -N fw_a4inputs
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=2:mem=8gb
#PBS -l walltime=00:30:00
#PBS -j oe
set -euo pipefail
test -n "${PBS_JOBID:-}" || exit 64
case "$(hostname -s)" in *login*) exit 64;; esac
test -s "${PBS_NODEFILE:-}" || exit 64
grep -Fqx "$(hostname -s)" <(awk -F. '{print $1}' "$PBS_NODEFILE") || exit 64
ROOT=/scratch/users/ntu/yguo017/fastwam-libero-plus-pilot-20261005
DIAG_ROOT=/scratch/users/ntu/yguo017/fastwam-a4-phases12-20261006
BASE=/scratch/users/ntu/yguo017/fastwam-smoke
SIF=/scratch/users/ntu/yguo017/openvla-oft-vla-eval-libero/containers/libero-latest.sif
ARTIFACTS="$DIAG_ROOT/artifacts/$PBS_JOBID"
mkdir -p "$ARTIFACTS"
exec > >(tee -a "$ARTIFACTS/job.log") 2>&1
finish() {
  rc=$?
  if [[ -n "${GPU_MONITOR_PID:-}" ]]; then kill "$GPU_MONITOR_PID" 2>/dev/null || true; wait "$GPU_MONITOR_PID" 2>/dev/null || true; fi
  printf '%s\n' "$rc" > "$ARTIFACTS/exit_code.txt"
  if [[ $rc -eq 0 ]]; then touch "$ARTIFACTS/PIPELINE_COMPLETE"; fi
}
trap finish EXIT
qstat -f "$PBS_JOBID" > "$ARTIFACTS/allocation.txt"
FW_REQUIRE_GPU=0
FW_CPU_THREADS=2
cp "$DIAG_ROOT/prepare.pbs" "$DIAG_ROOT/environment.sh" "$DIAG_ROOT/prepare_inputs.py" "$ARTIFACTS/"
cp "$DIAG_ROOT/stage_quantization.py" "$DIAG_ROOT/test_stage_quantization.py" "$DIAG_ROOT/run_diagnostic.py" "$DIAG_ROOT/test_run_diagnostic.py" "$ARTIFACTS/"
cp "$ROOT/prepare_manifest.py" "$ROOT/libero_state_loader.py" "$ARTIFACTS/"
source "$ARTIFACTS/environment.sh"
run_python "$ARTIFACTS/test_stage_quantization.py"
run_python "$ARTIFACTS/test_run_diagnostic.py"
run_python "$ARTIFACTS/prepare_inputs.py" --control-test
run_python "$ARTIFACTS/prepare_inputs.py" --out "$DIAG_ROOT"
cp "$DIAG_ROOT/plan.json" "$ARTIFACTS/plan.json"
echo INPUT_FREEZE_COMPLETE
