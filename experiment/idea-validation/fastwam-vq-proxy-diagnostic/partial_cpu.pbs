#!/bin/bash
#PBS -N fwvppartcpu
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=8:mem=64gb
#PBS -l walltime=01:00:00
#PBS -j oe
set -euo pipefail
test -n "${PBS_JOBID:-}" || exit 64
case "$(hostname -s)" in *login*) exit 64;; esac
test -s "${PBS_NODEFILE:-}" || exit 64
grep -Fqx "$(hostname -s)" <(awk -F. '{print $1}' "$PBS_NODEFILE") || exit 64
ROOT=/scratch/users/ntu/yguo017/fastwam-vq-proxy-diagnostic-20261010
SOURCE_CAMPAIGN=/scratch/users/ntu/yguo017/fastwam-vq-action-aware-20261009
ARTIFACTS="$ROOT/artifacts/$PBS_JOBID"
mkdir "$ARTIFACTS"
exec > >(tee -a "$ARTIFACTS/job.log") 2>&1
trap 'printf "%s\n" "$?" > "$ARTIFACTS/exit_code.txt"' EXIT
for name in partial_cpu.py run_diagnostic.py protocol.json environment.sh; do
  test "$(wc -c < "$ROOT/$name")" -le 262144
  cp -- "$ROOT/$name" "$ARTIFACTS/$name"
done
for name in run_experiment.py codebook.py; do
  test "$(wc -c < "$SOURCE_CAMPAIGN/$name")" -le 262144
  cp -- "$SOURCE_CAMPAIGN/$name" "$ARTIFACTS/$name"
done
FW_REQUIRE_GPU=0
FW_CPU_THREADS=8
source "$ARTIFACTS/environment.sh"
run_python "$ARTIFACTS/partial_cpu.py"
