#!/bin/bash
#PBS -N wam_activation_bits
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=16:mem=110gb:ngpus=1
#PBS -l walltime=02:00:00
#PBS -j oe
set -euo pipefail

test -n "${PBS_JOBID:-}" || exit 64
test -n "${PBS_NODEFILE:-}" && test -r "$PBS_NODEFILE" || exit 64
HOST=$(hostname -s)
case "$HOST" in *login*) exit 64;; esac
awk -v host="$HOST" '{split($1,a,"."); if(a[1]==host) found=1} END {exit !found}' "$PBS_NODEFILE" || exit 64
qstat -f "$PBS_JOBID" > "/tmp/wam-bits-allocation-$PBS_JOBID.txt"
grep -Eq 'job_state = R' "/tmp/wam-bits-allocation-$PBS_JOBID.txt" || exit 64

ROOT=/scratch/users/ntu/yguo017/wam-activation-bits-20261004
FOLLOWUP_ROOT=/scratch/users/ntu/yguo017/wam-paired-followup-20261003
SCREEN_ROOT=/scratch/users/ntu/yguo017/wam-phase-screen-20261003
BASE=/scratch/users/ntu/yguo017/fastwam-smoke
OTC_ROOT=/scratch/users/ntu/yguo017/otc-ptq-phase1
OLD_ARTIFACTS="$SCREEN_ROOT/artifacts/25666715.pbs101"
ARTIFACTS="$ROOT/artifacts/$PBS_JOBID"
mkdir -p "$ARTIFACTS"
exec > >(tee "$ARTIFACTS/job.log") 2>&1
GPU_MONITOR_PID=
finish() {
  rc=$?
  trap - EXIT
  if [[ -n "${GPU_MONITOR_PID:-}" ]]; then
    kill "$GPU_MONITOR_PID" 2>/dev/null || true
    wait "$GPU_MONITOR_PID" 2>/dev/null || true
  fi
  printf '%s\n' "$rc" > "$ARTIFACTS/exit_code.txt"
  return "$rc"
}
trap finish EXIT
cp "/tmp/wam-bits-allocation-$PBS_JOBID.txt" "$ARTIFACTS/allocation.txt"

case "${MODE:-}" in
  calibrate-phase|calibrate-direct|evaluate) ;;
  *) echo 'MODE must be calibrate-phase, calibrate-direct or evaluate'; exit 64 ;;
esac
case "${BITS:-}" in 4|8) ;; *) exit 64;; esac
cp "$ROOT/activation_screen.py" "$ROOT/quant.py" "$ROOT/PREREG.zh.md" "$ROOT/run.pbs" "$ARTIFACTS/"
cp "$SCREEN_ROOT/runner.py" "$FOLLOWUP_ROOT/decompose.py" "$ARTIFACTS/"
cp "$OTC_ROOT/identity_gate.py" "$OTC_ROOT/source_identity.json" "$OTC_ROOT/manifest.json" "$ARTIFACTS/"
cp "$OLD_ARTIFACTS/locked_selection.json" "$ARTIFACTS/locked_selection.json"
SELECTION_ARGS=()
if [[ "$MODE" == evaluate && "$BITS" == 4 ]]; then
  for job in "${PHASE_JOB:?phase job required}" "${DIRECT_JOB:?direct job required}"; do
    [[ "$job" =~ ^[0-9]+\.pbs101$ ]] || exit 64
    test -f "$ROOT/artifacts/$job/PIPELINE_COMPLETE"
    test "$(cat "$ROOT/artifacts/$job/exit_code.txt")" = 0
  done
  cp "$ROOT/artifacts/$PHASE_JOB/selection.json" "$ARTIFACTS/phase_selection.json"
  cp "$ROOT/artifacts/$DIRECT_JOB/selection.json" "$ARTIFACTS/direct_selection.json"
  SELECTION_ARGS=(--phase-selection "$ARTIFACTS/phase_selection.json" --direct-selection "$ARTIFACTS/direct_selection.json")
fi

module purge
module load gcc/11.4.0-nscc python/3.11.7-gcc11 apptainer/1.5.0 cuda/12.2.2
test -n "${CUDA_VISIBLE_DEVICES:-}" || exit 65
SIF=/scratch/users/ntu/yguo017/openvla-oft-vla-eval-libero/containers/libero-latest.sif
date
hostname

run_python() {
  apptainer exec --cleanenv --nv \
    --bind "$PBS_NODEFILE:$PBS_NODEFILE:ro" \
    --bind /scratch,/scratch/GPFS/app/apps:/app/apps \
    --bind /usr/lib64/libffi.so.6:/usr/lib/x86_64-linux-gnu/libffi.so.6 \
    --bind /usr/lib64/libssl.so.1.1:/usr/lib/x86_64-linux-gnu/libssl.so.1.1 \
    --bind /usr/lib64/libcrypto.so.1.1:/usr/lib/x86_64-linux-gnu/libcrypto.so.1.1 \
    --env "LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu:/.singularity.d/libs:${LD_LIBRARY_PATH:-}" \
    --env "CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES" \
    --env "PBS_JOBID=$PBS_JOBID,PBS_NODEFILE=$PBS_NODEFILE,OTC_ALLOCATION_HOST=$HOST,ARTIFACTS=$ARTIFACTS" \
    --env "PYTHONPATH=$ARTIFACTS:$BASE/libero-compat:$BASE/libero:$BASE/FastWAM:$BASE/FastWAM/src:$BASE/FastWAM/experiments/libero" \
    --env "LIBERO_CONFIG_PATH=$BASE/libero-config" \
    --env "DIFFSYNTH_MODEL_BASE_PATH=$BASE/model-cache" \
    --env DIFFSYNTH_DOWNLOAD_SOURCE=huggingface,DIFFSYNTH_SKIP_DOWNLOAD=true,HF_HUB_OFFLINE=1 \
    --env "HF_HOME=$BASE/cache/huggingface" \
    --env MUJOCO_GL=osmesa,PYOPENGL_PLATFORM=osmesa,LIBGL_ALWAYS_SOFTWARE=1 \
    --env OMP_NUM_THREADS=8,OPENBLAS_NUM_THREADS=8,LP_NUM_THREADS=8 \
    --env GIT_PYTHON_REFRESH=quiet,PYTHONUNBUFFERED=1,TOKENIZERS_PARALLELISM=false \
    "$SIF" "$BASE/venv/bin/python" "$@"
}

run_python "$ARTIFACTS/identity_gate.py"
run_python - <<'PY'
import os
import torch
mask = os.environ['CUDA_VISIBLE_DEVICES']
assert mask.startswith('GPU-') and ',' not in mask, mask
assert torch.cuda.device_count() == 1
props = torch.cuda.get_device_properties(0)
actual = str(props.uuid)
assert actual.removeprefix('GPU-').lower() == mask.removeprefix('GPU-').lower(), (mask, actual)
print('allocated GPU:', props.name, props.total_memory, actual, flush=True)
PY

(
  while :; do
    printf 'GPU_SAMPLE timestamp=%s ' "$(date -Is)"
    nvidia-smi -i "$CUDA_VISIBLE_DEVICES" \
      --query-gpu=uuid,name,utilization.gpu,memory.used,memory.total \
      --format=csv,noheader || echo 'GPU_SAMPLE_ERROR'
    sleep 15
  done
) &
GPU_MONITOR_PID=$!

run_python "$ARTIFACTS/activation_screen.py" --mode "$MODE" --bits "$BITS" --out "$ARTIFACTS" \
  --locked "$ARTIFACTS/locked_selection.json" --data "$OLD_ARTIFACTS/frozen_observations.pt" "${SELECTION_ARGS[@]}"
touch "$ARTIFACTS/PIPELINE_COMPLETE"
date
