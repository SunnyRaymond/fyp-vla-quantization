#!/bin/bash
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=16:mem=110gb:ngpus=1
#PBS -l walltime=00:45:00
#PBS -j oe
set -euo pipefail
NEW_ROOT=/scratch/users/ntu/yguo017/fastwam-vq-kl-mse-warmstart-20261020
PARENT=/scratch/users/ntu/yguo017/fastwam-vq-c8-action-latent-plus-20261015
ROOT=/scratch/users/ntu/yguo017/fastwam-libero-plus-pilot-20261005
DIAG_ROOT=$NEW_ROOT
SMOOTH_ROOT=/scratch/users/ntu/yguo017/fastwam-smooth-vq-phases12-20261006
SOURCE_ROOT=/scratch/users/ntu/yguo017/fastwam-a4-phases12-20261006
BASE=/scratch/users/ntu/yguo017/fastwam-smoke
SIF=/scratch/users/ntu/yguo017/openvla-oft-vla-eval-libero/containers/libero-latest.sif
SOURCE_ARTIFACTS=/scratch/users/ntu/yguo017/fastwam-vq-dual-kl-20261019/artifacts/25878493.pbs101
test -n "${PBS_JOBID:-}" -a -n "${PBS_NODEFILE:-}"
case "$(hostname -s)" in *login*) exit 64;; esac
awk -F. -v host="$(hostname -s)" '$1 == host {found=1} END {exit !found}' "$PBS_NODEFILE"
qstat -f "$PBS_JOBID" | grep -Eq '^[[:space:]]*job_state[[:space:]]*=[[:space:]]*R([[:space:]]|$)'
ARTIFACTS=$NEW_ROOT/artifacts/$PBS_JOBID
mkdir -p "$ARTIFACTS"
export ARTIFACTS
exec > >(tee -a "$ARTIFACTS/job.log") 2>&1
FW_JOB_START_EPOCH=$(date +%s)
export FW_JOB_START_EPOCH
GPU_UUID=$(nvidia-smi -i "$CUDA_VISIBLE_DEVICES" --query-gpu=uuid --format=csv,noheader | tr -d '[:space:]')
test -n "$GPU_UUID"
(
 while :; do
  printf 'GPU_SAMPLE timestamp=%s ' "$(date -Is)"
  nvidia-smi -i "$GPU_UUID" --query-gpu=uuid,name,utilization.gpu,memory.used,memory.total --format=csv,noheader || true
  sleep 15
 done
) &
GPU_MONITOR_PID=$!
finish() { rc=$?; trap - EXIT; kill "$GPU_MONITOR_PID" 2>/dev/null || true; wait "$GPU_MONITOR_PID" 2>/dev/null || true; printf '%s\n' "$rc" > "$ARTIFACTS/exit_code.txt"; exit "$rc"; }
trap finish EXIT
cp "$SOURCE_ARTIFACTS/"*.py "$ARTIFACTS/"
cp "$SOURCE_ARTIFACTS/source_protocol.json" "$ARTIFACTS/"
DIAGNOSTIC_ARTIFACTS=/scratch/users/ntu/yguo017/fastwam-vq-kl-direction-20261019/artifacts/25881169.pbs101
for file in direction_utils.py direction_selfcheck.py; do cp "$DIAGNOSTIC_ARTIFACTS/$file" "$ARTIFACTS/"; done
for file in protocol.json worker.py; do cp "$NEW_ROOT/$file" "$ARTIFACTS/"; done
cp "$SOURCE_ARTIFACTS/environment.sh" "$ARTIFACTS/"
source "$ARTIFACTS/environment.sh"
FW_CPU_THREADS=8
FW_SOFT_DEADLINE_SECONDS=${FW_REFINE_SOFT_DEADLINE_SECONDS:-6960}
export FW_CPU_THREADS FW_SOFT_DEADLINE_SECONDS
export CUDA_VISIBLE_DEVICES="$GPU_UUID"
run_python "$ARTIFACTS/direction_selfcheck.py"
run_python "$ARTIFACTS/worker.py" --unit "$FW_REFINE_UNIT" --protocol "$ARTIFACTS/protocol.json"
touch "$ARTIFACTS/PHASE_COMPLETE"
