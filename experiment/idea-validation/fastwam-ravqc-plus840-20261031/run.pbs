#!/bin/bash
#PBS -P personal-yguo017
#PBS -j oe
# 840-episode closed loop of the RAVQ arms on one g2 node (2 GPUs, two worker slots per GPU):
#   1. gate.py waits for the calibration job's DECISION.json and keeps the uncalibrated RAVQU arms and the calibrated
#      arms whose held-out mixed loss is not above their uncalibrated base; the job's protocol copy gets arm_order = the
#      kept arms
#   2. t5_merge.py (after the panel-C job's T5 cache exists) merges the A16 and panel-C T5 caches
#   3. slots pull arms from sched.py (most unclaimed episodes per worker; reload only while worth it)
#   4. analysis_840.py: the 840 table against BF16 and the W2/W3 QTIP, GPTVQ, QuIP# arms
# Episodes are saved one by one, so a resubmitted job continues where this one stopped.
set -euo pipefail

NEW_ROOT=/scratch/users/ntu/yguo017/fastwam-ravqc-plus840-20261031
die() { echo "ERROR: $*" >&2; exit 64; }
test -n "${PBS_JOBID:-}" -a -s "${PBS_NODEFILE:-}" || die 'PBS allocation required'
HOST=$(hostname -s)
case "$HOST" in *login*) die 'Refusing login-node execution';; esac
awk -F. -v host="$HOST" '$1 == host {found=1} END {exit !found}' "$PBS_NODEFILE" || die 'Host outside the PBS allocation'

mapfile -t CFG < <(python3 - "$NEW_ROOT/protocol.json" <<'PY'
import json, sys
p = json.load(open(sys.argv[1]))
a = json.load(open(p["a16"]["protocol"]))
r, al, s = a["roots"], p["allocation"], p["schedule"]
for value in (al["execution_queue"], al["gpus"], s["slots_per_gpu"], p["a16"]["root"], " ".join(p["a16"]["sources"]),
              r["pilot"], r["base"], r["old_banks"], r["old_inputs"], r["sif"], r["engine_source"],
              " ".join(a["engine_files"]), p["panel_c"]["t5_complete"]):
    print(value)
PY
)
test "${#CFG[@]}" -eq 13 || die 'Malformed protocol'
EXEC_QUEUE=${CFG[0]}; GPUS=${CFG[1]}; SLOTS_PER_GPU=${CFG[2]}; A16_ROOT=${CFG[3]}; read -r -a A16_SOURCES <<< "${CFG[4]}"
ROOT=${CFG[5]}; BASE=${CFG[6]}; SMOOTH_ROOT=${CFG[7]}; SOURCE_ROOT=${CFG[8]}; SIF=${CFG[9]}
ENGINE_SOURCE=${CFG[10]}; read -r -a ENGINE_FILES <<< "${CFG[11]}"; PANELC_T5=${CFG[12]}

ALLOCATION_QSTAT=$(qstat -f "$PBS_JOBID") || die 'Cannot read the live PBS allocation'
grep -Eq '^[[:space:]]*job_state[[:space:]]*=[[:space:]]*R([[:space:]]|$)' <<< "$ALLOCATION_QSTAT" || die 'Job not running'
grep -Eq "^[[:space:]]*queue[[:space:]]*=[[:space:]]*${EXEC_QUEUE}([[:space:]]|$)" <<< "$ALLOCATION_QSTAT" \
  || die "PBS did not route this job to $EXEC_QUEUE"
NCPUS=$(awk -F= '/^[[:space:]]*Resource_List.ncpus[[:space:]]*=/ {gsub(/[[:space:]]/, "", $2); print $2}' <<< "$ALLOCATION_QSTAT")
[[ "$NCPUS" =~ ^[0-9]+$ ]] || die "Cannot read Resource_List.ncpus ('$NCPUS')"

DIAG_ROOT=$NEW_ROOT
ARTIFACTS=$NEW_ROOT/artifacts/$PBS_JOBID
RESULTS=$NEW_ROOT/results
FW_JOB_START_EPOCH=$(date +%s)
NODE_TAG=node0
export NEW_ROOT ROOT BASE SMOOTH_ROOT SOURCE_ROOT DIAG_ROOT SIF ARTIFACTS RESULTS FW_JOB_START_EPOCH NODE_TAG
mkdir -p "$ARTIFACTS" "$RESULTS"
exec > >(tee -a "$ARTIFACTS/job.log") 2>&1
printf '%s\n' "$ALLOCATION_QSTAT" > "$ARTIFACTS/allocation.txt"
echo "JOB=$PBS_JOBID QUEUE=$EXEC_QUEUE HOST=$HOST NCPUS=$NCPUS START=$(date -u +%Y-%m-%dT%H:%M:%SZ)"

MONITOR_PID=
SLOT_PIDS=()
finish() {
  local rc=$?
  trap - EXIT TERM INT
  set +e
  (( rc == 0 )) || [[ -e "$ARTIFACTS/FAILED" ]] || printf '%s node0 run.pbs exited %s\n' "$(date -u +%FT%TZ)" "$rc" >> "$ARTIFACTS/FAILED"
  for pid in "${SLOT_PIDS[@]:-}"; do [[ -n "$pid" ]] && { pkill -TERM -P "$pid" 2>/dev/null; kill -TERM "$pid" 2>/dev/null; }; done
  [[ -n "$MONITOR_PID" ]] && kill "$MONITOR_PID" 2>/dev/null
  printf '%s\n' "$rc" > "$ARTIFACTS/exit_code.txt"
  exit "$rc"
}
trap finish EXIT
trap 'exit 143' TERM INT

for name in protocol.json run.pbs slots.sh panel.py sched.py t5_merge.py gate.py panel_worker.py analysis_840.py; do
  test -s "$NEW_ROOT/$name" || die "Uploaded source missing: $name"
  cp "$NEW_ROOT/$name" "$ARTIFACTS/"
done
for name in "${A16_SOURCES[@]}"; do
  test -s "$A16_ROOT/$name" || die "A16 source missing: $name"
  cp "$A16_ROOT/$name" "$ARTIFACTS/"
done
for name in "${ENGINE_FILES[@]}"; do
  test -s "$ENGINE_SOURCE/$name" || die "Missing engine dependency: $name"
  cp "$ENGINE_SOURCE/$name" "$ARTIFACTS/"
done

if [[ -n "${CUDA_VISIBLE_DEVICES:-}" ]]; then
  IFS=, read -r -a GPU_IDS <<< "$CUDA_VISIBLE_DEVICES"
  test "${#GPU_IDS[@]}" -eq "$GPUS" || die "Expected $GPUS GPUs, got ${#GPU_IDS[@]}"
  GPU_UUIDS=()
  for gpu in "${GPU_IDS[@]}"; do GPU_UUIDS+=("$(nvidia-smi -i "$gpu" --query-gpu=uuid --format=csv,noheader | tr -d '[:space:]')"); done
else
  mapfile -t GPU_UUIDS < <(nvidia-smi --query-gpu=uuid --format=csv,noheader | tr -d '[:blank:]')
  test "${#GPU_UUIDS[@]}" -eq "$GPUS" || die "No CUDA_VISIBLE_DEVICES and nvidia-smi shows ${#GPU_UUIDS[@]} GPUs"
fi
for uuid in "${GPU_UUIDS[@]}"; do [[ "$uuid" == GPU-* ]] || die "Bad GPU UUID '$uuid'"; done

source "$ARTIFACTS/environment.sh"
source "$ARTIFACTS/slots.sh"
command -v python3.11 > /dev/null || die "python3.11 missing after module load"
monitor "$NCPUS" "${GPU_UUIDS[@]}" & MONITOR_PID=$!

GATE_OUT=$(python3.11 "$ARTIFACTS/gate.py" --protocol "$ARTIFACTS/protocol.json") || die 'gate failed'
echo "$GATE_OUT"
read -r -a ARMS <<< "$(sed -n 's/^RUN *//p' <<< "$GATE_OUT")"
if (( ${#ARMS[@]} == 0 )); then echo 'GATE no arm passed: nothing to run'; touch "$ARTIFACTS/PIPELINE_COMPLETE"; exit 0; fi

waited=0
until [[ -s "$PANELC_T5" ]]; do  # the panel-C job writes its T5 cache first
  (( waited < 7200 )) || die "Panel-C T5 cache missing after 2 h: $PANELC_T5"
  sleep 60; waited=$(( waited + 60 ))
done
FW_CPU_THREADS=4 run_python "$ARTIFACTS/t5_merge.py" --protocol "$ARTIFACTS/protocol.json" || die 'T5 merge failed'

python3.11 "$ARTIFACTS/sched.py" init --protocol "$ARTIFACTS/protocol.json"
python3.11 "$ARTIFACTS/sched.py" status --protocol "$ARTIFACTS/protocol.json"

SLOTS=$(( GPUS * SLOTS_PER_GPU ))
THREADS=$(( NCPUS / SLOTS > 0 ? NCPUS / SLOTS : 1 ))
echo "SLOTS=$SLOTS THREADS=$THREADS ARMS=${ARMS[*]}"
for (( slot = 0; slot < SLOTS; slot++ )); do
  (( slot > 0 )) && sleep 10
  slot_loop "$slot" "${GPU_UUIDS[$(( slot / SLOTS_PER_GPU ))]}" "$THREADS" & SLOT_PIDS+=("$!")
done

supervise "${SLOT_PIDS[@]}" || die 'A slot failed (see FAILED)'
SLOT_PIDS=()
echo "SLOTS_DONE $(date -u +%H:%M:%S)"
python3.11 "$ARTIFACTS/sched.py" status --protocol "$ARTIFACTS/protocol.json"

python3.11 "$ARTIFACTS/analysis_840.py" --protocol "$ARTIFACTS/protocol.json"
for arm in "${ARMS[@]}"; do date -u +%Y-%m-%dT%H:%M:%SZ > "$RESULTS/loops/$arm/DONE"; done
cat "$RESULTS/RESULTS.zh.md"
touch "$ARTIFACTS/PIPELINE_COMPLETE"
echo PIPELINE_COMPLETE
