#!/bin/bash
#PBS -N fwcl17agg
#PBS -P personal-yguo017
#PBS -q qdev
#PBS -l select=1:ncpus=1:mem=4gb:ngpus=0
#PBS -l walltime=00:10:00
#PBS -j oe
set -euo pipefail
NEW_ROOT=/scratch/users/ntu/yguo017/fastwam-vq-activation-clipping-20261017
PARENT=/scratch/users/ntu/yguo017/fastwam-vq-c8-action-latent-plus-20261015
test -n "${PBS_JOBID:-}" -a -n "${PBS_NODEFILE:-}"
case "$(hostname -s)" in *login*) exit 64;; esac
awk -F. -v host="$(hostname -s)" '$1 == host {found=1} END {exit !found}' "$PBS_NODEFILE"
ARTIFACTS=$NEW_ROOT/artifacts/$PBS_JOBID
mkdir -p "$ARTIFACTS"
exec > >(tee -a "$ARTIFACTS/job.log") 2>&1
trap 'rc=$?; printf "%s\n" "$rc" > "$ARTIFACTS/exit_code.txt"' EXIT
module purge
module load gcc/11.4.0-nscc python/3.11.7-gcc11
export PYTHONPATH="$PARENT/artifacts/25814264.pbs101"
if [[ "${FW_CLIP_PHASE:-}" == validate_prepare ]]; then
  python3 "$NEW_ROOT/experiment.py" --phase validate-prepare --source-job "$FW_VALIDATE_SOURCE_JOB" --protocol "$NEW_ROOT/protocol.json"
else
  python3 "$NEW_ROOT/experiment.py" --phase aggregate --protocol "$NEW_ROOT/protocol.json"
fi
touch "$ARTIFACTS/PHASE_COMPLETE"
