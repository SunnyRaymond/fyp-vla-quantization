#!/bin/bash
#PBS -P personal-yguo017
#PBS -q qdev
#PBS -l select=1:ncpus=4:mem=32gb:ngpus=0
#PBS -l walltime=00:45:00
#PBS -j oe
source /scratch/users/ntu/yguo017/fastwam-vq-teacher-anchor-kl-20261021/allocation.sh
NV_ARGS=()
FW_CPU_THREADS=4
FW_SOFT_DEADLINE_SECONDS=2520
export FW_CPU_THREADS FW_SOFT_DEADLINE_SECONDS
case "$FW_AK_UNIT" in
 prepare)
  run_python "$ARTIFACTS/anchor_selfcheck.py"
  run_python "$ARTIFACTS/prepare.py" --protocol "$ARTIFACTS/protocol.json";;
 closedloop_prepare) run_python "$ARTIFACTS/closedloop_prepare.py" --protocol "$ARTIFACTS/protocol.json";;
 aggregate) run_python "$ARTIFACTS/aggregate.py" --protocol "$ARTIFACTS/protocol.json";;
 closedloop_aggregate) run_python "$ARTIFACTS/closedloop_aggregate.py" --protocol "$ARTIFACTS/protocol.json";;
 *) exit 64;;
esac
touch "$ARTIFACTS/PHASE_COMPLETE"
