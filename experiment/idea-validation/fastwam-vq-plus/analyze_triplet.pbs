#!/bin/bash
#PBS -N fwvqtri1013
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=1:mem=4gb
#PBS -l walltime=00:05:00
#PBS -j oe
set -euo pipefail
test -n "${PBS_JOBID:-}" || exit 64
case "$(hostname -s)" in *login*) exit 64;; esac
test -s "${PBS_NODEFILE:-}" || exit 64
grep -Fqx "$(hostname -s)" <(awk -F. '{print $1}' "$PBS_NODEFILE") || exit 64
TASK_ROOT=/scratch/users/ntu/yguo017/fastwam-vq-plus-20261012/analysis/triplet-20261013
ARTIFACTS="$TASK_ROOT/artifacts/$PBS_JOBID"
mkdir -p "$ARTIFACTS"
exec > >(tee -a "$ARTIFACTS/job.log") 2>&1
finish() { rc=$?; printf '%s\n' "$rc" > "$ARTIFACTS/exit_code.txt"; }
trap finish EXIT
qstat -f "$PBS_JOBID" > "$ARTIFACTS/allocation.txt"
cp "$TASK_ROOT/analyze_triplet.py" "$TASK_ROOT/run.pbs" "$ARTIFACTS/"
module purge
module load gcc/11.4.0-nscc python/3.11.7-gcc11
python3 "$ARTIFACTS/analyze_triplet.py" --out "$ARTIFACTS"
test -s "$ARTIFACTS/triplet_analysis.json" -a -s "$ARTIFACTS/triplet_cases.json"
touch "$ARTIFACTS/PIPELINE_COMPLETE"
