#!/bin/bash
#PBS -P personal-yguo017
#PBS -j oe
# Retrospective test of the trajectory-coherent layer objective (traj.json, traj_worker.py): on the C80 queries H_U was
# collected on, H_S and H_traj per video-expert Linear, the proxies of the saved W2 arms under H_U / H_S / H_traj and
# their ranking of held-out future NMSE -> results/traj/. fwtr1 = gdev x 1 GPU (< 2 h). The job does not resume.
set -euo pipefail

NEW_ROOT=/scratch/users/ntu/yguo017/fastwam-guided-hessian-20261028
PARENT_RUNTIME=/scratch/users/ntu/yguo017/fastwam-vq-r128-c80-loss-pair-20261022/artifacts/25921795.pbs101
BASELINE_ROOT=/scratch/users/ntu/yguo017/fastwam-a16-baselines-20261028
PILOT_ROOT=/scratch/users/ntu/yguo017/fastwam-libero-plus-pilot-20261005
BASE=/scratch/users/ntu/yguo017/fastwam-smoke
SMOOTH_ROOT=/scratch/users/ntu/yguo017/fastwam-smooth-vq-phases12-20261006
SOURCE_ROOT=/scratch/users/ntu/yguo017/fastwam-a4-phases12-20261006
R128_ROOT=/scratch/users/ntu/yguo017/fastwam-r128-improvements-20261021
SIF=/scratch/users/ntu/yguo017/openvla-oft-vla-eval-libero/containers/libero-latest.sif

die() { echo "ERROR: $*" >&2; exit 64; }
test -n "${PBS_JOBID:-}" || die 'PBS_JOBID is required'
test -n "${PBS_NODEFILE:-}" -a -s "${PBS_NODEFILE:-}" || die 'PBS_NODEFILE is missing or empty'
HOST=$(hostname -s)
case "$HOST" in *login*) die 'Refusing login-node execution';; esac
awk -F. -v host="$HOST" '$1 == host {found=1} END {exit !found}' "$PBS_NODEFILE" || die 'Current host is outside the PBS allocation'
FW_JOB=${PBS_JOBNAME:-}
case "$FW_JOB" in
  fwtr1|fwtr1r[0-9]) QUEUE=gdev; NG=1; FW_SOFT_DEADLINE_SECONDS=6900;;
  *) die "Unknown job name: $FW_JOB";;
esac
ALLOCATION_QSTAT=$(qstat -xf "$PBS_JOBID") || die 'Cannot verify the live PBS allocation'
grep -Eq '^[[:space:]]*job_state[[:space:]]*=[[:space:]]*R([[:space:]]|$)' <<< "$ALLOCATION_QSTAT" || die 'PBS job is not running'
grep -Eq "^[[:space:]]*Job_Name[[:space:]]*=[[:space:]]*${PBS_JOBNAME}([[:space:]]|$)" <<< "$ALLOCATION_QSTAT" || die 'PBS job name differs'
grep -Eiq "^[[:space:]]*queue[[:space:]]*=[[:space:]]*${QUEUE}([[:space:]]|$)" <<< "$ALLOCATION_QSTAT" || die "PBS did not route the job to $QUEUE"
NCPUS=$(sed -nE 's/^[[:space:]]*Resource_List\.ncpus[[:space:]]*=[[:space:]]*([0-9]+).*/\1/p' <<< "$ALLOCATION_QSTAT")
[[ "$NCPUS" =~ ^[0-9]+$ ]] || die 'Cannot read the allocated ncpus'

FW_JOB_START_EPOCH=$(date +%s)
FW_CPU_THREADS=$(( NCPUS / NG ))
FW_SAVE_RESERVE_SECONDS=300
ARTIFACTS=$NEW_ROOT/artifacts/$PBS_JOBID
OUT=$ARTIFACTS
RESULTS=$NEW_ROOT/results
ROOT=$PILOT_ROOT
DIAG_ROOT=$NEW_ROOT
FW_ARMS=${FW_ARMS:-}
export FW_JOB_START_EPOCH FW_SOFT_DEADLINE_SECONDS FW_CPU_THREADS FW_SAVE_RESERVE_SECONDS FW_JOB FW_ARMS
export ROOT BASE SIF DIAG_ROOT NEW_ROOT SMOOTH_ROOT SOURCE_ROOT R128_ROOT ARTIFACTS
mkdir -p "$ARTIFACTS" "$RESULTS"
exec > >(tee -a "$ARTIFACTS/job.log") 2>&1
printf '%s\n' "$ALLOCATION_QSTAT" > "$ARTIFACTS/allocation.txt"
printf 'PBS_JOBID=%s host=%s start_epoch=%s route=%s gpus=%s\n' "$PBS_JOBID" "$HOST" "$FW_JOB_START_EPOCH" "$QUEUE" "$NG"

GPU_MONITOR_PID=
finish() {
  local rc=$?
  trap - EXIT TERM INT
  set +e
  if [[ -n "$GPU_MONITOR_PID" ]]; then kill "$GPU_MONITOR_PID" 2>/dev/null; wait "$GPU_MONITOR_PID" 2>/dev/null; fi
  (( rc == 0 )) || rm -f "$OUT/PIPELINE_COMPLETE"
  printf '%s\n' "$rc" > "$OUT/exit_code.txt"
  exit "$rc"
}
trap finish EXIT
trap 'exit 143' TERM INT

for name in protocol.json host.json traj.json run_traj.pbs environment.sh worker.py traj_worker.py probe.py; do
  test -s "$NEW_ROOT/$name" || { echo "Uploaded source missing: $name" >&2; exit 65; }
  cp "$NEW_ROOT/$name" "$ARTIFACTS/"
done
# Frozen loss-pair runtime chain: model, plan, cached teachers, metrics, reader, soft-bin KL.
cp "$PARENT_RUNTIME/protocol.json" "$ARTIFACTS/lp_protocol.json"
cp "$PARENT_RUNTIME/worker.py" "$ARTIFACTS/lp_worker.py"
for name in source_worker.py rotation_bank.py c8_train_banks.py batched_transform.py runner.py quantization.py \
    libero_state_loader.py smooth_vq.py codebook.py micro_codebook.py sampler.py latent_reference.py \
    checkpointing.py calibration_source.py frozen_reader.py reader_runtime.py reader_loss.py softbin_loss.py; do
  test -s "$PARENT_RUNTIME/$name" || { echo "Runtime artifact missing: $name" >&2; exit 65; }
  cp "$PARENT_RUNTIME/$name" "$ARTIFACTS/"
done
# The A16 baselines' host ports, unchanged (the same code produced their QTIP_W2, GPTVQ_W2, QUIPSHARP_W2).
mkdir -p "$ARTIFACTS/methods"
for method in qtip gptvq quipsharp; do
  test -s "$BASELINE_ROOT/methods/$method/quant.py" || { echo "Baseline $method implementation missing" >&2; exit 65; }
  cp -r "$BASELINE_ROOT/methods/$method" "$ARTIFACTS/methods/"
  sha256sum "$ARTIFACTS/methods/$method/quant.py"
done

source "$ARTIFACTS/environment.sh"

IFS=, read -r -a GPU_IDS <<< "${CUDA_VISIBLE_DEVICES:-}"
test "${#GPU_IDS[@]}" -eq "$NG" || { echo "Expected $NG allocated GPUs, got ${#GPU_IDS[@]}" >&2; exit 65; }
GPU_UUIDS=()
for gpu in "${GPU_IDS[@]}"; do
  uuid=$(nvidia-smi -i "$gpu" --query-gpu=uuid --format=csv,noheader | tr -d '[:space:]')
  test -n "$uuid" || exit 65
  GPU_UUIDS+=("$uuid")
done
ME=$(id -un)
(
  n=0
  while :; do
    for uuid in "${GPU_UUIDS[@]}"; do
      printf 'GPU_SAMPLE timestamp=%s ' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      nvidia-smi -i "$uuid" --query-gpu=uuid,name,utilization.gpu,memory.used,memory.total --format=csv,noheader || echo GPU_SAMPLE_ERROR
    done
    if (( n % 4 == 0 )); then  # busy cores of this user's processes over 2 s (second top frame), against the request
      top -b -n 2 -d 2 -u "$ME" 2>/dev/null | awk -v ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)" -v req="$NCPUS" \
        '/^top -/ {frame++} frame == 2 && $1 ~ /^[0-9]+$/ {s += $9} END {printf "CPU_SAMPLE timestamp=%s busy_cores=%.1f requested=%s\n", ts, s / 100, req}' \
        || echo CPU_SAMPLE_ERROR
    fi
    n=$(( n + 1 ))
    sleep 15
  done
) & GPU_MONITOR_PID=$!

cd "$ARTIFACTS"

step() {  # one worker process per GPU (shard k of n); the first failure ends the job
  local stage=$1 n=$2 k pids=()
  echo "STEP $stage shards=$n $(date -u +%H:%M:%S)"
  for (( k = 0; k < n; k++ )); do
    ( export CUDA_VISIBLE_DEVICES=${GPU_UUIDS[$k]} FW_STAGE=$stage FW_SHARD=$k FW_SHARDS=$n
      run_python "$ARTIFACTS/traj_worker.py" --protocol "$ARTIFACTS/protocol.json" > "$OUT/${stage}_$k.log" 2>&1 ) &
    pids+=("$!")
  done
  for (( k = 0; k < n; k++ )); do
    if ! wait -n; then
      for (( k = 0; k < n; k++ )); do tail -c 6000 "$OUT/${stage}_$k.log"; done
      die "step $stage failed"
    fi
  done
  for (( k = 0; k < n; k++ )); do grep FWGH_PROGRESS "$OUT/${stage}_$k.log" | tail -n 1; done
}

step traj 1
cat "$RESULTS/traj/RESULTS.zh.md"

touch "$ARTIFACTS/PIPELINE_COMPLETE"
echo PIPELINE_COMPLETE
