  "lowrank": {
    "purpose": "C2 v2 gate: does a C1-derived objective repair the imagined future once the tuned parameters have capacity in every layer, and does decoupling the action term add to it? The diagonal-scale run (tune.json, QTIP 26059212) improved the action only: held-out mixed 0.923x, first10 motor 0.0324 -> 0.0279, future NMSE 0.05325 -> 0.05328, future share of motor MSE 0.44 -> 0.60; only 9 of 3.9M scales moved past BF16 rounding and |g|^2 sat in conditioning layers (time_projection, action_encoder). Here every target Linear gets the same rank-r BF16 branch, a model-agnostic parametrization (any Linear of any host, sequential or joint world-action model).",
    "host": "QTIP",
    "baseline_arm": "QTIP_U_W2",
    "baseline_heldout": "results/heldout/QTIP_U_W2.json (phase 1, 26043905)",
    "baseline_fit": "results/tune/QTIP/fit_before.json (26057132)",
    "rank": 4,
    "branch": "y = x W_host^T + b + (x V^T) U^T with U (out x r), V (r x in) stored in BF16: +16 r (out + in) bits per Linear; computed in FP32 and added to the BF16 output; the deployed weight stays the host's W2",
    "init": {
      "method": "EoRA-style closed form: L = [dW C]_r C^-1 minimizes tr((dW - L) H (dW - L)^T), dW = W_master - W_host, H = H_U + damping x mean(diag H_U) I = C C^T (Cholesky; damping x10 until positive definite); U = P S^1/2, V = S^1/2 Q^T C^-1 from the SVD P S Q^T of dW C",
      "damping": 0.01
    },
    "arms": {
      "E": {
        "arm": "QTIP_LRE_W2",
        "objective": "none: the init, prior-art reference (activation-weighted low-rank error compensation)"
      },
      "J": {
        "arm": "QTIP_LRJ_W2",
        "objective": "joint: mean of A + lambda Z + beta K (tune_worker's staged batch; A on the student's own action)"
      },
      "D": {
        "arm": "QTIP_LRD_W2",
        "objective": "decoupled: mean of A_tf + lambda Z + beta K; A_tf is the student's action reading the BF16 teacher future (the C1 swap path), so the action side gets no reward for compensating a corrupted future; Z on the student future; K the frozen BF16 reader on the student future"
      }
    },
    "training": {
      "start": "E's BF16 factors",
      "schedule": "the loss-pair C80 schedule (8 batches of 10 contexts, sampler seed index 0)",
      "updates": 8,
      "update": "per factor tensor P (U or V of one Linear): P <- P - eta |P| g / |g|; every Linear moves by eta of its factor norm along its own descent direction (the max-normalized scale step spent everything on a few conditioning scales)",
      "step_grid": [
        0.0025,
