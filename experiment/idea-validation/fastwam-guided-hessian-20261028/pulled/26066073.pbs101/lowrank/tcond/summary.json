{
  "protocol": "fastwam-guided-hessian-20261028-v1",
  "pbs_jobid": "26066073.pbs101",
  "tcond": {
    "purpose": "Attribution after tfdiag: 86% of the teacher-forced future gradient energy and its shared part sit in the video expert's 3 time-conditioning Linears (time_embedding.0/.2, time_projection.1). Their inputs are sinusoidal embeddings of the timestep only (per token: t, frame 0 at 0), so under the fixed 10-step schedule their outputs take a handful of values per expert, the same for every context. How much of W2's held-out future error do they carry? Restoring them to the BF16 masters gives the outputs exactly; a per-timestep table of those outputs gives the same at a negligible cost.",
    "arms": {
      "U_TV": {
        "arm": "QTIP_TV_W2",
        "base": "QTIP_U_W2",
        "groups": [
          "video_time"
        ]
      },
      "U_TA": {
        "arm": "QTIP_TA_W2",
        "base": "QTIP_U_W2",
        "groups": [
          "action_time"
        ]
      },
      "U_TVA": {
        "arm": "QTIP_TVA_W2",
        "base": "QTIP_U_W2",
        "groups": [
          "video_time",
          "action_time"
        ]
      },
      "E_TVA": {
        "arm": "QTIP_LRE_TVA_W2",
        "base": "QTIP_LRE_W2",
        "groups": [
          "video_time",
          "action_time"
        ]
      }
    },
    "install": "the base arm (U: QTIP W2; E: QTIP W2 plus E's BF16 factors), then the Linears of the listed groups get their BF16 master weights; on E their branch factors are zeroed",
    "modules_per_group": 3,
    "evaluation": "held-out 40x2 + C1 swap (evaluate), against results/heldout/QTIP_U_W2.json and QTIP_LRE_W2.json",
    "input_check": {
      "samples": [
        [
          2000,
          0
        ],
        [
          2047,
          1
        ]
      ],
      "basis": "BF16, before any install: every call's input to the 6 time-conditioning Linears must be identical across two different contexts at different sampler seeds (max abs 0), and the distinct input rows per expert give the table size"
    },
    "bits": "as BF16 weights: base bpw + sum (16 n - host bits) / target weights; as a table: base bpw + 16 x distinct timesteps x (out of time_embedding.2 + out of time_projection.1) / target weights",
    "reading": {
      "primary": "r = held-out future NMSE of U_TV over U's",
      "carries_max": 0.9,
      "negligible_min": 0.97,
      "carries": "r <= 0.9: the timestep-conditioning path carries at least a tenth of W2's held-out future error and its fix is exact and context-free: C2 v3 builds on per-timestep conditioning tables (any denoising WAM with a fixed schedule, joint DiT included); next the closed loop of U_TV against U",
      "partial": "0.9 < r <= 0.97: a minor share; reported next to E_TVA before deciding",
      "negligible": "r > 0.97: the shared local error tfdiag found is not where W2's future error comes from; weight-side future repair on this host is exhausted and C2 turns to the action side"
    },
    "allocation": {
      "job_name": "fwtc1",
      "queue": "normal",
      "execution_queue": "g1",
      "gpus": 1,
      "ncpus": 4,
      "memory_gb": 100,
      "walltime": "04:00:00",
      "soft_deadline_seconds": 13500,
      "time_basis": "load ~10 min, input check 2 queries, 4 arms x held-out 40 x 2 with the swap reader ~20 min each (26060556): ~1.5 h"
    }
  },
