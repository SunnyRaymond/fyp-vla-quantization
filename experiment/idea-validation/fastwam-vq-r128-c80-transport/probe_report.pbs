#!/bin/bash
#PBS -N fwtrprobeagg
#PBS -P personal-yguo017
#PBS -q qdev
#PBS -l select=1:ncpus=1:mem=4gb:ngpus=0
#PBS -l walltime=00:10:00
#PBS -j oe
set -euo pipefail
TASK_ROOT=/scratch/users/ntu/yguo017/fastwam-vq-r128-c80-transport-20261022
test -n "${PBS_JOBID:-}" -a -n "${PBS_NODEFILE:-}"
case "$(hostname -s)" in *login*) exit 64;; esac
awk -F. -v host="$(hostname -s)" '$1 == host {found=1} END {exit !found}' "$PBS_NODEFILE"
qstat -f "$PBS_JOBID" | grep -Eq '^[[:space:]]*job_state[[:space:]]*=[[:space:]]*R([[:space:]]|$)'
TASK_ARTIFACTS=$TASK_ROOT/probe_analysis/$PBS_JOBID
mkdir -p "$TASK_ARTIFACTS"
exec > >(tee -a "$TASK_ARTIFACTS/job.log") 2>&1
trap 'rc=$?; printf "%s\n" "$rc" > "$TASK_ARTIFACTS/exit_code.txt"' EXIT
module purge
module load gcc/11.4.0-nscc python/3.11.7-gcc11
export PYTHONDONTWRITEBYTECODE=1
python3 "$TASK_ROOT/probe_analysis/probe_report.py" "$TASK_ROOT"
touch "$TASK_ARTIFACTS/PHASE_COMPLETE"
