#!/bin/bash
#PBS -N fwm14ana
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=2:mem=8gb
#PBS -l walltime=00:10:00
#PBS -j oe
set -euo pipefail
test -n "${PBS_JOBID:-}" || exit 64
case "$(hostname -s)" in *login*) exit 64;; esac
test -s "${PBS_NODEFILE:-}" || exit 64
grep -Fqx "$(hostname -s)" <(awk -F. '{print $1}' "$PBS_NODEFILE") || exit 64
test -z "${PBS_GPUFILE:-}" || exit 64
[[ "${FW_FINAL_JOB:-}" =~ ^[0-9]+(\[[0-9]*\])?\.[A-Za-z0-9_.-]+$ ]] || exit 64

ROOT=/scratch/users/ntu/yguo017/fastwam-vq-micro-latent-search-20261014
SOURCE_CAMPAIGN=/scratch/users/ntu/yguo017/fastwam-vq-action-aware-20261009
FINAL_SUMMARY="$ROOT/results/final-$FW_FINAL_JOB/summary.json"
FINAL_ARTIFACT="$ROOT/artifacts/$FW_FINAL_JOB"
CHOICE="$ROOT/optimal_selection.json"
ARTIFACTS="$ROOT/artifacts/analysis-$PBS_JOBID"
OUT="$ROOT/results/analysis-$PBS_JOBID"
mkdir -p "$ROOT/artifacts" "$ROOT/results"
mkdir "$ARTIFACTS"
exec > >(tee -a "$ARTIFACTS/job.log") 2>&1
finish() { rc=$?; printf '%s\n' "$rc" > "$ARTIFACTS/exit_code.txt"; }
trap finish EXIT

test -f "$FINAL_ARTIFACT/PIPELINE_COMPLETE"
test "$(cat "$FINAL_ARTIFACT/exit_code.txt")" = 0
test -s "$FINAL_SUMMARY" -a -s "$CHOICE"
test -s "$ROOT/reference_cache.pt" -a -s "$ROOT/reference_summary.json"
test -f /scratch/users/ntu/yguo017/fastwam-vq-microscale-20261011/artifacts/25755896.pbs101/PIPELINE_COMPLETE
test "$(cat /scratch/users/ntu/yguo017/fastwam-vq-microscale-20261011/artifacts/25755896.pbs101/exit_code.txt)" = 0

copy_small() {
  local bytes
  test -f "$1"
  bytes=$(wc -c < "$1")
  [[ "$bytes" =~ ^[0-9]+$ && "$bytes" -le 262144 ]] || exit 73
  cp -- "$1" "$2"
}
for name in protocol.json environment.sh analysis.pbs analyze_final.py metrics.py; do
  copy_small "$ROOT/$name" "$ARTIFACTS/$name"
done

export FW_JOB_START_EPOCH=$(date +%s)
FW_REQUIRE_GPU=0
FW_CPU_THREADS=2
source "$ARTIFACTS/environment.sh"
test -z "${CUDA_VISIBLE_DEVICES:-}" || exit 65
run_python --version
run_python "$ARTIFACTS/analyze_final.py" \
  --protocol "$ARTIFACTS/protocol.json" \
  --final-summary "$FINAL_SUMMARY" \
  --choice "$CHOICE" \
  --out "$OUT"
test -s "$OUT/summary.json" -a -s "$OUT/report.zh.md" -a -s "$OUT/comparison.json"
test -f "$OUT/SEARCH_REPORT_COMPLETE"
copy_small "$OUT/summary.json" "$ARTIFACTS/summary.json"
copy_small "$OUT/report.zh.md" "$ARTIFACTS/report.zh.md"
copy_small "$OUT/comparison.json" "$ARTIFACTS/comparison.json"
touch "$ARTIFACTS/SEARCH_REPORT_COMPLETE"
touch "$ARTIFACTS/PIPELINE_COMPLETE"
echo "SEARCH_REPORT_COMPLETE job_id=$PBS_JOBID final_job=$FW_FINAL_JOB"
