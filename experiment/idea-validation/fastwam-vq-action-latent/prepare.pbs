#!/bin/bash
#PBS -N fwvzl1014refs
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=00:15:00
#PBS -j oe
set -euo pipefail
test -n "${PBS_JOBID:-}" || exit 64
case "$(hostname -s)" in *login*) exit 64;; esac
test -s "${PBS_NODEFILE:-}" || exit 64
grep -Fqx "$(hostname -s)" <(awk -F. '{print $1}' "$PBS_NODEFILE") || exit 64
ROOT=/scratch/users/ntu/yguo017/fastwam-vq-action-latent-20261014
SOURCE_CAMPAIGN=/scratch/users/ntu/yguo017/fastwam-vq-action-aware-20261009
ARTIFACTS="$ROOT/artifacts/$PBS_JOBID"
export FW_JOB_START_EPOCH=$(date +%s)
mkdir -p "$ROOT/artifacts" "$ROOT/results"
mkdir "$ARTIFACTS"
exec > >(tee -a "$ARTIFACTS/job.log") 2>&1
trap 'printf "%s\n" "$?" > "$ARTIFACTS/exit_code.txt"' EXIT
for name in protocol.json environment.sh sampler.py checkpointing.py metrics.py latent_reference.py prepare_references.py test_latent_loss.py; do
  test "$(wc -c < "$ROOT/$name")" -le 262144 || exit 73
  cp -- "$ROOT/$name" "$ARTIFACTS/$name"
done
FW_REQUIRE_GPU=0
FW_CPU_THREADS=4
source "$ARTIFACTS/environment.sh"
run_python "$ARTIFACTS/prepare_references.py" --protocol "$ARTIFACTS/protocol.json" --out "$ROOT"
cp -- "$ROOT/reference_summary.json" "$ARTIFACTS/summary.json"
touch "$ARTIFACTS/PIPELINE_COMPLETE"
echo "REFERENCE_PREPARATION_COMPLETE job_id=$PBS_JOBID"
