#!/bin/bash
#PBS -N dino_wall_gd_prefix
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=16:mem=110gb:ngpus=1
#PBS -l walltime=04:00:00
#PBS -j oe

set -euo pipefail

ROOT=${DINO_WM_ROOT:-/scratch/users/ntu/yguo017/dino-wm-wall}
IDEA_ROOT=${DINO_PREFIX_ROOT:-$ROOT/idea-validation/dino-wm-shared-prefix-cache}
CONTROL="$IDEA_ROOT/gd_planner_portability"

# Fail closed before runtime extraction or model/data I/O.
test -n "${PBS_JOBID:-}"
JOB_ID="$PBS_JOBID"
OUT=${DINO_GD_PORTABILITY_OUT:-$ROOT/artifacts/gd-portability-$JOB_ID}
WORK=${TMPDIR:-/tmp}/dino-wall-gd-prefix-$JOB_ID
HOST=$(hostname -s | tr '[:upper:]' '[:lower:]')
case "$HOST" in
  *login*|*head*|*submit*)
    echo "refusing probable login host: $HOST" >&2
    exit 2
    ;;
esac
test -n "${PBS_NODEFILE:-}"
test -f "$PBS_NODEFILE"
test -n "${CUDA_VISIBLE_DEVICES:-}"
test -d "$ROOT/data"
test -f "$ROOT/ASSETS_READY"
test -f "$ROOT/runtime-complete.tar"
test -f "$ROOT/checkpoints/outputs/wall_single/checkpoints/model_latest.pth"
test -f "$CONTROL/run_gd_portability.py"
test -f "$CONTROL/GD_PORTABILITY_FREEZE.json"
test -f "$CONTROL/verify_gd_portability.py"
test -f "$IDEA_ROOT/cache_core.py"

mkdir -p "$OUT" "$WORK"
exec > >(tee -a "$OUT/job.log") 2>&1

module purge
module load gcc/11.4.0-nscc python/3.11.7-gcc11
tar -xf "$ROOT/runtime-complete.tar" -C "$WORK"
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=8 MKL_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8
export TORCH_HOME="$WORK/runtime/torch" MPLBACKEND=Agg
export PYTHONPATH="$CONTROL:$IDEA_ROOT:$ROOT/source"

nvidia-smi --query-gpu=name,memory.total --format=csv,noheader > "$OUT/gpu.txt"
timeout --signal=TERM 230m "$WORK/runtime/venv/bin/python" "$CONTROL/run_gd_portability.py" \
  --root "$ROOT" \
  --output "$OUT" \
  --freeze "$CONTROL/GD_PORTABILITY_FREEZE.json"

"$WORK/runtime/venv/bin/python" "$CONTROL/verify_gd_portability.py" \
  --freeze "$CONTROL/GD_PORTABILITY_FREEZE.json" \
  --summary "$OUT/system_summary.json" > "$OUT/verifier.json"
touch "$OUT/GD_PORTABILITY_NUMERICAL_PASS"
date
