#!/bin/bash
#PBS -N dino_shared_prefix_smoke
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=16:mem=110gb:ngpus=1
#PBS -l walltime=00:30:00
#PBS -j oe

set -euo pipefail

# Existing official assets/environment; this job does not download, install,
# compile, or hash anything.  Stage this directory under $ROOT before qsub.
ROOT=${DINO_WM_ROOT:-/scratch/users/ntu/yguo017/dino-wm-wall}
IDEA_ROOT=${DINO_PREFIX_ROOT:-$ROOT/idea-validation/dino-wm-shared-prefix-cache}
OUT=${DINO_PREFIX_OUT:-$ROOT/artifacts/shared-prefix-smoke-$PBS_JOBID}
WORK=${TMPDIR:-/tmp}/dino-shared-prefix-$PBS_JOBID

test -n "${PBS_JOBID:-}"
HOST=$(hostname -s)
case "$HOST" in
  *login*|*login1*|*login2*|asp2a-login*|ntu-login*)
    echo "refusing probable login host: $HOST" >&2
    exit 2
    ;;
esac
test -d "$ROOT/data"
test -f "$ROOT/ASSETS_READY"
test -f "$ROOT/runtime-complete.tar"
test -f "$IDEA_ROOT/run_smoke.py"
test -f "$IDEA_ROOT/cache_core.py"
test -f "$IDEA_ROOT/EXPERIMENT_FREEZE.json"
test -f "$IDEA_ROOT/verify_results.py"

mkdir -p "$OUT" "$WORK"
exec > >(tee -a "$OUT/job.log") 2>&1

module purge
module load gcc/11.4.0-nscc python/3.11.7-gcc11
tar -xf "$ROOT/runtime-complete.tar" -C "$WORK"
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=8 MKL_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8
export TORCH_HOME="$WORK/runtime/torch" MPLBACKEND=Agg
export PYTHONPATH="$IDEA_ROOT:$ROOT/source"

nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
timeout --signal=TERM 26m "$WORK/runtime/venv/bin/python" "$IDEA_ROOT/run_smoke.py" \
  --root "$ROOT" \
  --output "$OUT" \
  --n-cases 2 \
  --cem-iters 2

test -s "$OUT/mechanism.jsonl"
test -s "$OUT/summary.json"
"$WORK/runtime/venv/bin/python" "$IDEA_ROOT/verify_results.py" \
  --mechanism "$OUT/mechanism.jsonl" > "$OUT/verifier.json"
touch "$OUT/MECHANISM_PASS"
date
