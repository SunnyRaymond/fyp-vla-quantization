#!/bin/bash
#PBS -N dino_ebmf_stage_a
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=16:mem=110gb:ngpus=1
#PBS -l walltime=01:00:00
#PBS -j oe

set -euo pipefail

ROOT=${DINO_WM_ROOT:-/scratch/users/ntu/yguo017/dino-wm-wall}
IDEA_ROOT=${DINO_PREFIX_ROOT:-$ROOT/idea-validation/dino-wm-shared-prefix-cache}
EBMF_ROOT=${DINO_EBMF_ROOT:-$IDEA_ROOT/ebmf_cem}
OUT=${DINO_EBMF_OUT:-$ROOT/artifacts/ebmf-cem-stage-a-$PBS_JOBID}
WORK=${TMPDIR:-/tmp}/dino-ebmf-stage-a-$PBS_JOBID

# Guard before model loading, runtime extraction, or other heavy I/O.
test -n "${PBS_JOBID:-}"
HOST=$(hostname -s)
case "$HOST" in
  *login*|*login1*|*login2*|asp2a-login*|ntu-login*)
    echo "refusing probable login host: $HOST" >&2
    exit 2
    ;;
esac
test -d "$ROOT/data"
test -f "$ROOT/ASSETS_READY"
test -f "$ROOT/runtime-complete.tar"
test -f "$EBMF_ROOT/stage_a_runner.py"
test -f "$EBMF_ROOT/EBMF_CEM_STAGE_A_FREEZE.json"
test -f "$EBMF_ROOT/verify_ebmf_cem.py"

mkdir -p "$OUT" "$WORK"
exec > >(tee -a "$OUT/job.log") 2>&1

module purge
module load gcc/11.4.0-nscc python/3.11.7-gcc11
tar -xf "$ROOT/runtime-complete.tar" -C "$WORK"
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=8 MKL_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8
export TORCH_HOME="$WORK/runtime/torch" MPLBACKEND=Agg
export PYTHONPATH="$EBMF_ROOT:$ROOT/source"

nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
timeout --signal=TERM 54m "$WORK/runtime/venv/bin/python" "$EBMF_ROOT/stage_a_runner.py" \
  --root "$ROOT" \
  --output "$OUT" \
  --n-observations 6

test -s "$OUT/calibration.jsonl"
test -s "$OUT/stage_a_summary.json"
touch "$OUT/EBMF_CEM_STAGE_A_COMPLETE"
"$WORK/runtime/venv/bin/python" "$EBMF_ROOT/verify_ebmf_cem.py" \
  --contract "$EBMF_ROOT/EBMF_CEM_STAGE_A_FREEZE.json" \
  --calibration "$OUT/calibration.jsonl" > "$OUT/verifier.json"
touch "$OUT/EBMF_CEM_STAGE_A_PASS"
date
