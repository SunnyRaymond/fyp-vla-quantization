#!/bin/bash
#PBS -N dino_ebmf_mdiag
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=2:mem=8gb
#PBS -l walltime=00:10:00
#PBS -j oe

set -euo pipefail
test -n "${PBS_JOBID:-}"
HOST=$(hostname -s)
case "$HOST" in
  *login*|asp2a-login*|ntu-login*) echo "refusing login host: $HOST" >&2; exit 2 ;;
esac

ROOT=/scratch/users/ntu/yguo017/dino-wm-wall
EBMF_ROOT=$ROOT/idea-validation/dino-wm-shared-prefix-cache/ebmf_cem
INPUT=$ROOT/artifacts/ebmf-cem-stage-a-23486772.pbs101/calibration.jsonl
OUTPUT=$ROOT/artifacts/ebmf-cem-stage-a-23486772.pbs101/m_diagnosis.json
WORK=${TMPDIR:-/tmp}/dino-ebmf-mdiag-$PBS_JOBID

test -s "$INPUT"
test -f "$ROOT/runtime-complete.tar"
mkdir -p "$WORK"
module purge
module load gcc/11.4.0-nscc python/3.11.7-gcc11
tar -xf "$ROOT/runtime-complete.tar" -C "$WORK"
"$WORK/runtime/venv/bin/python" "$EBMF_ROOT/diagnose_stage_a_m.py" "$INPUT" "$OUTPUT"
test -s "$OUTPUT"
