#!/bin/bash
#PBS -N lewm_torch_compat
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -l walltime=01:00:00
#PBS -j oe

set -euo pipefail
test -n "${PBS_JOBID:-}"
HOST=$(hostname -s | tr '[:upper:]' '[:lower:]')
case "$HOST" in *login*|*head*|*submit*) echo "refusing probable login host: $HOST" >&2; exit 2;; esac
test -n "${PBS_NODEFILE:-}" && test -f "$PBS_NODEFILE"

STAGE_ROOT=${LEWM_STAGE_ROOT:-/scratch/users/ntu/yguo017/lewm-pusht-iteration}
CONTROL=${LEWM_ITERATION_CONTROL_DIR:-/scratch/users/ntu/yguo017/dino-wm-wall/idea-validation/dino-wm-shared-prefix-cache/lewm_pusht_iteration_cache}
STABLEWM_HOME=${STABLEWM_HOME:-$STAGE_ROOT/stablewm_home}
OUT=${LEWM_COMPAT_OUT:-$CONTROL/artifacts/$PBS_JOBID}
PYTHON_BIN=${LEWM_PYTHON_BIN:-$STAGE_ROOT/venv/bin/python}
mkdir -p "$OUT"
exec > >(tee -a "$OUT/job.log") 2>&1

module purge
module load gcc/11.4.0-nscc python/3.11.7-gcc11
VENV="$STAGE_ROOT/venv"
"$VENV/bin/python" -m pip install --no-cache-dir --force-reinstall \
  --index-url https://download.pytorch.org/whl/cu128 \
  --extra-index-url https://pypi.org/simple \
  'torch==2.8.0' 'torchvision==0.23.0'

export PYTHONUNBUFFERED=1
export PYTHONPATH="$STAGE_ROOT/le-wm:$STAGE_ROOT/stable-worldmodel:${PYTHONPATH:-}"
CHECKPOINT="$STABLEWM_HOME/pusht/lewm_object.ckpt"
test -f "$CHECKPOINT"
"$VENV/bin/python" - "$CHECKPOINT" "$OUT/compat_validation.json" <<'PY'
import json
import sys
from pathlib import Path

import torch
import torchvision

checkpoint = Path(sys.argv[1])
output = Path(sys.argv[2])
if torch.version.cuda != "12.8":
    raise RuntimeError(f"unexpected CUDA wheel: torch={torch.__version__} cuda={torch.version.cuda}")
model = torch.load(checkpoint, map_location="cpu", weights_only=False)
if not hasattr(model, "get_cost"):
    raise TypeError(f"checkpoint is not a LeWM cost model: {checkpoint}")
model.eval()
model.requires_grad_(False)
payload = {
    "status": "PASS",
    "torch": torch.__version__,
    "torchvision": torchvision.__version__,
    "torch_cuda": torch.version.cuda,
    "checkpoint": str(checkpoint),
    "model_class": f"{type(model).__module__}.{type(model).__name__}",
}
output.write_text(json.dumps(payload, indent=2), encoding="utf-8")
print(json.dumps(payload))
PY
test -s "$OUT/compat_validation.json"
printf 'TORCH_COMPAT_VALIDATION_PASS\n'
