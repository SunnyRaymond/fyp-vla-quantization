#!/bin/bash
#PBS -N vscode_repair
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=1:mem=2gb
#PBS -l walltime=00:10:00
#PBS -j oe

set -euo pipefail
umask 077
node=$(hostname -s)
[[ -n "${PBS_JOBID:-}" && "$node" != *login* ]] || { echo 'STOP: PBS compute allocation required'; exit 1; }
[[ -r "${PBS_NODEFILE:-/nonexistent}" ]] || { echo 'STOP: missing PBS node file'; exit 1; }
grep -qE "^${node}(\.|$)" "$PBS_NODEFILE" || { echo 'STOP: host not in allocation'; exit 1; }
[[ $(uname -m) == x86_64 ]] || { echo 'STOP: expected x86_64'; exit 1; }
echo "Job: $PBS_JOBID; compute host: $node"

commit=645f29cc3176500b4b5762ba887cf2a7f0ffdf2c
root="$HOME/.vscode-server"
target="$root/cli/servers/Stable-$commit"
mkdir -p "$root/repair"
exec 9>"$root/repair/install.lock"
flock -n 9 || { echo 'STOP: another repair owns the lock'; exit 1; }
[[ ! -L "$target" && ! -L "$target/server" ]] || { echo 'STOP: unexpected installation symlink'; exit 1; }
stage=$(mktemp -d "$root/repair/stage.XXXXXXXX")
echo "Staging directory: $stage"
curl --fail --location --proto '=https' --proto-redir '=https' \
  --connect-timeout 20 --max-time 360 \
  "https://update.code.visualstudio.com/commit:$commit/server-linux-x64/stable" \
  --output "$stage/server.tar.gz"
mkdir "$stage/server"
tar -xzf "$stage/server.tar.gz" --strip-components=1 -C "$stage/server"
test -x "$stage/server/bin/code-server"
test -x "$stage/server/node"
"$stage/server/node" -e 'const p=require(process.argv[1]); if(p.commit!==process.argv[2])process.exit(1); console.log("Verified commit: "+p.commit)' "$stage/server/product.json" "$commit"
"$stage/server/bin/code-server" --version
mkdir -p "$target"
if [[ -e "$target/server" ]]; then
  mv "$target/server" "$stage/previous-server"
  echo "Previous server preserved: $stage/previous-server"
fi
if ! mv "$stage/server" "$target/server"; then
  if [[ -d "$stage/previous-server" ]]; then mv "$stage/previous-server" "$target/server"; fi
  echo 'STOP: installation failed'; exit 1
fi
test -x "$target/server/bin/code-server"
echo "REPAIR_OK: $target/server/bin/code-server"
echo 'No VS Code service was started. No GPU was allocated.'
