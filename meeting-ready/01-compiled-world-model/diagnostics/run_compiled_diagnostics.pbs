#!/bin/bash
#PBS -N lewm_comp_diag
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=16:mem=110gb:ngpus=1
#PBS -l walltime=00:20:00
#PBS -j oe

set -euo pipefail

JOB_ID=${PBS_JOBID:?PBS_JOBID must be non-empty}
ROOT=${COMPILED_DIAG_ROOT:-/scratch/users/ntu/yguo017/dino-wm-wall/meeting-ready/01-compiled-world-model/diagnostics}
COMPILED_ROOT=${COMPILED_ROOT:-/scratch/users/ntu/yguo017/dino-wm-wall/meeting-ready/01-compiled-world-model}
TRANSFER=${LEWM_TRANSFER_ROOT:-/scratch/users/ntu/yguo017/dino-wm-wall/meeting-ready/02-horizon-weighted-recurrent-student/lewm-transfer}
STAGE_ROOT=${LEWM_STAGE_ROOT:-/scratch/users/ntu/yguo017/lewm-pusht-iteration}
LEWM_ROOT=${LEWM_REPO_ROOT:-$STAGE_ROOT/le-wm}
STABLEWM_HOME=${STABLEWM_HOME:-$STAGE_ROOT/stablewm_home}
PYTHON_BIN=${LEWM_PYTHON_BIN:-$STAGE_ROOT/venv/bin/python}
RUNNER=${COMPILED_DIAG_RUNNER:-$ROOT/run_compiled_diagnostics.py}
FREEZE=${COMPILED_DIAG_FREEZE:-$ROOT/DIAGNOSTICS_FREEZE.json}
PROTOCOL=${COMPILED_DIAG_PROTOCOL:-$ROOT/PROTOCOL.zh.md}
DATASET=${LEWM_DATASET:-$STABLEWM_HOME/pusht_expert_train.h5}
MANIFEST=${LEWM_MANIFEST_512:-$TRANSFER/state-coverage/artifacts/24926383.pbs101/context_manifest_512.json}
TRAINING_ROWS=${COMPILED_TRAINING_ROWS:-$TRANSFER/anchor-aligned-bank/artifacts/25223859.pbs101/anchor_aligned_train_rows.pt}
TEMPORAL_FREEZE=${LEWM_TEMPORAL_FREEZE:-$TRANSFER/temporal-balanced-train/LEWM_TEMPORAL_BALANCED_TRAIN_FREEZE.json}
B1_CHECKPOINT=${COMPILED_B1_CHECKPOINT:-$COMPILED_ROOT/artifacts/25309513.pbs101/B1_dense_step1500.pt}
B3_CHECKPOINT=${COMPILED_B3_CHECKPOINT:-$COMPILED_ROOT/artifacts/25309513.pbs101/B3_r192_step1500.pt}
POSITIVE_CHECKPOINT=${COMPILED_POSITIVE_CHECKPOINT:-$TRANSFER/anchor-aligned-bank/artifacts/25223859.pbs101/anchor_aligned_bank_step3000.pt}
OUT=${COMPILED_DIAG_OUT:-$ROOT/artifacts/$JOB_ID}

test -n "${PBS_NODEFILE:-}"
test -f "$PBS_NODEFILE"
HOST=$(hostname -s | tr '[:upper:]' '[:lower:]')
case "$HOST" in
  *login*|*head*|*submit*) echo "refusing probable login host: $HOST" >&2; exit 2 ;;
esac
for FILE in "$RUNNER" "$FREEZE" "$PROTOCOL" "$DATASET" "$MANIFEST" "$TRAINING_ROWS" "$TEMPORAL_FREEZE" "$B1_CHECKPOINT" "$B3_CHECKPOINT" "$POSITIVE_CHECKPOINT" "$STABLEWM_HOME/pusht/lewm_object.ckpt"; do
  test -f "$FILE"
done
test -d "$LEWM_ROOT"
test -x "$PYTHON_BIN"

mkdir -p "$OUT"
status=1
GPU_MONITOR_PID=""
stop_gpu_monitor() {
  if [ -n "$GPU_MONITOR_PID" ] && kill -0 "$GPU_MONITOR_PID" 2>/dev/null; then
    kill "$GPU_MONITOR_PID" 2>/dev/null || true
    wait "$GPU_MONITOR_PID" 2>/dev/null || true
  fi
}
cleanup() {
  stop_gpu_monitor
  printf 'EXIT_STATUS=%s\n' "$status" > "$OUT/job_status"
}
trap cleanup EXIT
exec > >(tee -a "$OUT/job.log") 2>&1

export PYTHONUNBUFFERED=1
export PYTHONPATH="$LEWM_ROOT:$TRANSFER:${PYTHONPATH:-}"
export WANDB_MODE=disabled
export MUJOCO_GL=egl

printf '%s\n' \
  "job_id=$JOB_ID" \
  "host=$HOST" \
  "runner=$RUNNER" \
  "freeze=$FREEZE" \
  "b1_checkpoint=$B1_CHECKPOINT" \
  "b3_checkpoint=$B3_CHECKPOINT" \
  "positive_checkpoint=$POSITIVE_CHECKPOINT" \
  "started_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$OUT/execution_identity.txt"

nvidia-smi --query-gpu=name,memory.total --format=csv,noheader > "$OUT/gpu_info.csv"
nvidia-smi --query-gpu=timestamp,index,name,utilization.gpu,memory.used,memory.total --format=csv -l 5 >> "$OUT/job.log" 2>&1 &
GPU_MONITOR_PID=$!

set +e
timeout --signal=TERM --kill-after=30s 1020 \
  "$PYTHON_BIN" "$RUNNER" \
  --stablewm-home "$STABLEWM_HOME" --dataset "$DATASET" --manifest-512 "$MANIFEST" \
  --training-rows "$TRAINING_ROWS" --temporal-freeze "$TEMPORAL_FREEZE" \
  --b1-checkpoint "$B1_CHECKPOINT" --b3-checkpoint "$B3_CHECKPOINT" --positive-control-checkpoint "$POSITIVE_CHECKPOINT" \
  --freeze "$FREEZE" --protocol "$PROTOCOL" --output "$OUT" --mode run
RUNNER_RC=$?
set -e

if [ "$RUNNER_RC" -eq 0 ] && [ -s "$OUT/compiled_diagnostics_summary.json" ]; then
  status=0
  printf 'RUNNER_EXIT_STATUS=0\n' > "$OUT/final_exit_status.txt"
else
  printf 'RUNNER_EXIT_STATUS=%s\n' "$RUNNER_RC" > "$OUT/final_exit_status.txt"
fi
stop_gpu_monitor
trap - EXIT
printf 'EXIT_STATUS=%s\n' "$status" > "$OUT/job_status"
exit "$status"
