    "closed_loop": "NOT_RUN_BY_SCOPE",
    "student_architecture_changed": false,
    "student_loss_latent_component_changed": false,
    "candidate_bank_changed": false,
    "heldout_manifest_changed": false,
    "candidate_is_not_a_replicate": true,
    "no_extra_arms_or_tuning": true
  },
  "execution_constraints": {
    "pbs_compute_node_only": true,
    "require_nonempty_PBS_JOBID": true,
    "login_node_heavy_work": false,
    "gpu_telemetry_seconds": 5,
    "no_checkpoint_return": true,
    "single_bounded_gpu_job": true,
    "do_not_submit_until_freeze_and_preflight_complete": true
  }
}
