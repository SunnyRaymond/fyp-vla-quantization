#!/bin/bash
#PBS -N lewm_state_coverage
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=8:mem=48gb:ngpus=1
#PBS -l walltime=04:00:00
#PBS -j oe

set -euo pipefail
test -n "${PBS_JOBID:-}"
HOST=$(hostname -s | tr '[:upper:]' '[:lower:]')
case "$HOST" in *login*|*head*|*submit*) echo "refusing probable login host: $HOST" >&2; exit 2 ;; esac

CONTROL=${LEWM_STATE_CONTROL_DIR:-/scratch/users/ntu/yguo017/dino-wm-wall/meeting-ready/02-horizon-weighted-recurrent-student}
STATE_CONTROL=${LEWM_STATE_SUBDIR:-$CONTROL/lewm-transfer/state-coverage}
STAGE_ROOT=${LEWM_STAGE_ROOT:-/scratch/users/ntu/yguo017/lewm-pusht-iteration}
LEWM_ROOT=${LEWM_REPO_ROOT:-$STAGE_ROOT/le-wm}
STABLEWM_HOME=${STABLEWM_HOME:-$STAGE_ROOT/stablewm_home}
PYTHON_BIN=${LEWM_PYTHON_BIN:-$STAGE_ROOT/venv/bin/python}
FREEZE=${LEWM_STATE_FREEZE:-$STATE_CONTROL/LEWM_STATE_COVERAGE_FREEZE.json}
PROTOCOL=${LEWM_STATE_PROTOCOL:-$STATE_CONTROL/PROTOCOL_LEWM_STATE_COVERAGE.zh.md}
RUNNER=${LEWM_STATE_RUNNER:-$STATE_CONTROL/run_lewm_state_coverage.py}
PROBE=${LEWM_INTERFACE_PROBE_JSON:-$CONTROL/lewm-transfer/interface-probe/artifacts/24554356.pbs101/interface_probe.json}
MANIFEST_256=${LEWM_STATE_MANIFEST_256:-$CONTROL/lewm-transfer/artifacts/24564619.pbs101/context_manifest.json}
ROWS_256=${LEWM_STATE_PREPARED_ROWS_256:-$CONTROL/lewm-transfer/dense-rank/artifacts/24908446.pbs101/prepared_rows.pt}
REFERENCE=${LEWM_STATE_REFERENCE_SUMMARY:-$CONTROL/lewm-transfer/score-distill/artifacts/24916520.pbs101/lewm_score_distill_summary.json}
DATASET=${LEWM_STUDENT_DATASET:-$STABLEWM_HOME/pusht_expert_train.h5}
OUT=${LEWM_STATE_OUT:-$STATE_CONTROL/artifacts/$PBS_JOBID}

mkdir -p "$OUT"
exec > >(tee -a "$OUT/job.log") 2>&1
test -f "$RUNNER"
test -f "$FREEZE"; test -f "$PROTOCOL"; test -f "$PROBE"
test -f "$MANIFEST_256"; test -f "$ROWS_256"; test -f "$REFERENCE"
test -f "$DATASET"; test -f "$STABLEWM_HOME/pusht/lewm_object.ckpt"; test -x "$PYTHON_BIN"

export PYTHONUNBUFFERED=1
export PYTHONPATH="$LEWM_ROOT:$CONTROL/lewm-transfer:${PYTHONPATH:-}"
export WANDB_MODE=disabled
export MUJOCO_GL=egl
echo "LEWM_STATE_COVERAGE_JOB=$PBS_JOBID"
echo "HOST=$HOST"
echo "REFERENCE=$REFERENCE"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
nvidia-smi --query-gpu=timestamp,index,utilization.gpu,memory.used,memory.total --format=csv -l 5 >> "$OUT/job.log" 2>&1 &
GPU_MONITOR_PID=$!
cleanup() { kill "$GPU_MONITOR_PID" 2>/dev/null || true; wait "$GPU_MONITOR_PID" 2>/dev/null || true; }
trap cleanup EXIT

"$PYTHON_BIN" "$RUNNER" \
  --lewm-root "$LEWM_ROOT" --stablewm-home "$STABLEWM_HOME" --output "$OUT" \
  --freeze "$FREEZE" --protocol "$PROTOCOL" --interface-probe "$PROBE" \
  --dataset "$DATASET" --manifest-256 "$MANIFEST_256" \
  --prepared-rows-256 "$ROWS_256" --reference-summary "$REFERENCE" \
  --action-low -1.0 -1.0 --action-high 1.0 1.0 \
  --gaussian-std 0.22360679774997896 --mode run

printf 'EXIT_STATUS=0\n' > "$OUT/job_status"
cleanup
trap - EXIT
