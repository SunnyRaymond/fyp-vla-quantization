#!/bin/bash
#PBS -N lewm_rec_student
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=8:mem=48gb:ngpus=1
#PBS -l walltime=08:00:00
#PBS -j oe

set -euo pipefail

test -n "${PBS_JOBID:-}"
HOST=$(hostname -s | tr '[:upper:]' '[:lower:]')
case "$HOST" in
  *login*|*head*|*submit*) echo "refusing probable login host: $HOST" >&2; exit 2 ;;
esac

CONTROL=${LEWM_STUDENT_CONTROL_DIR:-/scratch/users/ntu/yguo017/dino-wm-wall/meeting-ready/02-horizon-weighted-recurrent-student/lewm-transfer}
STAGE_ROOT=${LEWM_STAGE_ROOT:-/scratch/users/ntu/yguo017/lewm-pusht-iteration}
LEWM_ROOT=${LEWM_REPO_ROOT:-$STAGE_ROOT/le-wm}
STABLEWM_HOME=${STABLEWM_HOME:-$STAGE_ROOT/stablewm_home}
PYTHON_BIN=${LEWM_PYTHON_BIN:-$STAGE_ROOT/venv/bin/python}
FREEZE=${LEWM_STUDENT_FREEZE:-$CONTROL/LEWM_RECURRENT_STUDENT_FREEZE.json}
PROTOCOL=${LEWM_STUDENT_PROTOCOL:-$CONTROL/PROTOCOL_LEWM_RECURRENT_STUDENT.zh.md}
PROBE=${LEWM_INTERFACE_PROBE_JSON:-$CONTROL/interface-probe/artifacts/24554356.pbs101/interface_probe.json}
OUT=${LEWM_STUDENT_OUT:-$CONTROL/artifacts/$PBS_JOBID}
DATASET=${LEWM_STUDENT_DATASET:-$STABLEWM_HOME/pusht_expert_train.h5}
ACTION_LOW_X=${LEWM_STUDENT_ACTION_LOW_X:--1.0}
ACTION_LOW_Y=${LEWM_STUDENT_ACTION_LOW_Y:--1.0}
ACTION_HIGH_X=${LEWM_STUDENT_ACTION_HIGH_X:-1.0}
ACTION_HIGH_Y=${LEWM_STUDENT_ACTION_HIGH_Y:-1.0}
GAUSSIAN_STD=${LEWM_STUDENT_GAUSSIAN_STD:-0.22360679774997896}

mkdir -p "$OUT"
exec > >(tee -a "$OUT/job.log") 2>&1

test -f "$CONTROL/run_lewm_recurrent_student.py"
test -f "$FREEZE"
test -f "$PROTOCOL"
test -f "$PROBE" || { echo "WAITING_FOR_INTERFACE_PROBE=$PROBE"; printf 'EXIT_STATUS=3\n' > "$OUT/job_status"; exit 3; }
test -f "$DATASET"
test -f "$STABLEWM_HOME/pusht/lewm_object.ckpt"
test -x "$PYTHON_BIN"

export PYTHONUNBUFFERED=1
export PYTHONPATH="$LEWM_ROOT:$CONTROL:${PYTHONPATH:-}"
export WANDB_MODE=disabled
export MUJOCO_GL=egl

echo "LEWM_STUDENT_JOB=$PBS_JOBID"
echo "HOST=$HOST"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
nvidia-smi --query-gpu=timestamp,index,utilization.gpu,memory.used,memory.total --format=csv -l 30 >> "$OUT/job.log" 2>&1 &
GPU_MONITOR_PID=$!
cleanup() {
  kill "$GPU_MONITOR_PID" 2>/dev/null || true
  wait "$GPU_MONITOR_PID" 2>/dev/null || true
}
trap cleanup EXIT

"$PYTHON_BIN" "$CONTROL/run_lewm_recurrent_student.py" \
  --lewm-root "$LEWM_ROOT" \
  --stablewm-home "$STABLEWM_HOME" \
  --output "$OUT" \
  --freeze "$FREEZE" \
  --protocol "$PROTOCOL" \
  --interface-probe "$PROBE" \
  --dataset "$DATASET" \
  --action-low "$ACTION_LOW_X" "$ACTION_LOW_Y" \
  --action-high "$ACTION_HIGH_X" "$ACTION_HIGH_Y" \
  --gaussian-std "$GAUSSIAN_STD" \
  --mode run

printf 'EXIT_STATUS=0\n' > "$OUT/job_status"
cleanup
trap - EXIT
