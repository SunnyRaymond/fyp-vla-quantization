#!/bin/bash
#PBS -N lewm_adaptive_schedule
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=16:mem=110gb:ngpus=1
#PBS -l walltime=00:30:00
#PBS -j oe

set -euo pipefail

JOB_ID=${PBS_JOBID:?PBS_JOBID must be non-empty}
CONTROL=${LEWM_ADAPTIVE_CONTROL_DIR:-/scratch/users/ntu/yguo017/dino-wm-wall/meeting-ready/02-horizon-weighted-recurrent-student}
EXPERIMENT=${LEWM_ADAPTIVE_SUBDIR:-$CONTROL/lewm-transfer/adaptive-teacher-schedule}
STATE_CONTROL=${LEWM_ADAPTIVE_STATE_SUBDIR:-$CONTROL/lewm-transfer/state-coverage}
BALANCED_CONTROL=${LEWM_ADAPTIVE_BALANCED_SUBDIR:-$CONTROL/lewm-transfer/temporal-balanced-train}
DISTILL_CONTROL=${LEWM_ADAPTIVE_DISTILL_SUBDIR:-$CONTROL/lewm-transfer/cem-distribution-distill}
STAGE_ROOT=${LEWM_STAGE_ROOT:-/scratch/users/ntu/yguo017/lewm-pusht-iteration}
LEWM_ROOT=${LEWM_REPO_ROOT:-$STAGE_ROOT/le-wm}
STABLEWM_HOME=${STABLEWM_HOME:-$STAGE_ROOT/stablewm_home}
PYTHON_BIN=${LEWM_PYTHON_BIN:-$STAGE_ROOT/venv/bin/python}
RUNNER=${LEWM_ADAPTIVE_RUNNER:-$EXPERIMENT/run_adaptive_teacher_schedule.py}
FREEZE=${LEWM_ADAPTIVE_FREEZE:-$EXPERIMENT/FREEZE.json}
PROTOCOL=${LEWM_ADAPTIVE_PROTOCOL:-$EXPERIMENT/PROTOCOL.zh.md}
PROBE=${LEWM_INTERFACE_PROBE_JSON:-$CONTROL/lewm-transfer/interface-probe/artifacts/24554356.pbs101/interface_probe.json}
MANIFEST_512=${LEWM_ADAPTIVE_MANIFEST_512:-$STATE_CONTROL/artifacts/24926383.pbs101/context_manifest_512.json}
MAIN_CHECKPOINT=${LEWM_ADAPTIVE_MAIN_CHECKPOINT:-$DISTILL_CONTROL/artifacts/25239551.pbs101/treatment_step1000.pt}
TEMPORAL_FREEZE=${LEWM_TEMPORAL_FREEZE:-$BALANCED_CONTROL/LEWM_TEMPORAL_BALANCED_TRAIN_FREEZE.json}
DATASET=${LEWM_STUDENT_DATASET:-$STABLEWM_HOME/pusht_expert_train.h5}
OUT=${LEWM_ADAPTIVE_OUT:-$EXPERIMENT/artifacts/$JOB_ID}

test -n "${PBS_NODEFILE:-}" && test -f "$PBS_NODEFILE"
HOST=$(hostname -s | tr '[:upper:]' '[:lower:]')
case "$HOST" in
  *login*|*head*|*submit*) echo "refusing probable login host: $HOST" >&2; exit 2 ;;
esac

for FILE in "$RUNNER" "$FREEZE" "$PROTOCOL" "$PROBE" "$MANIFEST_512" "$MAIN_CHECKPOINT" "$TEMPORAL_FREEZE" "$DATASET" "$STABLEWM_HOME/pusht/lewm_object.ckpt"; do
  test -f "$FILE"
done
test -x "$PYTHON_BIN"

mkdir -p "$OUT"
status=1
GPU_MONITOR_PID=""
stop_gpu_monitor() {
  if [ -n "$GPU_MONITOR_PID" ] && kill -0 "$GPU_MONITOR_PID" 2>/dev/null; then
    kill "$GPU_MONITOR_PID" 2>/dev/null || true
    wait "$GPU_MONITOR_PID" 2>/dev/null || true
  fi
}
cleanup() {
  stop_gpu_monitor
  printf 'EXIT_STATUS=%s\n' "$status" > "$OUT/job_status"
}
trap cleanup EXIT
exec > >(tee -a "$OUT/job.log") 2>&1

export PYTHONUNBUFFERED=1
export PYTHONPATH="$LEWM_ROOT:$CONTROL/lewm-transfer:${PYTHONPATH:-}"
export WANDB_MODE=disabled
export MUJOCO_GL=egl

printf '%s\n' \
  "job_id=$JOB_ID" \
  "host=$HOST" \
  "runner=$RUNNER" \
  "freeze=$FREEZE" \
  "protocol=$PROTOCOL" \
  "manifest_512=$MANIFEST_512" \
  "main_checkpoint=$MAIN_CHECKPOINT" \
  "dataset=$DATASET" \
  "started_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$OUT/execution_identity.txt"

nvidia-smi --query-gpu=name,memory.total --format=csv,noheader > "$OUT/gpu_info.csv"
nvidia-smi --query-gpu=timestamp,index,name,utilization.gpu,memory.used,memory.total --format=csv -l 5 \
  >> "$OUT/job.log" 2>&1 &
GPU_MONITOR_PID=$!

set +e
timeout --signal=TERM --kill-after=30s 1740 \
  "$PYTHON_BIN" "$RUNNER" \
  --lewm-root "$LEWM_ROOT" --stablewm-home "$STABLEWM_HOME" --output "$OUT" \
  --freeze "$FREEZE" --protocol "$PROTOCOL" --interface-probe "$PROBE" \
  --manifest-512 "$MANIFEST_512" --main-checkpoint "$MAIN_CHECKPOINT" \
  --temporal-freeze "$TEMPORAL_FREEZE" --dataset "$DATASET" --mode run
RUNNER_RC=$?
set -e

if [ "$RUNNER_RC" -eq 0 ] && [ -s "$OUT/adaptive_teacher_schedule_summary.json" ]; then
  status=0
  printf 'RUNNER_EXIT_STATUS=0\n' > "$OUT/final_exit_status.txt"
else
  printf 'RUNNER_EXIT_STATUS=%s\n' "$RUNNER_RC" > "$OUT/final_exit_status.txt"
fi
stop_gpu_monitor
trap - EXIT
printf 'EXIT_STATUS=%s\n' "$status" > "$OUT/job_status"
exit "$status"
