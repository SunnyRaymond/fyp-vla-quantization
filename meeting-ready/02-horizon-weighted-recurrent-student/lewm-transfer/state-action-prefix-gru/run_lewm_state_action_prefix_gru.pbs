#!/bin/bash
#PBS -N lewm_state_gru
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=8:mem=48gb:ngpus=1
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail
test -n "${PBS_JOBID:-}"
HOST=$(hostname -s | tr '[:upper:]' '[:lower:]')
case "$HOST" in *login*|*head*|*submit*) echo "refusing probable login host: $HOST" >&2; exit 2 ;; esac

CONTROL=${LEWM_STATE_CONTROL_DIR:-/scratch/users/ntu/yguo017/dino-wm-wall/meeting-ready/02-horizon-weighted-recurrent-student}
GRU_CONTROL=${LEWM_STATE_GRU_SUBDIR:-$CONTROL/lewm-transfer/state-action-prefix-gru}
BALANCED_CONTROL=${LEWM_TEMPORAL_SUBDIR:-$CONTROL/lewm-transfer/temporal-balanced-train}
STATE_CONTROL=${LEWM_STATE_SUBDIR:-$CONTROL/lewm-transfer/state-coverage}
STAGE_ROOT=${LEWM_STAGE_ROOT:-/scratch/users/ntu/yguo017/lewm-pusht-iteration}
LEWM_ROOT=${LEWM_REPO_ROOT:-$STAGE_ROOT/le-wm}
STABLEWM_HOME=${STABLEWM_HOME:-$STAGE_ROOT/stablewm_home}
PYTHON_BIN=${LEWM_PYTHON_BIN:-$STAGE_ROOT/venv/bin/python}
RUNNER=${LEWM_STATE_GRU_RUNNER:-$GRU_CONTROL/run_lewm_state_action_prefix_gru.py}
FREEZE=${LEWM_STATE_GRU_FREEZE:-$GRU_CONTROL/LEWM_STATE_ACTION_PREFIX_GRU_FREEZE.json}
PROTOCOL=${LEWM_STATE_GRU_PROTOCOL:-$GRU_CONTROL/PROTOCOL_LEWM_STATE_ACTION_PREFIX_GRU.zh.md}
TEMPORAL_FREEZE=${LEWM_TEMPORAL_FREEZE:-$BALANCED_CONTROL/LEWM_TEMPORAL_BALANCED_TRAIN_FREEZE.json}
TEMPORAL_PROTOCOL=${LEWM_TEMPORAL_PROTOCOL:-$BALANCED_CONTROL/PROTOCOL_LEWM_TEMPORAL_BALANCED_TRAIN.zh.md}
TEMPORAL_SUMMARY=${LEWM_TEMPORAL_SUMMARY:-$BALANCED_CONTROL/artifacts/25152151.pbs101/lewm_temporal_balanced_train_summary.json}
PROBE=${LEWM_INTERFACE_PROBE_JSON:-$CONTROL/lewm-transfer/interface-probe/artifacts/24554356.pbs101/interface_probe.json}
MANIFEST_512=${LEWM_STATE_GRU_MANIFEST_512:-$STATE_CONTROL/artifacts/24926383.pbs101/context_manifest_512.json}
PREPARED_ROWS_512=${LEWM_STATE_GRU_PREPARED_ROWS_512:-$STATE_CONTROL/artifacts/24926383.pbs101/prepared_512/prepared_rows.pt}
BALANCED_ROWS=${LEWM_BALANCED_PREPARED_ROWS:-$BALANCED_CONTROL/artifacts/25152151.pbs101/prepared_balanced_rows.pt}
REFERENCE=${LEWM_STATE_GRU_REFERENCE_SUMMARY:-$STATE_CONTROL/artifacts/24926383.pbs101/lewm_state_coverage_summary.json}
PHASE2_FREEZE=${LEWM_STATE_GRU_PHASE2_FREEZE:-$STATE_CONTROL/LEWM_STATE_COVERAGE_FREEZE.json}
DATASET=${LEWM_STUDENT_DATASET:-$STABLEWM_HOME/pusht_expert_train.h5}
OUT=${LEWM_STATE_GRU_OUT:-$GRU_CONTROL/artifacts/$PBS_JOBID}

mkdir -p "$OUT"
status=1
GPU_MONITOR_PID=""
cleanup() {
  if [ -n "$GPU_MONITOR_PID" ]; then
    kill "$GPU_MONITOR_PID" 2>/dev/null || true
    wait "$GPU_MONITOR_PID" 2>/dev/null || true
  fi
  printf 'EXIT_STATUS=%s\n' "$status" > "$OUT/job_status"
}
trap cleanup EXIT
exec > >(tee -a "$OUT/job.log") 2>&1

test -f "$RUNNER"
test -f "$FREEZE"
test -f "$PROTOCOL"
test -f "$TEMPORAL_FREEZE"
test -f "$TEMPORAL_PROTOCOL"
test -f "$TEMPORAL_SUMMARY"
test -f "$PROBE"
test -f "$MANIFEST_512"
test -f "$PREPARED_ROWS_512"
test -f "$REFERENCE"
test -f "$PHASE2_FREEZE"
test -f "$DATASET"
test -f "$STABLEWM_HOME/pusht/lewm_object.ckpt"
test -x "$PYTHON_BIN"

export PYTHONUNBUFFERED=1
export PYTHONPATH="$LEWM_ROOT:$CONTROL/lewm-transfer:${PYTHONPATH:-}"
export WANDB_MODE=disabled
export MUJOCO_GL=egl
echo "LEWM_STATE_ACTION_PREFIX_GRU_JOB=$PBS_JOBID"
echo "HOST=$HOST"
echo "BALANCED_PREPARED_ROWS_CANDIDATE=$BALANCED_ROWS"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
nvidia-smi --query-gpu=timestamp,index,utilization.gpu,memory.used,memory.total --format=csv -l 5 >> "$OUT/job.log" 2>&1 &
GPU_MONITOR_PID=$!

balanced_arg=()
if [ -f "$BALANCED_ROWS" ]; then
  balanced_arg=(--prepared-balanced-rows "$BALANCED_ROWS")
fi

"$PYTHON_BIN" "$RUNNER" \
  --lewm-root "$LEWM_ROOT" --stablewm-home "$STABLEWM_HOME" --output "$OUT" \
  --freeze "$FREEZE" --protocol "$PROTOCOL" \
  --temporal-freeze "$TEMPORAL_FREEZE" --temporal-protocol "$TEMPORAL_PROTOCOL" --temporal-summary "$TEMPORAL_SUMMARY" \
  --interface-probe "$PROBE" --manifest-512 "$MANIFEST_512" --prepared-rows-512 "$PREPARED_ROWS_512" \
  --reference-summary "$REFERENCE" --phase2-freeze "$PHASE2_FREEZE" --dataset "$DATASET" \
  "${balanced_arg[@]}" --mode run

status=0
printf 'EXIT_STATUS=0\n' > "$OUT/job_status"
cleanup
trap - EXIT
