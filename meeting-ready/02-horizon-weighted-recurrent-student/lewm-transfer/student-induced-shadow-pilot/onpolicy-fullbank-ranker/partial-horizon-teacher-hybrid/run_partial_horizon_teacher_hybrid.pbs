#!/bin/bash
#PBS -N lewm_partial_hybrid
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=16:mem=110gb:ngpus=1
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail
umask 027

JOB_ID=${PBS_JOBID:?PBS_JOBID must be non-empty}
test -n "${PBS_NODEFILE:-}" && test -f "$PBS_NODEFILE"
HOST=$(hostname -s | tr '[:upper:]' '[:lower:]')
case "$HOST" in
  *login*|*head*|*submit*) echo "refusing login/submit host: $HOST" >&2; exit 2 ;;
esac
if ! awk -F. -v host="$HOST" 'tolower($1) == host { found = 1 } END { exit !found }' "$PBS_NODEFILE"; then
  echo "host $HOST is not in PBS_NODEFILE" >&2
  exit 2
fi

CONTROL=${LEWM_CONTROL_DIR:-/scratch/users/ntu/yguo017/dino-wm-wall/meeting-ready/02-horizon-weighted-recurrent-student}
STAGE_ROOT=${LEWM_STAGE_ROOT:-/scratch/users/ntu/yguo017/lewm-pusht-iteration}
TRANSFER=$CONTROL/lewm-transfer
EXPERIMENT=$TRANSFER/student-induced-shadow-pilot/onpolicy-fullbank-ranker/partial-horizon-teacher-hybrid
SOURCE_BANK_DIR=$TRANSFER/student-induced-shadow-pilot/onpolicy-fullbank-ranker/artifacts/25538135.pbs101
TRAIN_BANKS=$SOURCE_BANK_DIR/train_banks.pt
PYTHON_BIN=$STAGE_ROOT/venv/bin/python
LEWM_ROOT=$STAGE_ROOT/le-wm
STABLEWM_ROOT=$STAGE_ROOT/stable-worldmodel
STUDENT_CHECKPOINT=$TRANSFER/cem-distribution-distill/artifacts/25239551.pbs101/treatment_step1000.pt
TEACHER_CHECKPOINT=$STAGE_ROOT/stablewm_home/pusht/lewm_object.ckpt
OUT=$EXPERIMENT/artifacts/$JOB_ID

# Inspect only the frozen train-bank input; never open validation or holdout banks.
for FILE in "$EXPERIMENT/FREEZE.json" "$EXPERIMENT/runner.py" "$TRAIN_BANKS" "$STUDENT_CHECKPOINT" "$TEACHER_CHECKPOINT"; do
  test -f "$FILE"
done
test -x "$PYTHON_BIN"
test -d "$LEWM_ROOT"
test -d "$STABLEWM_ROOT"
test ! -e "$OUT"
mkdir -p "$OUT"

status=1
GPU_MONITOR_PID=""
cleanup() {
  if [ -n "$GPU_MONITOR_PID" ] && kill -0 "$GPU_MONITOR_PID" 2>/dev/null; then
    kill "$GPU_MONITOR_PID" 2>/dev/null || true
    wait "$GPU_MONITOR_PID" 2>/dev/null || true
  fi
  printf 'EXIT_STATUS=%s\n' "$status" > "$OUT/job_status"
}
trap cleanup EXIT
exec > >(tee -a "$OUT/job.log") 2>&1

export PYTHONUNBUFFERED=1
export PYTHONPATH="$LEWM_ROOT:$STABLEWM_ROOT:$TRANSFER:${PYTHONPATH:-}"
export WANDB_MODE=disabled

printf 'job_id=%s\nhost=%s\nfreeze=%s\ntrain_banks=%s\n' "$JOB_ID" "$HOST" "$EXPERIMENT/FREEZE.json" "$TRAIN_BANKS" > "$OUT/execution_identity.txt"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader > "$OUT/gpu_info.csv"
nvidia-smi --query-gpu=timestamp,index,name,utilization.gpu,memory.used,memory.total --format=csv -l 5 >> "$OUT/job.log" 2>&1 &
GPU_MONITOR_PID=$!

timeout --signal=TERM --kill-after=30s 5400 "$PYTHON_BIN" "$EXPERIMENT/runner.py" \
  --freeze "$EXPERIMENT/FREEZE.json" \
  --train-banks "$TRAIN_BANKS" \
  --output-dir "$OUT"

test -s "$OUT/partial_horizon_summary.json"
status=0
printf 'RUNNER_EXIT_STATUS=0\n' > "$OUT/final_exit_status.txt"
