#!/bin/bash
#PBS -N lewm_official_s1
#PBS -P personal-yguo017
#PBS -q normal
#PBS -l select=1:ncpus=16:mem=110gb:ngpus=1
#PBS -l walltime=00:30:00
#PBS -j oe

set -euo pipefail
JOB_ID=${PBS_JOBID:?PBS_JOBID must be set by PBS}
CONTROL=${LEWM_OFFICIAL_CONTROL_ROOT:-/scratch/users/ntu/yguo017/dino-wm-wall/meeting-ready/02-horizon-weighted-recurrent-student}
EXPERIMENT=${LEWM_OFFICIAL_EXPERIMENT_DIR:-$CONTROL/lewm-transfer/official-pusht-cem}
STAGE_ROOT=${LEWM_STAGE_ROOT:-/scratch/users/ntu/yguo017/lewm-pusht-iteration}
LEWM_ROOT=${LEWM_REPO_ROOT:-$STAGE_ROOT/le-wm}
STABLEWM_ROOT=${LEWM_STABLEWM_ROOT:-$STAGE_ROOT/stable-worldmodel}
STABLEWM_HOME=${STABLEWM_HOME:-$STAGE_ROOT/stablewm_home}
PYTHON_BIN=${LEWM_PYTHON_BIN:-$STAGE_ROOT/venv/bin/python}
CHECKPOINT=${LEWM_OFFICIAL_STUDENT_CHECKPOINT:-/scratch/users/ntu/yguo017/dino-wm-wall/meeting-ready/02-horizon-weighted-recurrent-student/lewm-transfer/cem-distribution-distill/artifacts/25239551.pbs101/treatment_step1000.pt}
PROBE=${LEWM_INTERFACE_PROBE_JSON:-$CONTROL/lewm-transfer/interface-probe/artifacts/24554356.pbs101/interface_probe.json}
RUNNER=$EXPERIMENT/run_official_pusht_cem.py
FREEZE=$EXPERIMENT/FREEZE.json
PROTOCOL=$EXPERIMENT/PROTOCOL.zh.md
OUT=${LEWM_OFFICIAL_STAGE1_OUT:-$EXPERIMENT/artifacts/$JOB_ID}

test -n "${PBS_NODEFILE:-}" && test -f "$PBS_NODEFILE"
HOST=$(hostname -s | tr '[:upper:]' '[:lower:]')
case "$HOST" in *login*|*head*|*submit*) echo "refusing probable login/submit node: $HOST" >&2; exit 2;; esac
NODE_SHORTS=$(awk '{name=tolower($1); sub(/\..*/, "", name); print name}' "$PBS_NODEFILE" | sort -u)
if ! printf '%s\n' "$NODE_SHORTS" | grep -Fxq "$HOST"; then
  echo "current host $HOST is not listed in PBS_NODEFILE" >&2
  exit 2
fi

for FILE in "$RUNNER" "$FREEZE" "$PROTOCOL" "$PROBE" "$CHECKPOINT" "$STABLEWM_HOME/pusht/lewm_object.ckpt"; do test -f "$FILE"; done
test -d "$LEWM_ROOT" && test -d "$STABLEWM_ROOT" && test -x "$PYTHON_BIN"
mkdir -p "$OUT"
STATUS=1
GPU_MONITOR_PID=""
stop_gpu_monitor() {
  if [ -n "$GPU_MONITOR_PID" ] && kill -0 "$GPU_MONITOR_PID" 2>/dev/null; then
    kill "$GPU_MONITOR_PID" 2>/dev/null || true
    wait "$GPU_MONITOR_PID" 2>/dev/null || true
  fi
}
cleanup() {
  stop_gpu_monitor
  printf 'EXIT_STATUS=%s\n' "$STATUS" > "$OUT/job_status"
}
trap cleanup EXIT
exec > >(tee -a "$OUT/job.log") 2>&1

export PYTHONUNBUFFERED=1
export WANDB_MODE=disabled
export MUJOCO_GL=egl
export PYTHONPATH="$LEWM_ROOT:$STABLEWM_ROOT:$CONTROL/lewm-transfer:$CONTROL/lewm-transfer/cem-distribution-distill:$CONTROL/lewm-transfer/adaptive-teacher-schedule:${PYTHONPATH:-}"
printf 'job_id=%s\nhost=%s\nrunner=%s\nfreeze=%s\ncheckpoint=%s\nprobe=%s\nstarted_utc=%s\n' \
  "$JOB_ID" "$HOST" "$RUNNER" "$FREEZE" "$CHECKPOINT" "$PROBE" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$OUT/execution_identity.txt"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader > "$OUT/gpu_info.csv"
nvidia-smi --query-gpu=timestamp,index,name,utilization.gpu,memory.used,memory.total --format=csv -l 5 >> "$OUT/job.log" 2>&1 &
GPU_MONITOR_PID=$!

set +e
timeout --signal=TERM --kill-after=30s 1740 "$PYTHON_BIN" "$RUNNER" \
  --stage stage1 --lewm-root "$LEWM_ROOT" --stablewm-root "$STABLEWM_ROOT" \
  --stablewm-home "$STABLEWM_HOME" --control-root "$CONTROL" --checkpoint "$CHECKPOINT" \
  --probe "$PROBE" --freeze "$FREEZE" --output "$OUT"
RUNNER_RC=$?
set -e
stop_gpu_monitor
GPU_MONITOR_PID=""
if [ "$RUNNER_RC" -eq 0 ] && [ -s "$OUT/stage1_summary.json" ]; then
  STATUS=0
  printf 'RUNNER_EXIT_STATUS=0\n' > "$OUT/final_exit_status.txt"
else
  printf 'RUNNER_EXIT_STATUS=%s\n' "$RUNNER_RC" > "$OUT/final_exit_status.txt"
fi
trap - EXIT
printf 'EXIT_STATUS=%s\n' "$STATUS" > "$OUT/job_status"
exit "$STATUS"
